---
import {env} from 'cloudflare:workers';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import '../styles/home-v3.css';
import '../styles/inner-v3.css';
import '../styles/controls.css';
import '../styles/readability.css';
import '../styles/type-scale.css';
import '../styles/layout-constraints.css';
import '../styles/vector-system.css';
import Footer from '../components/Footer.astro';
import StorageNotice from '../components/StorageNotice.astro';
import DownloadScreen from '../components/DownloadScreen.astro';
import ShareDialog from '../components/ShareDialog.astro';
import {pageSchema} from '../seo/page';
import {socialOrigin,socialMetadata} from '../social/meta';

const {title='Free Printable Coloring Pages | JotColoring',description='Find printable coloring pages to download or color online in JotColoring Studio.',noindex=false,canonical=Astro.url.pathname,bodyClass='site-v3',socialItem=undefined,downloadItem=undefined,downloadFormat='pdf'} = Astro.props;
const origin=socialOrigin(Astro.url.origin,env.PUBLIC_SITE_URL,env.APP_ENV);
const social=socialMetadata(Astro.url.pathname,Astro.response.status||200,origin,socialItem||downloadItem);
const pageURL=new URL(canonical,origin).href;
const structured=!noindex?pageSchema({origin,canonical,title,description,image:social.image,imageAlt:social.alt,item:socialItem}):null;

---
<!doctype html><html lang="en-US"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>{title}</title><meta name="description" content={description}/><meta property="og:site_name" content="JotColoring"/><meta property="og:type" content="website"/><meta property="og:locale" content="en_US"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={pageURL}/><meta property="og:image" content={social.image}/><meta property="og:image:alt" content={social.alt}/><meta property="og:image:type" content={social.mime}/><meta property="og:image:width" content={String(social.width)}/><meta property="og:image:height" content={String(social.height)}/>{social.image.startsWith('https:')&&<meta property="og:image:secure_url" content={social.image}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={social.image}/><meta name="twitter:image:alt" content={social.alt}/><meta name="theme-color" content="#ff631b"/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><link rel="canonical" href={new URL(canonical,origin).href}/><link rel="icon" href="/favicon-3d.svg" type="image/svg+xml"/>{structured&&<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>}<slot name="head"/></head><body id="top" class={bodyClass}><a class="skip-link" href={downloadItem?'#download-main':'#main'}>Skip to content</a><slot/><DownloadScreen item={downloadItem} format={downloadFormat}/><ShareDialog/>{bodyClass==='site-v3'&&<Footer/>}<div id="toast" class="toast" role="status" hidden></div><StorageNotice/><script>import '../ui/common';import {mountImageInfo} from '../ui/image-info';mountImageInfo();</script></body></html>
