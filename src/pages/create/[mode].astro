---
import {env} from 'cloudflare:workers';import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Creator from '../../components/Creator.astro';import PhotoConverter from '../../components/PhotoConverter.astro';import {createCatalog} from '../../server/catalog';
const mode=Astro.params.mode;if(!['text','photo'].includes(mode!))return Astro.redirect('/create/text/');const example=mode==='text'?await createCatalog(env).get('woodland-friends'):undefined;const ideas=mode==='text'?(await createCatalog(env).list({limit:4})).items.filter(i=>i.id!==example?.id).slice(0,3):[];
---
<Layout title={mode==='photo'?'Photo to Coloring Page — JotColoring':'Text to coloring page — JotColoring AI Builder'} noindex><Header variant={mode==='text'?'food':'full'}/>{mode==='photo'?<PhotoConverter/>:<Creator mode={mode} example={example} ideas={ideas}/>}</Layout>
