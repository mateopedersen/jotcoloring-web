---
import {env} from 'cloudflare:workers';import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Creator from '../../components/Creator.astro';import PhotoConverter from '../../components/PhotoConverter.astro';import {createCatalog} from '../../server/catalog';
const mode=Astro.params.mode;if(!['text','photo'].includes(mode!))return Astro.redirect('/create/text/');const example=mode==='text'?await createCatalog(env).get('woodland-friends'):undefined;const ideas=mode==='text'?(await createCatalog(env).list({limit:4})).items.filter(i=>i.id!==example?.id).slice(0,3):[];
---
<Layout title={mode==='photo'?'Photo to Coloring Page Converter | JotColoring':'AI Coloring Page Generator | JotColoring'} description={mode==='photo'?'Turn a photo into a coloring page in your browser. Adjust outlines, compare with the original, and download PDF, PNG, WEBP, JPG, SVG, or Word files.':'Create a coloring page from a text prompt. Choose a style and detail level, then download the line art or color it in Studio. Generation is subject to availability.'} noindex={Astro.url.searchParams.has('job')}><Header variant={mode==='text'?'food':'full'}/>{mode==='photo'?<PhotoConverter/>:<Creator mode={mode} example={example} ideas={ideas}/>}</Layout>
