---
import {env} from 'cloudflare:workers';import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Sidebar from '../../components/Sidebar.astro';import Card from '../../components/Card.astro';import {categories,animalCategories} from '../../ui/categories';import {createCatalog,parseCatalogQuery} from '../../server/catalog';import type {Env,CatalogPage} from '../../server/types';
const repo=createCatalog(env as unknown as Env);const parts=(Astro.params.category||'').split('/').filter(Boolean);const category=parts[0]||'';const subcategory=parts[1]||'';const animal=category==='animals';const categoryInfo=categories.find(c=>c.id===category);if(category&&!categoryInfo)return Astro.redirect('/404/');const params=new URLSearchParams(Astro.url.search);if(category)params.set('category',category);if(subcategory)params.set('subcategory',subcategory);params.set('limit',animal?'6':'8');let error='';let result:CatalogPage={items:[],total:0,page:1,page_size:8,total_pages:0,next_cursor:null,has_more:false};let query:any={age:[],difficulty:[],sort:'trending'};try{query=parseCatalogQuery(params);result=await repo.list(query)}catch(e){error=e instanceof Error?e.message:'The catalog could not be loaded.';Astro.response.status=400;}
const samples=animal?await Promise.all(animalCategories.map(c=>repo.get(c.sample))):[];const selected=result.items[0];const heading=query.q?`Search results for “${query.q}”`:animal?'Animal coloring pages':categoryInfo?`${categoryInfo.name} coloring pages`:'All coloring pages';const pageHref=(page:number)=>{const p=new URLSearchParams(Astro.url.search);p.set('page',String(page));return `${Astro.url.pathname}?${p}`};const sortHref=(sort:string)=>{const p=new URLSearchParams(Astro.url.search);p.set('sort',sort);p.delete('page');return `${Astro.url.pathname}?${p}`};
---
<Layout title={`${heading} — JotColoring`} noindex={Astro.url.search.length>0}><Header active={animal?'animals':category} variant={category?'full':'ocean'} animal={animal} search={query.q||''}/><div class="browse-shell"><Sidebar animal={animal} active={subcategory} age={query.age||[]} difficulty={query.difficulty||[]}/><main class:list={["main-content",animal&&"animals-page"]} id="main"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/coloring-pages/">Coloring pages</a>{categoryInfo&&<><span>/</span><span>{categoryInfo.name}</span></>}</div><h1>{heading}</h1><p class="page-intro">{animal?'Find your favorite creatures, big and small.':category?'Choose a drawing and make it your own.':'Find a page for every mood.'}</p>
{animal?<><div class="subcategory-strip">{animalCategories.flatMap((c,i)=>[<a href={`/coloring-pages/animals/${c.id}/`}>{samples[i]&&<img src={samples[i]!.thumbnail} alt={samples[i]!.alt} width="180" height="150"/>}<strong>{c.name}</strong></a>,...(i===5?[<a href="/coloring-pages/dinosaurs/">{samples[i]&&<img src={samples[i]!.thumbnail} alt="Explore more dinosaur coloring pages" width="180" height="150"/>}<strong>More dinosaurs</strong></a>]:[])])}</div><div class="animals-controls"><h2>Coloring pages ({result.total})</h2><nav class="subcategory-tabs" aria-label="Animal categories"><a class:list={[!subcategory&&'active']} href="/coloring-pages/animals/">All</a>{animalCategories.map(c=><a class:list={[subcategory===c.id&&'active']} href={`/coloring-pages/animals/${c.id}/`}>{c.name}</a>)}</nav></div></>:<form class="filter-bar" id="catalog-filters" action={Astro.url.pathname}>{query.q&&<input type="hidden" name="q" value={query.q}/>}<label class="sr-only" for="category-filter">Category</label><select id="category-filter" name="category" data-filter-select><option value="">All categories</option>{categories.map(c=><option value={c.id} selected={category===c.id||query.category===c.id}>{c.name}</option>)}</select><label class="sr-only" for="age-filter">Age</label><select id="age-filter" name="age" data-filter-select><option value="">Age</option>{['kids','teens','adults'].map(a=><option value={a} selected={query.age?.includes(a)}>{a[0].toUpperCase()+a.slice(1)}</option>)}</select><label class="sr-only" for="difficulty-filter">Difficulty</label><select id="difficulty-filter" name="difficulty" data-filter-select><option value="">Difficulty</option>{['easy','detailed'].map(d=><option value={d} selected={query.difficulty?.includes(d)}>{d[0].toUpperCase()+d.slice(1)}</option>)}</select><nav class="popular-tabs" aria-label="Sort pages"><a class:list={[query.sort==='trending'&&'active']} href={sortHref('trending')}>Trending</a><a class:list={[query.sort==='newest'&&'active']} href={sortHref('newest')}>Newest</a></nav><label class="sr-only" for="sort-filter">Sort pages</label><select class="sort-select" id="sort-filter" name="sort" data-filter-select><option value="trending" selected={query.sort==='trending'}>Sort: Popular</option><option value="newest" selected={query.sort==='newest'}>Sort: Newest</option><option value="title" selected={query.sort==='title'}>Sort: A–Z</option></select><noscript><button type="submit">Apply filters</button></noscript></form>}
{error?<div class="empty" role="alert">{error} <a href="/coloring-pages/">Reset filters</a></div>:result.items.length===0?<div class="empty"><h2>No pages found</h2><p>Try a different word or fewer filters.</p><a href="/coloring-pages/">Browse all coloring pages</a></div>:<div class:list={[animal&&'animals-results']}><div class:list={['catalog-grid',animal&&'animal-grid']}>{result.items.map((item,i)=><Card item={item} quick={animal} selected={i===0} showCategory={!animal}/>)}</div>{animal&&selected&&<aside class="quick-preview" id="quick-preview" aria-label="Quick preview" aria-live="polite"><h2>Quick preview</h2><div data-preview-body><img src={selected.preview} alt={selected.alt} width="512" height="512"/><h3>{selected.title}</h3><div class="badges"><span class="badge">{selected.categoryName}</span><span class="badge">{selected.difficulty}</span></div><a class="button primary wide" href={`/studio/?page=${selected.id}`}>🖌 Color in Studio</a><div class="quick-downloads"><a class="button secondary" href={selected.downloads.pdf}>♧ Download PDF</a><a class="button secondary" href={selected.downloads.webp}>▧ Download WEBP</a></div></div><p data-preview-error role="alert" hidden></p></aside>}</div>}
{result.total_pages>1&&<nav class="pagination" aria-label="Pagination">{result.page>1?<a href={pageHref(result.page-1)} aria-label="Previous page">‹</a>:<span aria-disabled="true">‹</span>}{Array.from({length:Math.min(result.total_pages,100)},(_,i)=>i+1).filter(p=>p===1||p===result.total_pages||Math.abs(p-result.page)<=2).map(p=><a class:list={[p===result.page&&'active']} aria-current={p===result.page?'page':undefined} href={pageHref(p)}>{p}</a>)}{result.has_more&&<a href={pageHref(result.page+1)} aria-label="Next page">›</a>}</nav>}
</main></div><script>import '../../ui/catalog';</script></Layout>
