---
import {env} from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import Card from '../../components/Card.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Icon from '../../components/HomeIcon.astro';
import {categories,animalCategories} from '../../ui/categories';
import {categoryCopy,animalCopy} from '../../ui/category-copy';
import {displayTitle} from '../../ui/titles';
import {createCatalog,parseCatalogQuery} from '../../server/catalog';
import type {Env,CatalogPage,CatalogQuery} from '../../server/types';
const repo=createCatalog(env as unknown as Env);
const parts=(Astro.params.category||'').split('/').filter(Boolean);
const category=parts[0]||'',subcategory=parts[1]||'',animal=category==='animals';
const categoryInfo=categories.find(c=>c.id===category),subInfo=animalCategories.find(c=>c.id===subcategory);
if((category&&!categoryInfo)||parts.length>2||(subcategory&&(!animal||!subInfo)))return Astro.redirect('/404/');
const params=new URLSearchParams(Astro.url.search);if(category)params.set('category',category);if(subcategory)params.set('subcategory',subcategory);params.set('limit',animal?'6':'12');
let error='';let result:CatalogPage={items:[],total:0,page:1,page_size:12,total_pages:0,next_cursor:null,has_more:false};let query:CatalogQuery={age:[],difficulty:[],sort:'trending'};
try{query=parseCatalogQuery(params);result=await repo.list(query)}catch(e){error=e instanceof Error?e.message:'The catalog could not be loaded.';Astro.response.status=400;}
const samples=animal?await Promise.all(animalCategories.map(c=>repo.get(c.sample))):[];
const selected=result.items[0];
const cover=await repo.get(categoryInfo?.sample||'friendly-dragon');
const heading=query.q?`Coloring pages for “${query.q}”`:subcategory?`${subInfo!.name} coloring pages`:categoryInfo?`${categoryInfo.id==='animals'?'Animal':categoryInfo.name} coloring pages`:'Find your next favorite page.';
const intro=query.q?'Explore the pages that match your idea. Try another word, choose a theme or adjust the filters to find something you love.':subcategory?animalCopy[subcategory]:categoryInfo?categoryCopy[category].intro:'A little time for color starts here. Explore woodland friends, blooming gardens, imaginary worlds and more. Choose a black-and-white page to print, or make it your own in the coloring studio.';
const pageHref=(page:number)=>{const p=new URLSearchParams(Astro.url.search);p.set('page',String(page));return `${Astro.url.pathname}?${p}#catalog-results`};
const activeFilters=[...(query.age||[]),...(query.difficulty||[])];
const more=category&&result.items.length<4?(await repo.list({limit:8})).items.filter(x=>x.category!==category).slice(0,4):[];
---
<Layout title={`${query.q?heading:categoryInfo?heading:'Printable coloring pages'} — JotColoring`} description={intro} noindex={Astro.url.search.length>0}><Header active={category} search={query.q||''}/>
<div class="iv-catalog-wrap hv-container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><Icon name="chevron" size={12}/>{categoryInfo?<><a href="/coloring-pages/">Coloring pages</a><Icon name="chevron" size={12}/><a href={`/coloring-pages/${category}/`}>{categoryInfo.name}</a>{subInfo&&<><Icon name="chevron" size={12}/><span aria-current="page">{subInfo.name}</span></>}</>:<span aria-current="page">Coloring pages</span>}</nav>
<section class="iv-category-hero"><div><p class="hv-kicker">{categoryInfo?'A LITTLE WORLD TO MAKE YOUR OWN':'THE JOTCOLORING COLLECTION'}</p><h1>{query.q?heading:displayTitle(heading)}</h1><p class="iv-category-intro">{intro}</p><div class="iv-category-facts"><span><Icon name="file" size={15}/>Printable PDF & WEBP</span><span><Icon name="brush" size={15}/>Color online</span><a href="/license/">Personal & classroom use <Icon name="arrow" size={14}/></a></div></div><div class="iv-category-art" aria-hidden="true"><span class="iv-cover-orbit"></span>{cover&&<img src={cover.thumbnail} alt="" width="300" height="300"/>}<span class="iv-cover-badge"><CategoryIcon name={category||'all'} size={32}/></span><span class="iv-cover-caption">Your next canvas.<Icon name="brush" size={14}/></span></div></section>
<div class="browse-shell iv-browse-shell"><Sidebar animal={animal} category={category} active={subcategory} age={query.age||[]} difficulty={query.difficulty||[]}/><main id="main" class:list={['main-content','iv-catalog-main',animal&&'animals-page']}>
{animal&&<div class="iv-themes"><div class="iv-small-heading"><h2>Follow your favorite creatures</h2><span>Explore an animal theme</span></div><div class="subcategory-strip">{animalCategories.map((c,i)=><a class:list={[subcategory===c.id&&'is-active']} href={`/coloring-pages/animals/${c.id}/`}>{samples[i]&&<img src={samples[i]!.thumbnail} alt={samples[i]!.alt} width="180" height="150"/>}<strong>{c.name}</strong></a>)}</div></div>}
<form class="filter-bar iv-filter-bar" id="catalog-filters" action={Astro.url.pathname}>{query.q&&<input type="hidden" name="q" value={query.q}/>}<div class="iv-filter-label"><Icon name="grid" size={16}/><strong id="catalog-results">{result.total} {result.total===1?'page':'pages'}</strong></div><label class="sr-only" for="category-filter">Category</label><select id="category-filter" name="category" data-filter-select><option value="">All categories</option>{categories.map(c=><option value={c.id} selected={category===c.id||query.category===c.id}>{c.name}</option>)}</select><label class="sr-only" for="age-filter">Age</label><select id="age-filter" name="age" data-filter-select><option value="">All ages</option>{['kids','teens','adults'].map(a=><option value={a} selected={query.age?.includes(a)}>{a==='adults'?'Grown-ups':a[0].toUpperCase()+a.slice(1)}</option>)}</select><label class="sr-only" for="difficulty-filter">Difficulty</label><select id="difficulty-filter" name="difficulty" data-filter-select><option value="">Any detail level</option><option value="easy" selected={query.difficulty?.includes('easy')}>Easy</option><option value="detailed" selected={query.difficulty?.includes('detailed')}>Detailed</option></select><label class="sr-only" for="sort-filter">Sort pages</label><select class="sort-select" id="sort-filter" name="sort" data-filter-select><option value="trending" selected={query.sort==='trending'}>Popular first</option><option value="newest" selected={query.sort==='newest'}>Newest first</option><option value="title" selected={query.sort==='title'}>A–Z</option></select><noscript><button type="submit">Apply filters</button></noscript></form>
{activeFilters.length>0&&<div class="iv-active-filters"><span>Showing: {activeFilters.join(' · ')}</span><a href={Astro.url.pathname}>Clear filters ×</a></div>}
{error?<div class="empty" role="alert">{error} <a href="/coloring-pages/">Reset filters</a></div>:result.items.length===0?<div class="empty iv-empty"><Icon name="search" size={34}/><h2>A different little adventure?</h2><p>No pages match this selection yet. Try another word or fewer filters.</p><a class="hv-button hv-outline" href={category?Astro.url.pathname:'/coloring-pages/'}>Explore more pages <Icon name="arrow" size={16}/></a></div>:<div class:list={[animal&&'animals-results']}><div class:list={['catalog-grid',animal&&'animal-grid']}>{result.items.map((item,i)=><Card item={item} quick={animal} selected={animal&&i===0} showCategory/>)}</div>{animal&&selected&&<aside class="quick-preview" id="quick-preview" aria-label="Quick preview" aria-live="polite"><div class="iv-small-heading"><h2>Quick preview</h2><Icon name="search" size={17}/></div><div data-preview-body><img src={selected.preview} alt={selected.alt} width="512" height="512"/><h3>{selected.title}</h3><div class="badges"><span class="badge">{selected.categoryName}</span><span class="badge">{selected.difficulty||'Ready to color'}</span></div><a class="button primary wide" href={`/studio/?page=${selected.id}`}><Icon name="brush" size={18}/>Color in Studio <Icon name="arrow" size={16}/></a><div class="quick-downloads"><a class="button secondary" href={selected.downloads.pdf}><Icon name="file" size={16}/>PDF</a><a class="button secondary" href={selected.downloads.webp}><Icon name="download" size={16}/>WEBP</a></div></div><p data-preview-error role="alert" hidden></p><p class="iv-preview-note">Your download is a clean, uncolored page.</p></aside>}</div>}
{result.total_pages>1&&<nav class="pagination" aria-label="Pagination">{result.page>1?<a href={pageHref(result.page-1)} aria-label="Previous page">←</a>:<span aria-disabled="true">←</span>}{Array.from({length:Math.min(result.total_pages,100)},(_,i)=>i+1).filter(p=>p===1||p===result.total_pages||Math.abs(p-result.page)<=2).map(p=><a class:list={[p===result.page&&'active']} aria-current={p===result.page?'page':undefined} href={pageHref(p)}>{p}</a>)}{result.has_more&&<a href={pageHref(result.page+1)} aria-label="Next page">→</a>}</nav>}
{category&&<section class="iv-category-note"><span><CategoryIcon name={category} size={29}/></span><div><h2>Make this {categoryInfo!.name.toLowerCase()} page your own.</h2><p>{categoryCopy[category].note}</p></div><a href="/studio/" class="hv-text-link">Try Studio <Icon name="arrow" size={16}/></a></section>}
{more.length>0&&<section class="iv-more"><div class="hv-section-heading"><div><p class="hv-kicker">KEEP YOUR CURIOSITY GOING</p><h2>A different little adventure.</h2></div><a href="/coloring-pages/" class="hv-text-link">Explore all <Icon name="arrow" size={16}/></a></div><div class="catalog-grid">{more.map(item=><Card item={item} showCategory/>)}</div></section>}
</main></div></div><script>import '../../ui/catalog';</script></Layout>
