---
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';import ImageLicense from '../components/ImageLicense.astro';import Header from '../components/Header.astro';import Sidebar from '../components/Sidebar.astro';import Card from '../components/Card.astro';import Compare from '../components/Compare.astro';import {categories} from '../ui/categories';import {createCatalog} from '../server/catalog';import type {Env} from '../server/types';
const repo=createCatalog(env as unknown as Env);
const popularTab=Astro.url.searchParams.get('popular')||'trending';
const query:any={marketingOnly:true,limit:4,sort:popularTab==='newest'?'newest':'trending'};if(['easy','detailed'].includes(popularTab))query.difficulty=[popularTab];
const [popular,categoryItems]=await Promise.all([repo.list(query),Promise.all(categories.map(c=>repo.get(c.sample)))]);
---
<Layout><Header/><div class="browse-shell home-shell"><Sidebar home/><main id="main" class="main-content home-main"><h1>What will you color today?</h1><p class="home-subtitle">Explore a world of printable coloring pages.</p><div class="section-heading"><h2>Explore categories</h2><a class="desktop-only" href="/coloring-pages/">See all categories <span>→</span></a></div><div class="category-grid">{categories.map((c,i)=><a class="category-tile" href={`/coloring-pages/${c.id}/`}>{categoryItems[i]?<><ImageLicense item={categoryItems[i]!} assets={[categoryItems[i]!.thumbnail,categoryItems[i]!.home_color]}/><Compare line={categoryItems[i]!.thumbnail} color={categoryItems[i]!.home_color} alt={categoryItems[i]!.alt} interactive={false}/></>:<div class="category-empty">{c.icon}<small>Explore {c.name.toLowerCase()}</small></div>}<strong>{c.name}</strong></a>)}</div><div class="section-heading popular-heading"><h2>Popular coloring pages</h2><nav class="popular-tabs" aria-label="Popular pages sort">{['Trending','Newest','Easy','Detailed'].map(t=><a class:list={[popularTab===t.toLowerCase()&&'active']} href={`/?popular=${t.toLowerCase()}`}>{t}</a>)}</nav><a href="/coloring-pages/"> <span class="desktop-only">View all pages</span><span class="mobile-only">See all pages</span> →</a></div><div class="popular-grid">{popular.items.map(item=><Card item={item} marketing/>)}</div>{popular.items.length===0&&<div class="empty">There are no pages in this selection yet. <a href="/coloring-pages/">Explore all pages</a></div>}</main></div><section class="home-promos" aria-label="Create and color"><div class="promo"><span class="promo-icon">💡</span><div><h2>Have an idea? Make it a page.</h2><p>Turn your ideas into printable coloring pages with AI.</p></div><a class="button primary" href="/create/text/">Try AI Builder →</a></div><div class="promo"><span class="promo-icon">🖌</span><div><h2>Pick a page. Add your color.</h2><p>Paint online with easy-to-use tools.</p></div><a class="button secondary" href="/studio/">Open Studio →</a></div></section><footer class="site-footer"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/license/">Image license</a><a href="/admin/">Manage content</a></footer></Layout>
