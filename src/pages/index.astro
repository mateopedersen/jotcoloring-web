---
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Compare from '../components/Compare.astro';
import ImageLicense from '../components/ImageLicense.astro';
import Icon from '../components/HomeIcon.astro';
import HomeCard from '../components/HomeCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import {categories} from '../ui/categories';
import {createCatalog} from '../server/catalog';
import type {Env,CatalogQuery} from '../server/types';
import '../styles/home-v3.css';
const repo=createCatalog(env as unknown as Env);
const requestedTab=Astro.url.searchParams.get('popular')||'trending';
const popularTab=['trending','newest','easy','detailed'].includes(requestedTab)?requestedTab:'trending';
const query:CatalogQuery={marketingOnly:true,limit:24,sort:popularTab==='newest'?'newest':'trending'};
if(popularTab==='easy'||popularTab==='detailed')query.difficulty=[popularTab];
const [popular,featured]=await Promise.all([repo.list(query),repo.list({marketingOnly:true,limit:6,sort:'trending'})]);
const categoryDescriptions=['Furry friends & wildlife','Petals, leaves & gardens','Dragons & magical worlds','Patterns to get lost in','A little seasonal joy','Adventure on every page','Out-of-this-world ideas','Dive into something lovely','Sweet little creations','Big prehistoric adventures'];
const tabs=[{id:'trending',label:'All favorites'},{id:'newest',label:'Just added'},{id:'easy',label:'Easy & relaxing'},{id:'detailed',label:'Beautifully detailed'}];
---
<Layout bodyClass="home-v3" title="JotColoring — Color your own kind of happy." description="Find your next favorite coloring page. Explore animals, flowers, fantasy and more, print a page or color it your way in JotColoring Studio.">
 <Header home/>
 <main id="main">
  <section class="hv-hero hv-container" aria-labelledby="home-title"><div class="hv-hero-copy"><p class="hv-kicker"><span></span> YOUR NEXT CREATIVE BREAK</p><h1 id="home-title">Bring a little<br/><span>color<svg viewBox="0 0 385 16" fill="none" aria-hidden="true"><path d="M3 11C111 1 258 0 381 6M49 15c106-7 211-9 296-5" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span> to your day.</h1><p class="hv-hero-description">Find a coloring page you love. Make it bright, make it bold, make it completely yours. Print at home or start coloring right here.</p><form class="hv-search" action="/coloring-pages/" role="search"><Icon name="search" size={23}/><label class="sr-only" for="home-search">Search coloring pages</label><input id="home-search" name="q" type="search" placeholder="What would you love to color?"/><button type="submit">Find a page <Icon name="arrow" size={18}/></button></form><div class="hv-search-suggestions"><span>Try something:</span><a href="/coloring-pages/animals/">Animals</a><a href="/coloring-pages/flowers/">Flowers</a><a href="/coloring-pages/fantasy/">A little magic</a></div><div class="hv-hero-benefits"><span><Icon name="check" size={16}/>Print at home</span><span><Icon name="check" size={16}/>Color in your browser</span><span><Icon name="check" size={16}/>Make it yours</span></div></div>
   <div class="hv-art-stage"><span class="hv-stage-dots" aria-hidden="true"></span><div class="hv-stage-orbit" aria-hidden="true"></div><div class="hv-stage-caption"><span class="hv-stage-star">✳</span><span>Less screen time.<br/><b>More me time.</b></span></div>{featured.items.slice(0,3).map((item,i)=><article class={`hv-feature-art hv-feature-art-${i}`}><ImageLicense item={item} assets={[item.thumbnail,item.home_color]}/><Compare line={item.thumbnail} color={item.home_color} alt={item.alt}/><a class="hv-feature-title" href={`/coloring/${item.slug}/`}><b>{item.title}</b><Icon name="arrow" size={18}/></a></article>)}<div class="hv-stage-sticker"><Icon name="brush" size={21}/><span>YOUR COLORS.<br/><b>YOUR WORLD.</b></span></div><svg class="hv-stage-swoosh" viewBox="0 0 100 80" fill="none" aria-hidden="true"><path d="M4 5c50-4 88 17 60 40-12 9-26 6-15-4 10-9 32 6 41 33m-17-5 17 6 6-18" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
  </section>
  <div class="hv-discovery-layout hv-container"><aside class="hv-discovery-nav" aria-labelledby="category-title"><div class="hv-discovery-title"><p class="hv-kicker">FOLLOW YOUR CURIOSITY</p><h2 id="category-title">Find your<br/>kind of happy.</h2></div><nav aria-label="Coloring categories"><a class="hv-discovery-all" href="/coloring-pages/"><span class="hv-category-symbol"><CategoryIcon name="all"/></span><span><strong>All coloring pages</strong><small>A little of everything</small></span><Icon name="chevron" size={14}/></a>{categories.map((c,i)=><a href={`/coloring-pages/${c.id}/`}><span class="hv-category-symbol"><CategoryIcon name={c.id}/></span><span><strong>{c.name}</strong><small>{categoryDescriptions[i]}</small></span><Icon name="chevron" size={14}/></a>)}</nav><a class="hv-sidebar-note" href="/studio/"><Icon name="brush" size={23}/><strong>A creative break?</strong><span>Your colors are waiting.</span><b>Open Studio <Icon name="arrow" size={15}/></b></a></aside>
  <section id="gallery" class="hv-gallery-section"><div class="hv-gallery-inner"><div class="hv-section-heading"><div><p class="hv-kicker">PICK A PAGE. MAKE IT YOURS.</p><h2>So many pages.<br/>So many possibilities.</h2><p class="hv-section-description">Pick something that speaks to you. Your next masterpiece starts here.</p></div><a class="hv-text-link" href="/coloring-pages/">View the full collection <Icon name="arrow" size={18}/></a></div><div class="hv-gallery-toolbar"><nav class="hv-tabs" aria-label="Coloring page selection">{tabs.map(tab=><a href={`/?popular=${tab.id}#gallery`} class:list={[popularTab===tab.id&&'is-active']} aria-current={popularTab===tab.id?'page':undefined}>{tab.id==='trending'&&<Icon name="spark" size={16}/ >}{tab.label}</a>)}</nav><span class="hv-gallery-hint"><span class="hv-split-symbol" aria-hidden="true">↔</span>Slide a picture to try a little color</span></div><div class="hv-gallery">{popular.items.map(item=><HomeCard item={item}/>)}</div>{popular.items.length===0&&<p class="hv-empty">More pages are on their way. <a href="/coloring-pages/">Explore the collection</a></p>}<div class="hv-gallery-end"><span>There’s a whole world waiting for your colors.</span><a class="hv-button hv-outline" href="/coloring-pages/">Keep exploring <Icon name="arrow" size={18}/></a></div></div></section>
  </div>
  <section class="hv-create hv-container" aria-labelledby="create-title"><div class="hv-section-heading"><div><p class="hv-kicker">TAKE YOUR IMAGINATION A LITTLE FURTHER</p><h2 id="create-title">More ways to make it yours.</h2></div></div><div class="hv-create-grid"><div class="hv-studio-feature"><div class="hv-tool-copy"><span class="hv-tool-label"><Icon name="brush" size={18}/>COLORING STUDIO</span><h3>A blank page.<br/>Endless you.</h3><p>Choose a color, fill a little corner, or paint the whole world. Your creative space is ready.</p><a class="hv-button hv-primary" href="/studio/">Let’s color something <Icon name="arrow" size={18}/></a><span class="hv-tool-footnote">Fill areas · Brushes · Layers · Save your artwork</span></div><div class="hv-studio-art" aria-hidden="true">{featured.items.slice(0,3).map((item,i)=><div class={`hv-paper hv-paper-${i}`}><Compare line={item.thumbnail} color={item.home_color} alt="" interactive={false}/></div>)}<div class="hv-palette"><span></span><span></span><span></span><span></span><span></span><Icon name="brush" size={21}/></div></div></div><div class="hv-ai-feature"><span class="hv-tool-label"><Icon name="spark" size={18}/>AI PAGE BUILDER</span><div class="hv-ai-orbit" aria-hidden="true"><Icon name="spark" size={54}/><span>✧</span><span>✦</span></div><h3>Dream it.<br/>Then color it.</h3><p>A tiny dragon in a teacup? Turn your own idea or a favorite photo into a coloring page.</p><div class="hv-ai-links"><a href="/create/text/">Start with an idea <Icon name="arrow" size={18}/></a><a href="/create/photo/">Start with a photo <Icon name="photo" size={18}/></a></div></div></div></section>
  <section class="hv-how hv-container" aria-labelledby="how-title"><div><p class="hv-kicker">A LITTLE LESS SCROLLING. A LITTLE MORE COLORING.</p><h2 id="how-title">Your next creative break<br/>starts with one page.</h2></div><div class="hv-how-step"><span>01</span><h3>Find your page</h3><p>Follow a favorite theme or try something new.</p></div><div class="hv-how-step"><span>02</span><h3>Pick your way to play</h3><p>Download a PDF or WEBP, or open it in Studio.</p></div><div class="hv-how-step"><span>03</span><h3>Make a little time for you</h3><p>Grab your colors. The rest is up to your imagination.</p></div></section>
 </main>
 <Footer/>

</Layout>
