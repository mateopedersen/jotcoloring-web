---
import CategoryDirectory from '../components/CategoryDirectory.astro';
import DifficultyNavigation from '../components/DifficultyNavigation.astro';
import CreatePlayground from '../components/CreatePlayground.astro';
import AgeNavigation from '../components/AgeNavigation.astro';
import HomeHowItWorks from '../components/HomeHowItWorks.astro';
import GalleryClosingPages from '../components/GalleryClosingPages.astro';
import GalleryExplore from '../components/GalleryExplore.astro';
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Compare from '../components/Compare.astro';
import ImageLicense from '../components/ImageLicense.astro';
import Icon from '../components/HomeIcon.astro';
import SearchForm from '../components/SearchForm.astro';
import HomeCard from '../components/HomeCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ActionIcon from '../components/ActionIcon.astro';
import NavMagicIcon from '../components/NavMagicIcon.astro';
import {categories} from '../ui/categories';
import {createCatalog} from '../server/catalog';
import type {Env,CatalogQuery} from '../server/types';
import '../styles/home-v3.css';
const repo=createCatalog(env as unknown as Env);
const requestedTab=Astro.url.searchParams.get('popular')||'trending';
const popularTab=['trending','newest','easy','detailed'].includes(requestedTab)?requestedTab:'trending';
const query:CatalogQuery={marketingOnly:true,limit:24,sort:popularTab==='newest'?'newest':'trending'};
if(popularTab==='easy'||popularTab==='detailed')query.difficulty=[popularTab];
const [popular,featuredPage]=popularTab==='trending'?[await repo.list(query),undefined]:await Promise.all([repo.list(query),repo.list({marketingOnly:true,limit:6,sort:'trending'})]);
const featured=featuredPage||{items:popular.items.slice(0,6)};
// Finish with two real pages from different collections, without repeating a card.
const closingItems:typeof popular.items=[];
if(popularTab==='trending'&&popular.items.length>=8){
 for(const category of ['flowers','ocean']){
  const page=popular.items.findLast(item=>(item.category_ids||[item.category]).includes(category)&&!closingItems.some(selected=>selected.id===item.id));
  if(page)closingItems.push(page);
 }
}
const closingIds=new Set(closingItems.map(item=>item.id));
const galleryItems=popular.items.filter(item=>!closingIds.has(item.id));
const categoryDescriptions=['Furry friends & wildlife','Petals, leaves & gardens','Dragons & magical worlds','Patterns to get lost in','A little seasonal joy','Adventure on every page','Out-of-this-world ideas','Sea turtles, fish & coral','Sweet little creations','Big prehistoric adventures'];
const animalThemes=[
 {name:'Woodland',description:'Forest friends & nature',href:'/coloring-pages/animals/woodland/',icon:'woodland'},
 {name:'Pets',description:'Cats, dogs & cozy companions',href:'/coloring-pages/animals/pets/',icon:'pets'},
 {name:'Farm Animals',description:'Animals around the farm',href:'/coloring-pages/animals/farm-animals/',icon:'farm-animals'},
 {name:'Birds',description:'Feathers, wings & wonder',href:'/coloring-pages/animals/birds/',icon:'birds'},
 {name:'Ocean Life',description:'Creatures beneath the waves',href:'/coloring-pages/animals/ocean-life/',icon:'ocean-life'}
];
const discoveryIdeas=[['Foxes','fox','foxes'],['Cats','cat','cats'],['Dogs','dog','dogs'],['Butterflies','butterfly','butterflies'],['Dragons','dragon','dragons'],['Owls','owl','owls'],['Turtles','turtle','sea-turtles'],['Gardens','garden','gardens'],['Snowmen','snowman','snowmen']];
const tabs=[{id:'trending',label:'Featured pages',hint:'A little of everything'},{id:'newest',label:'Just added',hint:'Fresh inspiration'},{id:'easy',label:'Easy coloring',hint:'Bigger spaces'},{id:'detailed',label:'Detailed designs',hint:'More to discover'}];
---
<Layout bodyClass="home-v3" title="Free Printable Coloring Pages for Kids & Adults | JotColoring" description="Explore free printable coloring pages for kids and adults. Download a PDF or image, color online, or turn your own photo into a coloring page.">
 <Header home/>
 <main id="main">
  <section class="hv-hero hv-container" aria-labelledby="home-title"><div class="hv-hero-copy"><h1 id="home-title">Free printable <br/><span>coloring<svg viewBox="0 0 385 16" fill="none" aria-hidden="true"><path d="M3 11C111 1 258 0 381 6M49 15c106-7 211-9 296-5" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span> pages.</h1><p class="hv-hero-description">Find animals, flowers, fantasy scenes, and more to color. Download a free PDF, print your favorite page, or add colors in our online studio.</p><SearchForm variant="hero"/><div class="hv-search-suggestions jc-hero-ideas"><span>Browse a theme</span><a href="/coloring-pages/animals/"><CategoryIcon name="animals" size={32}/>Animals</a><a href="/coloring-pages/flowers/"><CategoryIcon name="flowers" size={32}/>Flowers</a><a href="/coloring-pages/fantasy/"><CategoryIcon name="fantasy" size={32}/>Fantasy</a></div><div class="hv-hero-benefits jc-hero-benefits"><span><ActionIcon name="pdf" size={32}/><span>Print at home<small>Ready when you are</small></span></span><span><ActionIcon name="brush" size={32}/><span>Color online<small>Make it your own</small></span></span><span><ActionIcon name="heart" size={32}/><span>Save favorites<small>Keep what you love</small></span></span></div></div>
   <div class="hv-art-stage"><span class="hv-stage-dots" aria-hidden="true"></span><div class="hv-stage-orbit" aria-hidden="true"></div><div class="hv-stage-caption"><span class="hv-stage-star">✳</span><span>Pick a page.<br/><b>Make it yours.</b></span></div>{featured.items.slice(0,3).map((item,i)=><article data-image-title={item.title} data-image-description={item.description} class={`hv-feature-art hv-feature-art-${i}`}><ImageLicense item={item} assets={[item.thumbnail,item.home_color]}/><Compare eager={i===0} priority={i===0} line={item.thumbnail} color={item.home_color} alt={item.alt||item.description||item.title}/><a class="hv-feature-title" href={`/coloring/${item.slug}/`}><b>{item.title}</b><Icon name="arrow" size={18}/></a></article>)}<div class="hv-stage-sticker"><Icon name="brush" size={21}/><span>YOUR COLORS.<br/><b>YOUR WORLD.</b></span></div><svg class="hv-stage-swoosh" viewBox="0 0 100 80" fill="none" aria-hidden="true"><path d="M4 5c50-4 88 17 60 40-12 9-26 6-15-4 10-9 32 6 41 33m-17-5 17 6 6-18" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
  </section>
<DifficultyNavigation home/><div class="hv-container"><AgeNavigation/></div>
  <div class="hv-discovery-layout hv-container"><aside class="hv-discovery-nav" aria-labelledby="category-title"><div class="hv-discovery-title"><p class="hv-kicker">FOLLOW YOUR CURIOSITY</p><h2 id="category-title">Find a theme<br/>you love.</h2></div><nav aria-label="Coloring categories"><a class="hv-discovery-all" href="/coloring-pages/"><span class="hv-category-symbol"><CategoryIcon name="all"/></span><span><strong>All coloring pages</strong><small>A little of everything</small></span><Icon name="chevron" size={14}/></a>{categories.slice(0,10).map((c,i)=><a href={`/coloring-pages/${c.id}/`}><span class="hv-category-symbol"><CategoryIcon name={c.id}/></span><span><strong>{c.name}</strong><small>{categoryDescriptions[i]}</small></span><Icon name="chevron" size={14}/></a>)}</nav><p class="jc-discovery-label">EXPLORE ANIMAL THEMES</p><nav aria-label="Animal themes">{animalThemes.map(theme=><a href={theme.href}><span class="hv-category-symbol"><CategoryIcon name={theme.icon}/></span><span><strong>{theme.name}</strong><small>{theme.description}</small></span><Icon name="chevron" size={14}/></a>)}</nav><details class="jc-discovery-ideas"><summary>More ideas <span>9 themes</span><Icon name="chevron" size={14}/></summary><div>{discoveryIdeas.map(([label,term,icon])=><a href={`/coloring-pages/?q=${encodeURIComponent(term)}#catalog-results`}><CategoryIcon name={icon} size={34}/><span>{label}</span><Icon name="arrow" size={15}/></a>)}</div></details><a class="hv-sidebar-note" href="/studio/"><Icon name="brush" size={23}/><strong>A creative break?</strong><span>Your colors are waiting.</span><b>Open Studio <Icon name="arrow" size={15}/></b></a></aside>
  <section id="gallery" class="hv-gallery-section"><div class="hv-gallery-inner"><div class="jc-gallery-intro"><div class="jc-gallery-copy"><h2>Pick your next page.<br/><span>Make it your own.</span></h2><p>Browse printable designs, try a color preview, and choose your next coloring page.</p><a class="jc-gallery-collection" href="/coloring-pages/">Explore the collection <Icon name="arrow" size={17}/></a></div><div class="jc-gallery-art" aria-hidden="true"><span class="jc-gallery-orbit"></span>{featured.items.slice(0,2).map((item,i)=><div class={`jc-gallery-paper jc-gallery-paper-${i}`}><img src={item.home_color||item.thumbnail} alt="" loading="lazy" width="150" height="180"/></div>)}<span class="jc-gallery-stamp"><ActionIcon name="brush" size={34}/> MADE FOR<br/><b>YOUR COLORS</b></span><svg class="jc-gallery-sparkle" width="34" height="34" viewBox="0 0 34 34" fill="none"><path d="M17 2 20 14l12 3-12 3-3 12-3-12-12-3 12-3Z" fill="#f6b06d" stroke="#e4834c"/></svg></div></div><div class="jc-gallery-choices"><div class="jc-gallery-choice-title"><span>FIND YOUR FAVORITE</span><small>Browse by style or see what’s new</small></div><nav class="hv-tabs jc-gallery-tabs" aria-label="Coloring page selection">{tabs.map(tab=><a href={`/?popular=${tab.id}#gallery`} class:list={[popularTab===tab.id&&'is-active']} aria-current={popularTab===tab.id?'page':undefined}><span class="jc-gallery-tab-art">{tab.id==='trending'?<ActionIcon name="heart" size={38}/>:tab.id==='newest'?<NavMagicIcon/>:<CategoryIcon name={tab.id==='easy'?'flowers':'mandalas'} size={38}/>}</span><span><strong>{tab.label}</strong><small>{tab.hint}</small></span></a>)}</nav></div><div class="hv-gallery" data-home-gallery-grid>{galleryItems.map(item=><HomeCard item={item}/>)}</div><GalleryClosingPages items={closingItems}/>{popular.items.length===0&&<p class="hv-empty">{popularTab==='easy'?'No easy pages are available yet.':'No pages are available in this selection yet.'} <a href="/coloring-pages/">Explore the collection</a></p>}<GalleryExplore items={popular.items.length?popular.items:featured.items}/></div></section>
  </div>
  <CategoryDirectory counts={await repo.categories()}/><CreatePlayground/>
  <HomeHowItWorks item={featured.items[0]}/>
 </main>
 <Footer/>

</Layout>
