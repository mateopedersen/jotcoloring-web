---
import {env} from 'cloudflare:workers';import Layout from '../../layouts/Layout.astro';import {requireAdmin} from '../../server/auth';let authorized=false;try{await requireAdmin(Astro.request,env);authorized=true}catch{Astro.response.status=403}
---
<Layout title="JotColoring management" noindex><header class="admin-header"><a href="/"><img src="/logo.svg" alt="jotcoloring" width="230" height="45"/></a><strong>Content management</strong><a href="/">View site →</a></header><main id="main" class="admin-main">{!authorized?<section class="empty"><h1>Authorized access required</h1><p>Sign in through the configured Cloudflare Access application to manage this site.</p><p>No management data is available without verified authorization.</p></section>:<><h1>Manage JotColoring</h1><p>Content, files, publishing and recovery in one place.</p><nav class="admin-tabs"><button data-tab="content" class="active">Content</button><button data-tab="import">Import & upload</button><button data-tab="categories">Categories</button><button data-tab="operations">Jobs & audit</button></nav><p id="admin-message" role="status"></p><section id="tab-content"><div class="admin-toolbar"><select id="status-filter" aria-label="Publication status"><option value="">All statuses</option>{['draft','processing','ready_for_review','published','archived'].map(s=><option value={s}>{s.replaceAll('_',' ')}</option>)}</select><button id="refresh-content">Refresh</button></div><div id="content-list"></div><dialog id="edit-content"><h2>Content manifest</h2><p>Edit metadata with the expected version. Assets remain checksum-bound.</p><textarea id="edit-manifest" rows="18"></textarea><div class="admin-toolbar"><button id="save-manifest" class="primary">Validate & submit update</button><button id="close-edit">Close</button></div></dialog></section><section id="tab-import" hidden><h2>Upload a source</h2><p>Upload files privately, then process and validate them before publication. PDFs must be under 1 MB.</p><input id="admin-upload" type="file" accept="image/png,image/webp,image/avif,application/pdf"/><button id="upload-file">Upload privately</button><pre id="upload-result"></pre><h2>Import manifest</h2><p>Paste a prepared manifest from the validated media pipeline. Validation never publishes a file by itself.</p><textarea id="import-manifest" rows="15" aria-label="Import manifest JSON"></textarea><div class="admin-toolbar"><button id="validate-import">Validate only</button><button id="run-import" class="primary">Submit import</button></div><pre id="import-result"></pre></section><section id="tab-categories" hidden><h2>Categories</h2><div id="category-list"></div><form id="category-form"><label>Stable ID<input name="id" required pattern="[a-z0-9-]+"/></label><label>Name<input name="name" required/></label><label>Parent ID (optional)<input name="parent_id"/></label><button class="primary">Save category</button></form></section><section id="tab-operations" hidden><h2>Operations</h2><button id="refresh-status">Refresh status</button><button id="retry-outbox">Retry pending projection jobs</button><pre id="ops-status"></pre><h2>Audit log</h2><pre id="audit-log"></pre><p>Backup and restore commands are documented in the repository runbook. Restore is performed against a separate verified target.</p></section></>}</main>{authorized&&<script>import '../../ui/admin';</script>}</Layout>
<style>.admin-header{display:flex;align-items:center;gap:30px;border-bottom:1px solid var(--border);padding:15px 25px}.admin-header>a:last-child{margin-left:auto}.admin-main{max-width:1200px;margin:25px auto;padding:15px}.admin-main>p{margin:10px 0 20px}.admin-tabs{display:flex;gap:12px;margin:15px 0 25px}.admin-tabs button.active{background:var(--peach);border-color:var(--orange)}.admin-toolbar{display:flex;gap:10px;margin:14px 0}textarea{width:100%;font-family:monospace}pre{background:#f6f7f9;padding:15px;overflow:auto;max-height:450px}#edit-content{width:min(850px,95vw);border:1px solid var(--border);border-radius:10px}#edit-content::backdrop{background:#0005}#category-form{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}#category-form label{display:grid;gap:5px}.admin-main h2{margin:18px 0 12px}.admin-main :global(table){width:100%;border-collapse:collapse}.admin-main :global(td),.admin-main :global(th){text-align:left;padding:12px;border-bottom:1px solid var(--border)}.admin-main :global(td button){margin:3px}</style>
