---
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VectorIcon from '../components/VectorIcon.astro';
import SceneArt from '../components/SceneArt.astro';
import GlyphIcon from '../components/GlyphIcon.astro';
import LostColoringArt from '../components/LostColoringArt.astro';
import SocialMark from '../components/SocialMark.astro';
import {SHARE_PLATFORMS} from '../sharing/platforms';
import catalog from '../icons/catalog.json';
import {glyphs} from '../icons/glyphs';
if(env.APP_ENV!=='local')return new Response(null,{status:404});
const groups=[...new Set(catalog.icons.map(icon=>icon.group))];
---
<Layout title="JotColoring vector design review" noindex><Header/><main id="main" class="svg-review"><p class="hv-kicker">LOCAL DESIGN REVIEW</p><h1>Every icon, in one place.</h1><p>{catalog.icons.length} original illustrations, {catalog.scenes.length} page scenes, {Object.keys(glyphs).length} functional symbols, and the recognizable social platform marks. Actual assets used by the site.</p><nav>{groups.map(group=><a href={'#'+group.toLowerCase().replaceAll(' ','-')}>{group}</a>)}<a href="#scenes">Page scenes</a><a href="#controls">Small controls</a><a href="#social">Social platforms</a></nav>{groups.map(group=><section id={group.toLowerCase().replaceAll(' ','-')}><h2>{group}</h2><div class="svg-grid">{catalog.icons.filter(icon=>icon.group===group).map(icon=><article><VectorIcon name={icon.id} size={112}/><div class="svg-size-check"><VectorIcon name={icon.id} size={24}/><VectorIcon name={icon.id} size={40}/></div><h3>{icon.label}</h3><code>{icon.id}</code></article>)}</div></section>)}<section id="scenes"><h2>Page scenes</h2><div class="svg-scene-grid">{catalog.scenes.map(scene=><article><SceneArt kind={scene.id.replace('scene-','')}/><h3>{scene.id}</h3></article>)}<article><LostColoringArt/><h3>Interactive 404 drawing</h3></article></div></section><section id="controls"><h2>Small controls</h2><div class="svg-glyph-grid">{Object.keys(glyphs).map(name=><article><GlyphIcon name={name} size={24}/><span>{name}</span></article>)}</div></section><section id="social"><h2>Social platforms</h2><p>Platform logos retain their recognizable official geometry.</p><div class="svg-glyph-grid">{SHARE_PLATFORMS.map(platform=><article><SocialMark platform={platform}/><span>{platform.name}</span></article>)}</div></section></main></Layout>
<style>
.svg-review{max-width:1380px;padding:40px 28px;margin:auto}.svg-review h1{font-size:clamp(32px,4vw,54px);margin:12px 0}.svg-review>p{font-size:17px;line-height:1.6;max-width:850px}.svg-review nav{display:flex;flex-wrap:wrap;gap:9px;margin:24px 0}.svg-review nav a{background:#fff4e4;border:1px solid #e5c6a5;padding:10px 14px;border-radius:12px;font-weight:700}.svg-review section{margin:45px 0;scroll-margin-top:140px}.svg-review h2{font-size:28px;margin-bottom:22px}.svg-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.svg-grid article,.svg-scene-grid article{display:flex;flex-direction:column;align-items:center;padding:20px 12px;border:1px solid #e6d9c8;border-radius:20px;background:linear-gradient(150deg,#fff,#fff9ef);min-width:0}.svg-grid h3{font-size:13px;line-height:1.5;min-height:3em;text-align:center}.svg-grid code{font-size:11px;color:#80684c;overflow-wrap:anywhere}.svg-size-check{display:flex;align-items:center;gap:12px;margin:10px 0}.svg-scene-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.svg-scene-grid :global(svg){width:100%;max-height:260px}.svg-scene-grid h3{font-size:15px}.svg-glyph-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.svg-glyph-grid article{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #eee1d0;border-radius:12px}.svg-glyph-grid span{font-size:11px;overflow-wrap:anywhere}@media(max-width:800px){.svg-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.svg-scene-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.svg-glyph-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:480px){.svg-review{padding:30px 15px}.svg-grid,.svg-glyph-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.svg-scene-grid{grid-template-columns:1fr}}
</style>
