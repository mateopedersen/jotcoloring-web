---
import {coloringTopic} from '../../ui/categories';
import {artworkText} from '../../ui/artwork-text';
import {env} from 'cloudflare:workers';
import ImageLicense from '../../components/ImageLicense.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ColorIdeas from '../../components/ColorIdeas.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import AgeRecommendation from '../../components/AgeRecommendation.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import Icon from '../../components/HomeIcon.astro';
import ActionIcon from '../../components/ActionIcon.astro';
import FileActions from '../../components/FileActions.astro';
import ShareButton from '../../components/ShareButton.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {createCatalog} from '../../server/catalog';
import type {Env} from '../../server/types';
const repo=createCatalog(env as unknown as Env);
const item=await repo.get(Astro.params.slug!);
if(!item){const redirect=await repo.redirect(Astro.params.slug!);if(redirect)return Astro.redirect(`/coloring/${redirect}/`,301);return Astro.rewrite('/404/');}
const related=await repo.related(item);
const text=artworkText(item);
const favorite=JSON.stringify({id:item.id,title:item.title,slug:item.slug,thumbnail:item.thumbnail,revision:item.version});
---
<Layout title={`${item.title} coloring page — JotColoring`} description={text.description} socialItem={item}><Fragment slot="head"><link rel="preload" as="image" href={item.preview} imagesrcset={item.previewSrcset} imagesizes="(max-width:768px) calc(100vw - 72px), (max-width:1100px) 44vw, 600px" fetchpriority="high"/></Fragment><ImageLicense item={item} assets={[item.preview,item.lineArtUrl]}/><Header active={item.category}/>
<main id="main" class="detail-main iv-detail hv-container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><Icon name="chevron" size={12}/><a href={`/coloring-pages/${item.category}/`}>{item.categoryName}</a><Icon name="chevron" size={12}/><span aria-current="page">{item.title}</span></nav><div class="detail-grid">
<section class="detail-art" aria-label="Coloring page preview"><div class="iv-paper-label"><span><Icon name="file" size={15}/>YOUR CREATIVITY STARTS HERE</span><span>JotColoring™</span></div><div class="detail-viewport" data-image-title={text.title} data-image-description={text.description}><img id="detail-image" tabindex="0" src={item.preview} srcset={item.previewSrcset} sizes="(max-width:768px) calc(100vw - 72px), (max-width:1100px) 44vw, 600px" alt={text.alt} width={item.width} height={item.height} fetchpriority="high"/></div><div class="detail-caption"><span>Uncolored preview</span><div><button type="button" id="zoom-out" aria-label="Zoom out"><Icon name="minus" size={18}/></button><button type="button" id="zoom-reset" aria-label="Reset zoom to 100 percent" title="Reset zoom"><span id="zoom-label">100%</span></button><button type="button" id="zoom-in" aria-label="Zoom in"><Icon name="plus" size={18}/></button></div></div><p class="iv-art-note"><Icon name="check" size={14}/>The original line art stays clean when you color in Studio.</p><ColorIdeas item={item}/></section>
<section class="detail-copy"><p class="hv-kicker"><CategoryIcon name={item.category} size={19}/>{coloringTopic(item.category).toUpperCase()} COLORING PAGE</p><h1>{item.title}</h1><DifficultyBadge item={item} large/><AgeRecommendation item={item}/><p class="detail-description">{item.description}</p><div class="iv-detail-facts"><a href={`/coloring-pages/${item.category}/`}><CategoryIcon name={item.category} size={23}/><span>From the collection<strong>{item.categoryName}</strong></span><Icon name="arrow" size={14}/></a><div><Icon name="photo" size={21}/><span>High-resolution line art<strong>{item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')} px</strong></span></div></div>
<a class="button primary wide studio-cta" href={`/studio/?page=${item.id}`}><Icon name="brush" size={23}/><span>Color it your way in Studio</span><Icon name="arrow" size={21}/></a>
<div class="download-block"><div class="iv-small-heading"><h2>Print it. Keep it. Color it.</h2><span>Uncolored originals</span></div><FileActions item={item} variant="detail"/><div class="iv-save-share"><button type="button" class="favorite" data-favorite={favorite} aria-pressed="false"><ActionIcon name="heart" size={26}/><b>Save to favorites</b></button><ShareButton item={item} variant="detail"/></div><p class="iv-license-note">Free for personal and non-commercial educational use. <a href="/license/">Read the license</a> or <a href={`/licensing/?image=${item.slug}`}>ask about commercial use</a>.</p></div>
<a class="iv-detail-ai" href="/create/text/"><Icon name="spark" size={24}/><span><strong>Something wonderfully different in mind?</strong><small>Turn your own idea into a coloring page.</small></span><Icon name="arrow" size={19}/></a></section></div>
<RelatedPages item={item} result={related}/></main>
<script>import '../../ui/detail-controls';</script>
</Layout>
