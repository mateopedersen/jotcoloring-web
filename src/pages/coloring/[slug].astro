---
import {env} from 'cloudflare:workers';
import ImageLicense from '../../components/ImageLicense.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/HomeIcon.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {createCatalog} from '../../server/catalog';
import type {Env} from '../../server/types';
const repo=createCatalog(env as unknown as Env);
const item=await repo.get(Astro.params.slug!);
if(!item){const redirect=await repo.redirect(Astro.params.slug!);return Astro.redirect(redirect?`/coloring/${redirect}/`:'/404/',redirect?301:302)}
const related=(await repo.list({category:item.category,limit:8})).items.filter(x=>x.id!==item.id).slice(0,6);
const alternatives=related.length?related:(await repo.list({limit:5})).items.filter(x=>x.id!==item.id).slice(0,4);
const favorite=JSON.stringify({id:item.id,title:item.title,slug:item.slug,thumbnail:item.thumbnail,revision:item.version});
const fileSize=(n:number|undefined)=>n? n>=1000000?`${(n/1000000).toFixed(2)} MB`:`${Math.ceil(n/1000)} KB`:'';
---
<Layout title={`${item.title} coloring page — JotColoring`} description={item.description}><ImageLicense item={item} assets={[item.preview,item.lineArtUrl]}/><Header active={item.category}/>
<main id="main" class="detail-main iv-detail hv-container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><Icon name="chevron" size={12}/><a href={`/coloring-pages/${item.category}/`}>{item.categoryName}</a><Icon name="chevron" size={12}/><span aria-current="page">{item.title}</span></nav><div class="detail-grid">
<section class="detail-art" aria-label="Coloring page preview"><div class="iv-paper-label"><span><Icon name="file" size={15}/>YOUR CREATIVITY STARTS HERE</span><span>JotColoring™</span></div><div class="detail-viewport"><img id="detail-image" src={item.preview} alt={item.alt} width={item.width} height={item.height} fetchpriority="high"/></div><div class="detail-caption"><span>Uncolored preview</span><div><button id="zoom-out" aria-label="Zoom out">−</button><output id="zoom-label">100%</output><button id="zoom-in" aria-label="Zoom in">+</button></div></div><p class="iv-art-note"><Icon name="check" size={14}/>The original line art stays clean when you color in Studio.</p></section>
<section class="detail-copy"><p class="hv-kicker"><CategoryIcon name={item.category} size={19}/>{item.categoryName.toUpperCase()} COLORING PAGE</p><h1>{item.title}</h1><p class="detail-description">{item.description}</p><div class="iv-detail-facts"><a href={`/coloring-pages/${item.category}/`}><CategoryIcon name={item.category} size={23}/><span>From the collection<strong>{item.categoryName}</strong></span><Icon name="arrow" size={14}/></a><div><Icon name="photo" size={21}/><span>High-resolution line art<strong>{item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')} px</strong></span></div></div>
<a class="button primary wide studio-cta" href={`/studio/?page=${item.id}`}><Icon name="brush" size={23}/><span>Color it your way in Studio</span><Icon name="arrow" size={21}/></a>
<div class="download-block"><div class="iv-small-heading"><h2>Print it. Keep it. Color it.</h2><span>Uncolored originals</span></div><div class="iv-download-list"><a class="iv-download" href={item.downloads.pdf}><span class="iv-file-symbol"><Icon name="file" size={25}/></span><span><strong>Download PDF</strong><small>A4 page · ready to print</small></span><b>{fileSize(item.downloadMetadata?.pdfBytes)}</b><Icon name="download" size={21}/></a><a class="iv-download" href={item.downloads.webp}><span class="iv-file-symbol"><Icon name="photo" size={25}/></span><span><strong>Download WEBP</strong><small>High-resolution black-and-white image</small></span><b>{fileSize(item.downloadMetadata?.webpBytes)}</b><Icon name="download" size={21}/></a></div>{item.downloads.letter&&<p class="iv-letter-link">Printing on US Letter? <a href={item.downloads.letter}>Get the Letter PDF <Icon name="arrow" size={13}/></a></p>}<button class="favorite" data-favorite={favorite} aria-pressed="false"><span>♡</span><b>Save to favorites</b></button><p class="iv-license-note">Free for personal and non-commercial educational use. <a href="/license/">Read the license</a> or <a href={`/licensing/?image=${item.slug}`}>ask about commercial use</a>.</p></div>
<a class="iv-detail-ai" href="/create/text/"><Icon name="spark" size={24}/><span><strong>Something wonderfully different in mind?</strong><small>Turn your own idea into a coloring page.</small></span><Icon name="arrow" size={19}/></a></section></div>
<section class="iv-detail-related"><div class="hv-section-heading"><div><p class="hv-kicker">KEEP THE CREATIVITY GOING</p><h2>{related.length?`More ${item.categoryName.toLowerCase()} to make your own.`:'Your next little adventure.'}</h2><p class="hv-section-description">Another page, another possibility. Find something that catches your imagination.</p></div><a class="hv-text-link" href={`/coloring-pages/${item.category}/`}>Explore the collection <Icon name="arrow" size={18}/></a></div><div class="catalog-grid">{alternatives.map(i=><Card item={i} showCategory/>)}</div></section></main>
<script>import {toggleFavorite,isFavorite} from '../../studio/storage';import {toast} from '../../ui/common';let zoom=1;const img=document.querySelector<HTMLImageElement>('#detail-image')!;const update=()=>{img.style.width=`${zoom*100}%`;img.style.maxWidth='none';img.style.height='auto';document.querySelector('#zoom-label')!.textContent=`${Math.round(zoom*100)}%`;};document.querySelector('#zoom-in')?.addEventListener('click',()=>{zoom=Math.min(3,zoom+.25);update()});document.querySelector('#zoom-out')?.addEventListener('click',()=>{zoom=Math.max(.5,zoom-.25);update()});const btn=document.querySelector<HTMLButtonElement>('[data-favorite]')!;const data=JSON.parse(btn.dataset.favorite!);const show=(yes:boolean)=>{btn.setAttribute('aria-pressed',String(yes));btn.querySelector('b')!.textContent=yes?'Saved to favorites':'Save to favorites';btn.querySelector('span')!.textContent=yes?'♥':'♡';};isFavorite(data.id).then(show).catch(()=>{});btn.addEventListener('click',async()=>{btn.disabled=true;try{const yes=await toggleFavorite(data);show(yes);toast(yes?'Saved to favorites on this device.':'Removed from favorites.')}catch(e){toast((e as Error).message)}finally{btn.disabled=false}});</script>
</Layout>
