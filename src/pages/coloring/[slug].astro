---
import {env} from 'cloudflare:workers';import ImageLicense from '../../components/ImageLicense.astro';import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Card from '../../components/Card.astro';import {createCatalog} from '../../server/catalog';import type {Env} from '../../server/types';
const repo=createCatalog(env as unknown as Env);const item=await repo.get(Astro.params.slug!);if(!item){const redirect=await repo.redirect(Astro.params.slug!);return Astro.redirect(redirect?`/coloring/${redirect}/`:'/404/',redirect?301:302)}
const related=(await repo.list({category:item.category,limit:8})).items.filter(x=>x.id!==item.id).slice(0,3);const favorite=JSON.stringify({id:item.id,title:item.title,slug:item.slug,thumbnail:item.thumbnail,revision:item.version});

---
<Layout title={`${item.title} coloring page — JotColoring`} description={item.description}><ImageLicense item={item} assets={[item.preview,item.lineArtUrl]}/><Header/><main id="main" class="detail-main"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href={`/coloring-pages/${item.category}/`}>{item.categoryName}</a><span>/</span><a href={`/coloring/${item.slug}/`}>{item.title}</a></div><div class="detail-grid"><section class="detail-art" aria-label="Coloring page preview"><div class="detail-viewport"><img id="detail-image" src={item.preview} alt={item.alt} width={item.width} height={item.height} fetchpriority="high"/></div><div class="detail-caption"><span>Printable coloring page</span><div><button id="zoom-out" aria-label="Zoom out">−</button><output id="zoom-label">100%</output><button id="zoom-in" aria-label="Zoom in">+</button></div></div></section><section class="detail-copy"><p class="eyebrow">{item.categoryName} coloring page</p><h1>{item.title}</h1><p class="detail-description">{item.description}</p><div class="badges">{[item.categoryName,...item.tags.slice(0,1),item.difficulty].filter(Boolean).map(t=><span class="badge">{t}</span>)}</div><a class="button primary wide studio-cta" href={`/studio/?page=${item.id}`}><span>🖌</span>Color in Studio →</a><div class="download-block"><h2>Download the coloring page</h2><div class="download-buttons"><a class="button" href={item.downloads.pdf}>♧ PDF</a><a class="button" href={item.downloads.webp}>▧ WEBP</a></div><p class="download-note">Downloads include the uncolored page. PDF under 1 MB. <a href="/license/">Personal &amp; educational use</a> · <a href={`/licensing/?image=${item.slug}`}>Commercial license</a></p><button class="favorite" data-favorite={favorite} aria-pressed="false"><span>♡</span><b>Save to favorites</b></button></div><div class="promo detail-promo"><span class="promo-icon">💡</span><div><h2>Have something else in mind?</h2><p>Turn your ideas into a unique coloring page with AI.</p></div><a class="button primary" href="/create/text/">Create with AI →</a></div><section class="related-section"><div class="section-heading"><h2>More {item.subcategory||item.category} pages</h2><a href={`/coloring-pages/${item.category}/`}>See all pages →</a></div><div class="related-grid">{related.map(i=><Card item={i}/>)}</div></section></section></div></main><script>import {toggleFavorite,isFavorite} from '../../studio/storage';import {toast} from '../../ui/common';let zoom=1;const img=document.querySelector<HTMLImageElement>('#detail-image')!;const update=()=>{img.style.width=`${zoom*100}%`;img.style.maxWidth='none';img.style.height='auto';document.querySelector('#zoom-label')!.textContent=`${Math.round(zoom*100)}%`;};document.querySelector('#zoom-in')?.addEventListener('click',()=>{zoom=Math.min(3,zoom+.25);update()});document.querySelector('#zoom-out')?.addEventListener('click',()=>{zoom=Math.max(.5,zoom-.25);update()});const btn=document.querySelector<HTMLButtonElement>('[data-favorite]')!;const data=JSON.parse(btn.dataset.favorite!);const show=(yes:boolean)=>{btn.setAttribute('aria-pressed',String(yes));btn.querySelector('b')!.textContent=yes?'Saved to favorites':'Save to favorites';btn.querySelector('span')!.textContent=yes?'♥':'♡';};isFavorite(data.id).then(show).catch(()=>{});btn.addEventListener('click',async()=>{btn.disabled=true;try{const yes=await toggleFavorite(data);show(yes);toast(yes?'Saved to favorites on this device.':'Removed from favorites.')}catch(e){toast((e as Error).message)}finally{btn.disabled=false}});</script></Layout>
