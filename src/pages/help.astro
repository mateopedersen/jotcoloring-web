---
import ArrowIcon from '../components/ArrowIcon.astro';
import SupportShell from '../components/SupportShell.astro';
import FooterIcon from '../components/FooterIcon.astro';
import FAQList from '../components/FAQList.astro';
import {FAQ_TOPICS} from '../content/faq';
const hints=['Find a page and choose the right file.','Paper sizes, sharp outlines and print settings.','Fill regions, add layers and make it yours.','Organize, back up and return to your work.','Photo conversion, availability and results.','Free use, business permission and your data.'];
---
<SupportShell title="A little help goes a long way" description="Find your next step, solve a small snag, or understand a feature before you try it. Your creative time is worth keeping simple." kind="help" eyebrow="YOUR CREATIVE SUPPORT SPACE"><div slot="hero" class="support-actions"><a class="support-button" href="#help-answers">Find an answer<ArrowIcon kind="right" size={18}/></a><a class="support-button secondary" href="/contact/">Contact us<ArrowIcon kind="right" size={18}/></a></div><div class="support-note"><strong>Prefer to follow the real screens?</strong><p>Our illustrated walkthrough covers searching, downloads, Studio, saved projects and boards.</p><a href="/how-to-use/">How to use JotColoring<ArrowIcon size={18}/></a></div><div class="support-link-grid">{FAQ_TOPICS.map(([id,title,icon],i)=><a href={`#${id}`}><FooterIcon name={icon}/><span>{title}<small>{hints[i]}</small></span><b aria-hidden="true"><ArrowIcon kind="diagonal" size={18}/></b></a>)}</div><div id="help-answers" class="support-section-heading"><p class="support-kicker">START WITH A QUESTION</p><h2>What would you like to do?</h2><p>Search the answers below or choose a topic. You can expand a question without leaving this page.</p></div><FAQList/><div class="support-note"><strong>Reporting a problem?</strong><p>Include the page link, what you clicked, the message you saw and your browser. Keep private photos, passwords and personal information out of your report.</p><a href="/contact/">Contact details</a></div></SupportShell>
