---
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LostColoringArt from '../components/LostColoringArt.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import SearchForm from '../components/SearchForm.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ActionIcon from '../components/ActionIcon.astro';
import Card from '../components/Card.astro';
import {createCatalog} from '../server/catalog';
import type {Content,Env} from '../server/types';
import '../styles/not-found.css';
Astro.response.status=404;
let suggestions:Content[]=[];try{suggestions=(await createCatalog(env as unknown as Env).list({limit:4})).items;}catch{}
---
<Layout title="This page wandered outside the lines — JotColoring" description="Find a fresh coloring page, add color to a little fox, or explore JotColoring’s collections and Coloring Studio." noindex><Header/><main id="main" class="jc-lost-page" data-lost-page><section class="jc-lost-hero"><div class="jc-lost-copy"><p class="jc-lost-label">404 · PAGE NOT FOUND</p><h1>Let’s get back<br/><span>inside the lines.</span></h1><p>We couldn’t find that page. Browse the collection or search for something you’d like to color.</p><div class="jc-lost-actions"><a href="/coloring-pages/">Find a coloring page<ArrowIcon kind="right" size={18}/></a><a href="/">Back to Home<ArrowIcon kind="up" size={16}/></a></div><SearchForm idPrefix="not-found"/></div><div class="jc-lost-drawing"><LostColoringArt/><div class="jc-lost-paint-tools"><button type="button" data-color-fox aria-controls="lost-coloring-art"><ActionIcon name="brush" size={28}/><span>Color this little fox</span></button><button type="button" data-reset-fox hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10a8 8 0 1 1 0 5m0-5V4m0 6h6"/></svg>Reset colors</button></div><p role="status" aria-live="polite" data-fox-status>A little coloring break while you choose your next page.</p></div></section><nav class="jc-lost-collections" aria-label="Places to explore">{[['Animals','A little wild inspiration','/coloring-pages/animals/','animals'],['Flowers','Petals & possibilities','/coloring-pages/flowers/','flowers'],['Coloring Studio','Make it your own online','/studio/','all'],['Browse by age','Find your level of detail','/coloring-by-age/','woodland']].map(([title,description,href,icon])=><a href={href}><CategoryIcon name={icon} size={47}/><span><strong>{title}</strong><small>{description}</small></span><ArrowIcon kind="right" size={16}/></a>)}</nav>{suggestions.length>0&&<section class="jc-lost-gallery"><div class="hv-section-heading"><div><p class="hv-kicker">YOUR NEXT PAGE IS RIGHT HERE</p><h2>Give one of these a little color.</h2></div><a class="hv-text-link" href="/coloring-pages/">Explore all<ArrowIcon kind="right" size={18}/></a></div><div class="catalog-grid">{suggestions.map(item=><Card item={item} showCategory/>)}</div></section>}<aside class="jc-lost-help"><p><strong>Need a hand finding something?</strong>Search a subject above, or visit our help center for printing and coloring tips.</p><a href="/help/">Visit the help center<ArrowIcon kind="right" size={18}/></a></aside></main><script>import '../ui/not-found';</script></Layout>
