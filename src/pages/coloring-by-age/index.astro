---
import {env} from 'cloudflare:workers';
import '../../styles/catalog-listing.css';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AgeNavigation from '../../components/AgeNavigation.astro';
import AgeIcon from '../../components/AgeIcon.astro';
import {AGE_DIRECTORY_INTRO} from '../../age/browse-copy';
import BrowseIntroduction from '../../components/BrowseIntroduction.astro';
import Card from '../../components/Card.astro';
import {GALLERY_IMAGE_SIZES,FIRST_ROW_IMAGES} from '../../ui/artwork-loading';
import {createCatalog} from '../../server/catalog';
import type {Env} from '../../server/types';
const pages=await createCatalog(env as unknown as Env).list({limit:8});
---
<Layout title="Coloring pages by age — JotColoring" description="Explore coloring pages by recommended age, from broad coloring spaces to intricate patterns for adults."><Fragment slot="head">{pages.items[0]&&<link rel="preload" as="image" href={pages.items[0].thumbnail} imagesrcset={pages.items[0].thumbnailSrcset} imagesizes={GALLERY_IMAGE_SIZES} fetchpriority="high"/>}</Fragment><Header/><main id="main" class="jc-age-page jc-catalog-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Coloring by age</span></nav><section class="jc-age-hero jc-age-hero--descriptive"><div class="jc-age-hero-title"><AgeIcon band="6-8" size={112}/><div><p class="hv-kicker">YOUR PACE. YOUR COLORS.</p><h1>Coloring pages by age</h1></div></div><BrowseIntroduction paragraphs={AGE_DIRECTORY_INTRO}/></section><div class="hv-section-heading"><div><p class="hv-kicker">A LITTLE INSPIRATION</p><h2>See what catches your eye.</h2></div></div><div class="catalog-grid jc-catalog-grid">{pages.items.map((item,index)=><Card item={item} showCategory eager={index<FIRST_ROW_IMAGES} priority={index===0}/>)}</div><AgeNavigation/><p class="jc-age-page-note">Recommendations describe drawing detail and the size of the coloring spaces. They are a starting point: interests, experience and the help available can make a difference.</p></main></Layout>
