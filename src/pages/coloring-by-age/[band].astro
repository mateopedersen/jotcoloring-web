---
import {env} from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AgeNavigation from '../../components/AgeNavigation.astro';
import AgeIcon from '../../components/AgeIcon.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import SearchForm from '../../components/SearchForm.astro';
import Card from '../../components/Card.astro';
import {ageBand} from '../../age/model';
import {createCatalog,parseCatalogQuery} from '../../server/catalog';
import type {Env} from '../../server/types';
const band=ageBand(Astro.params.band);if(!band)return Astro.rewrite('/404/');
const params=new URLSearchParams(Astro.url.search);params.set('recommended_age',band.id);params.set('limit','12');
const query=parseCatalogQuery(params),result=await createCatalog(env as unknown as Env).list(query);
const pageHref=(page:number)=>{const p=new URLSearchParams(Astro.url.search);p.delete('cursor');p.set('page',String(page));return Astro.url.pathname+'?'+p+'#age-results';};
const filtered=[...Astro.url.searchParams.keys()].some(key=>key!=='page');
const canonical=Astro.url.pathname+(!filtered&&result.page>1?`?page=${result.page}`:'');
const title=band.id==='adults'?'Coloring pages for adults':`Coloring pages for ages ${band.short}`;
---
<Layout title={`${title}${result.page>1?` — Page ${result.page}`:''} — JotColoring`} description={`${band.title} ${band.description}`} canonical={canonical} noindex={filtered}><Header/><main id="main" class="jc-age-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coloring-by-age/">Coloring by age</a><span aria-hidden="true">/</span><span aria-current="page">{band.label}</span></nav><section class="jc-age-hero"><AgeIcon band={band.id} size={112}/><div><p class="hv-kicker">{band.label.toUpperCase()} · RECOMMENDED DETAIL LEVEL</p><h1>{title}</h1><p>{band.description} Find an uncolored page to print, or make it your own in Coloring Studio.</p></div></section><AgeNavigation compact active={band.id}/><SearchForm variant="hero" idPrefix="age-collection" value={query.q} action={Astro.url.pathname} recommendedAge={band.id}/><div class="jc-age-filterbar"><strong id="age-results">{result.total} {result.total===1?'coloring page':'coloring pages'} · {band.label}</strong><form method="get" action={Astro.url.pathname}>{query.q&&<input type="hidden" name="q" value={query.q}/>}<label class="sr-only" for="age-collection-sort">Sort coloring pages</label><select id="age-collection-sort" name="sort"><option value="trending" selected={query.sort==='trending'}>Featured first</option><option value="newest" selected={query.sort==='newest'}>Newest first</option><option value="title" selected={query.sort==='title'}>A–Z</option></select><button type="submit">Apply<ArrowIcon kind="right" size={16}/></button></form></div>{result.items.length?<div class="catalog-grid">{result.items.map(item=><Card item={item} showCategory/>)}</div>:<section class="jc-age-empty"><AgeIcon band={band.id} size={80}/><h2>{query.q?'No matching pages in this age collection.':'More pages for this stage are on the way.'}</h2><p>{query.q?'Try a different search, or explore all the coloring pages.':'This collection will fill as matching coloring pages are added. Explore the complete collection in the meantime.'}</p><a href="/coloring-pages/">Explore all coloring pages<ArrowIcon kind="right" size={18}/></a></section>}{result.total_pages>1&&<nav class="jc-age-pagination" aria-label="Page navigation">{result.page>1&&<a href={pageHref(result.page-1)}><ArrowIcon kind="left" size={16}/>Previous</a>}<span>Page {result.page} of {result.total_pages}</span>{result.page<result.total_pages&&<a href={pageHref(result.page+1)}>Next<ArrowIcon kind="right" size={16}/></a>}</nav>}<p class="jc-age-page-note">Recommended ages reflect the drawing’s detail and coloring spaces. Choose what feels comfortable for the person coloring.</p></main></Layout>
