---
import {env} from 'cloudflare:workers';
import '../../styles/catalog-listing.css';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AgeNavigation from '../../components/AgeNavigation.astro';
import AgeIcon from '../../components/AgeIcon.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import Card from '../../components/Card.astro';
import {GALLERY_IMAGE_SIZES,FIRST_ROW_IMAGES} from '../../ui/artwork-loading';
import CatalogStream from '../../components/CatalogStream.astro';
import CatalogFilters from '../../components/CatalogFilters.astro';
import SearchCollections from '../../components/SearchCollections.astro';
import {ageBand} from '../../age/model';
import {selectFilterURL} from '../../ui/filter-url';
import {createCatalog,parseCatalogQuery} from '../../server/catalog';
import type {Env} from '../../server/types';
const band=ageBand(Astro.params.band);if(!band)return Astro.rewrite('/404/');
const chosenBand=Astro.url.searchParams.get('recommended_age');if(chosenBand!==null&&chosenBand!==band.id){const next=selectFilterURL(Astro.url.href,'recommended_age',[chosenBand]);return Astro.redirect(next.pathname+next.search+next.hash,302);}
const params=new URLSearchParams(Astro.url.search);params.set('recommended_age',band.id);params.set('limit','12');
const query=parseCatalogQuery(params),repo=createCatalog(env as unknown as Env);
const categoryCountsPromise=repo.categories().catch(()=>[]);
let catalogError=false;
const result=await repo.list(query).catch(()=>{catalogError=true;Astro.response.status=503;return{items:[],total:0,page:1,page_size:12,total_pages:0,next_cursor:null,has_more:false};});
const categoryCounts=await categoryCountsPromise;
const filtered=[...Astro.url.searchParams.keys()].some(key=>key!=='page');
const canonical=Astro.url.pathname+(!filtered&&result.page>1?`?page=${result.page}`:'');
const title=band.id==='adults'?'Coloring pages for adults':`Coloring pages for ages ${band.short}`;
---
<Layout title={`${title}${result.page>1?` — Page ${result.page}`:''} — JotColoring`} description={`${band.title} ${band.description}`} canonical={canonical} noindex={filtered}><Fragment slot="head">{result.items[0]&&<link rel="preload" as="image" href={result.items[0].thumbnail} imagesrcset={result.items[0].thumbnailSrcset} imagesizes={GALLERY_IMAGE_SIZES} fetchpriority="high"/>}</Fragment><Header/><main id="main" class="jc-age-page jc-catalog-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coloring-by-age/">Coloring by age</a><span aria-hidden="true">/</span><span aria-current="page">{band.label}</span></nav><section class="jc-age-hero"><AgeIcon band={band.id} size={112}/><div><h1>{title}</h1></div></section>{query.q&&<SearchCollections query={query.q} counts={categoryCounts} recommendedAge={band.id}/>}<CatalogFilters total={result.total} unavailable={catalogError} query={query} category={query.subcategory||query.category||''} currentURL={Astro.url.href} ageCollection counts={categoryCounts}/>{result.items.length?<div class="catalog-grid jc-catalog-grid">{result.items.map((item,index)=><Card item={item} showCategory filterURL={Astro.url.href} eager={index<FIRST_ROW_IMAGES} priority={index===0}/>)}</div>:<section class="jc-age-empty"><AgeIcon band={band.id} size={80}/><h2>{catalogError?'These pages could not be loaded.':filtered?'No pages match these choices.':'More pages for this stage are on the way.'}</h2><p>{catalogError?'Please try again. Your search and filter choices are kept above.':filtered?'Try another topic, a shorter search, or fewer filters. The selected age stays applied.':'This collection will fill as matching coloring pages are added. Explore the complete collection in the meantime.'}</p>{filtered&&<a href={Astro.url.pathname+'#age-results'}>Reset This Selection<ArrowIcon kind="right" size={18}/></a>}<a href="/coloring-pages/all/">Explore all coloring pages<ArrowIcon kind="right" size={18}/></a></section>}<CatalogStream result={result} source={Astro.url.pathname}/><AgeNavigation compact active={band.id} currentURL={Astro.url.href}/><p class="jc-age-page-note">Recommended ages reflect the drawing’s detail and coloring spaces. Choose what feels comfortable for the person coloring.</p></main><script>import '../../ui/catalog';import {mountCatalogStream} from '../../ui/catalog-stream';mountCatalogStream();</script></Layout>
