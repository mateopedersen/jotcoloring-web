---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VectorIcon from '../components/VectorIcon.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import {CONTACT_TOPICS,CONTACT_FORM_URL} from '../contact/config';
import '../contact/contact.css';
---
<Layout title="Contact JotColoring — Questions, Feedback & Support" description="Contact JotColoring about coloring pages, Studio, photo conversion, licenses, or accessibility. Choose a topic and send your message with our contact form."><Header/>
<main id="main" class="contact-page" data-contact>
 <nav class="contact-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ArrowIcon size={16}/><span aria-current="page">Contact Us</span></nav>
 <header class="contact-hero">
  <div class="contact-heading"><span class="contact-eyebrow">A LITTLE HELP GOES A LONG WAY</span><h1>Let’s Make<br/><em>Something Clear.</em></h1><p>A question, a creative idea, or a little help finding your way. You’re in the right place.</p><a href="#message" class="contact-jump">Send Us a Message <ArrowIcon size={20}/></a></div>
  <div class="contact-illustration" aria-hidden="true"><span class="contact-orbit orbit-one"></span><span class="contact-orbit orbit-two"></span><div class="contact-main-icon"><VectorIcon name="nav-contact" size={190}/></div><div class="contact-float float-one"><VectorIcon name="nav-studio" size={66}/></div><div class="contact-float float-two"><VectorIcon name="nav-help" size={66}/></div><span class="contact-hello">Hello, JotColoring!</span></div>
 </header>
 <section class="contact-layout" id="message" aria-labelledby="contact-form-heading">
  <aside class="contact-topics"><span class="contact-eyebrow">LET’S START HERE</span><h2>What’s on Your Mind?</h2><p>Pick the topic that fits. We’ll add it to your form.</p><div class="contact-topic-list">{CONTACT_TOPICS.map(t=><button type="button" data-contact-topic={t.id} aria-pressed="false"><VectorIcon name={t.icon} size={42}/><span><strong>{t.title}</strong><small>{t.hint}</small></span><span class="contact-topic-dot" aria-hidden="true"></span></button>)}</div>
   <div class="contact-help-note"><VectorIcon name="nav-help" size={40}/><div><h3>Need a Quick Answer?</h3><p>Our guides cover printing, saving, and coloring online.</p><a href="/help/">Visit the Help Center <ArrowIcon size={17}/></a></div></div>
  </aside>
  <section class="contact-form-card"><div class="contact-form-heading"><span class="contact-step">01 / SAY HELLO</span><h2 id="contact-form-heading">Your Message Starts Here.</h2><p>Tell us what you’re working on and how we can help. Include a page link if it’s about a specific design.</p></div>
   <div class="contact-form-intro" data-contact-intro><div class="contact-paper"><VectorIcon name="nav-contact" size={100}/><span>From your creative corner<br/>to ours.</span></div><button type="button" class="contact-start" data-contact-start>Open the Contact Form <ArrowIcon size={23}/></button><div class="contact-form-facts"><span><b>One Form</b>For every question</span><span><b>No Account Needed</b>Just a reply email</span></div><p class="contact-privacy">The form is provided by Google Forms. When you open it, Google receives your connection details. When you submit it, your email and message are shared with JotColoring. <a href="/privacy/#contact">How We Use Your Information</a></p></div>
   <p class="contact-status" data-contact-status role="status" aria-live="polite"></p><iframe data-contact-frame hidden title="Send a message to JotColoring" referrerpolicy="strict-origin-when-cross-origin"></iframe>
   <div class="contact-form-footer"><span>Please leave out passwords, payment details, and private photos.</span><a data-contact-external href={CONTACT_FORM_URL} target="_blank" rel="noopener noreferrer">Open Form in a New Tab <ArrowIcon kind="diagonal" size={18}/></a></div>
  </section>
 </section>
 <section class="contact-next" aria-label="Helpful links"><a href="/how-to-use/"><VectorIcon name="nav-about" size={48}/><span><strong>A Little Guidance</strong><small>Take the JotColoring tour</small></span><ArrowIcon size={20}/></a><a href="/license/"><VectorIcon name="nav-license" size={48}/><span><strong>Before You Create</strong><small>Explore the artwork license</small></span><ArrowIcon size={20}/></a><a href="/coloring-pages/"><VectorIcon name="all" size={48}/><span><strong>Back to the Good Stuff</strong><small>Find your next coloring page</small></span><ArrowIcon size={20}/></a></section>
</main></Layout>
<script>import {mountContact} from '../contact/controller';mountContact();</script>
