---
import ArrowIcon from '../components/ArrowIcon.astro';
import ActionIcon from './ActionIcon.astro';
import {COLOR_PALETTES} from '../ui/color-ideas-model';
import type {Content} from '../server/types';
const {item}=Astro.props as {item:Content};
---
<section id="color-ideas" class="jc-color-ideas" data-color-ideas data-source={item.preview} data-reference={item.color_reference||item.home_color||undefined} data-width={item.width} data-height={item.height} data-title={item.title} data-slug={item.slug}>
 <button class="jc-color-ideas-open" type="button" data-ideas-toggle disabled aria-expanded="false" aria-controls="color-ideas-panel"><ActionIcon name="brush" size={49}/><span><strong>See Color Ideas</strong><small>Wondering how this page could look in color?</small></span><b aria-hidden="true"><ArrowIcon kind="diagonal" size={18}/></b></button>
 <div id="color-ideas-panel" data-ideas-panel hidden><div class="jc-ideas-heading"><span>A LITTLE INSPIRATION</span><h2>Your page, a fresh palette.</h2><p>Explore a suggested palette for this drawing, then try a different mood. Compare the color idea with the uncolored drawing. Choose your favorite colors or try your own in Studio.</p></div><div class="jc-ideas-palettes" role="group" aria-label="Choose a color inspiration palette">{COLOR_PALETTES.map((p,i)=><button type="button" data-ideas-palette={p.id} aria-pressed={i===0}><span aria-hidden="true" data-ideas-swatches><i/><i/><i/><i/><i/></span><strong>{p.name}</strong></button>)}</div><p class="jc-ideas-description" data-ideas-description>{COLOR_PALETTES[0].description}</p><div class="jc-ideas-comparison" data-ideas-visual style="--idea-split:60%" hidden><img src={item.preview} alt={item.alt||item.description} loading="lazy" width={item.width} height={item.height}/><canvas data-ideas-canvas role="img" aria-label={`Color palette inspiration for ${item.title}`}></canvas><span class="jc-ideas-divider" aria-hidden="true"><b>‹ ›</b></span><input data-ideas-slider type="range" min="0" max="100" value="60" aria-label="Compare this color idea with the original outline"/><span class="jc-ideas-label">Color idea</span><span class="jc-ideas-label line-label">Original outline</span></div><p data-ideas-status role="status" aria-live="polite"></p><div class="jc-ideas-actions"><button type="button" data-ideas-copy disabled>Copy palette</button><button type="button" data-ideas-download disabled>Download color idea</button><a href={`/studio/?page=${encodeURIComponent(item.id)}`}>Make your own in Studio <span aria-hidden="true"><ArrowIcon kind="diagonal" size={18}/></span></a></div><p class="jc-ideas-note">Suggested colors for inspiration. Color moods run on your device without an AI request. The public PDF and Image files stay uncolored.</p></div>
</section>
<script>import {mountColorIdeas} from '../ui/color-ideas';mountColorIdeas();</script>
