---
import ArrowIcon from '../components/ArrowIcon.astro';
import {FAQ_TOPICS,FAQS} from '../content/faq';
import SearchIcon from './SearchIcon.astro';
---
<section data-faq class="support-faq"><div class="support-faq-tools"><label class="support-faq-search"><SearchIcon size={28}/><span class="sr-only">Search help questions</span><input type="search" placeholder="What would you like help with?" maxlength="160" data-faq-search/><button type="button" data-faq-clear hidden>Clear</button></label><div class="support-faq-categories" role="group" aria-label="Filter help topics"><button type="button" data-faq-topic="all" aria-pressed="true">All questions</button>{FAQ_TOPICS.map(([id,title])=><button type="button" data-faq-topic={id} aria-pressed="false">{title}</button>)}</div></div><div class="support-faq-meta"><p data-faq-count role="status" aria-live="polite">{FAQS.length} answers to explore</p><div class="support-faq-expand"><button type="button" data-faq-expand>Expand answers</button><button type="button" data-faq-collapse>Collapse answers</button></div></div>{FAQ_TOPICS.map(([topic,title])=><section class="support-faq-group" data-faq-group={topic} id={topic}><h2>{title}</h2>{FAQS.filter(q=>q.topic===topic).map(q=><details data-faq-id={q.id}><summary>{q.question}</summary><div class="support-faq-answer"><p>{q.answer}</p>{q.href&&<p><a href={q.href}>{q.link} <ArrowIcon kind="diagonal" size={18}/></a></p>}</div></details>)}</section>)}<p class="support-faq-empty" data-faq-empty hidden>No matching answers. Try a shorter phrase, choose another topic, or <a href="/contact/">contact us</a>.</p></section>
<script>import {mountFAQ} from '../ui/faq';mountFAQ();</script>
