---
import type {Content} from '../server/types';
import CategoryIcon from './CategoryIcon.astro';
import ActionIcon from './ActionIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
const {items=[]}=Astro.props as {items:Content[]};
const art=[...new Map(items.map(item=>[item.category,item])).values()].slice(0,3);
const themes=[{id:'animals',name:'Animals'},{id:'flowers',name:'Flowers'},{id:'ocean',name:'Ocean'}];
---
<section class="gallery-explore" aria-labelledby="gallery-explore-title">
 <div class="gallery-explore-art" aria-hidden="true"><span class="explore-art-halo"></span>{art.map((item,i)=><span class={`explore-paper explore-paper-${i}`}><img src={item.thumbnail} alt="" width="140" height="210" loading="lazy"/></span>)}<span class="explore-art-stamp"><ActionIcon name="brush" size={50}/></span><span class="explore-art-star">✦</span></div>
 <div class="gallery-explore-copy"><p class="explore-eyebrow">A NEW PAGE. A NEW POSSIBILITY.</p><h2 id="gallery-explore-title">Keep Exploring</h2><p>Another favorite is just a page away. Find a new theme and make it yours.</p><a class="gallery-explore-button" href="/coloring-pages/"><span class="explore-button-icon" aria-hidden="true"><CategoryIcon name="all" size={34}/></span><span>Explore All Coloring Pages</span><span class="explore-button-arrow" aria-hidden="true"><ArrowIcon size={22}/></span></a><nav class="gallery-explore-themes" aria-label="More coloring collections">{themes.map(theme=><a href={`/coloring-pages/${theme.id}/`}><CategoryIcon name={theme.id} size={27}/><span>{theme.name}</span><ArrowIcon size={15}/></a>)}</nav></div>
</section>
<style>
.gallery-explore{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center;gap:26px;margin-top:32px;padding:32px 29px;border:1px solid #edceb2;border-radius:24px;background:radial-gradient(ellipse at 10% 90%,#ffdeb380,transparent 60%),linear-gradient(125deg,#fffaf2,#fff5e9);box-shadow:inset 0 1px #fff,0 5px 0 #efe2d5;overflow:hidden}
.gallery-explore-art{position:relative;min-width:0;height:290px;display:grid;place-items:center;pointer-events:none}
.explore-art-halo{position:absolute;width:240px;height:240px;max-width:100%;border:1px solid #edc4a16b;border-radius:50%;background:radial-gradient(circle,#f6d7b7,#f9e7d1aa 65%,transparent 66%)}
.explore-paper{position:absolute;width:45%;max-width:154px;height:215px;padding:8px;background:#fff;border:1px solid #ead9c8;border-radius:10px;box-shadow:0 11px 22px #79513816;transform-origin:50% 95%;overflow:hidden}
.explore-paper img{display:block;width:100%;height:100%;object-fit:contain;border-radius:5px}
.explore-paper-0{transform:translate(-49px,8px) rotate(-14deg)}.explore-paper-1{transform:translate(49px,8px) rotate(14deg)}.explore-paper-2{transform:translateY(-4px) rotate(-2deg)}
.explore-art-stamp{position:absolute;bottom:14px;right:15%;display:grid;place-items:center;width:65px;height:65px;border:1px solid #edc7a5;border-radius:17px;background:linear-gradient(140deg,#fff,#fff1df);box-shadow:0 5px 0 #e4bb98;transform:rotate(9deg)}.explore-art-star{position:absolute;right:13%;top:9px;color:#e99743;font-size:31px;line-height:1}
.gallery-explore-copy{min-width:0;position:relative}.gallery-explore-copy .explore-eyebrow{font-size:var(--type-note-size);letter-spacing:1.2px;font-weight:850;color:#a35c32;line-height:1.5;margin:0 0 8px}.gallery-explore h2{font-size:clamp(30px,3vw,42px);font-weight:900;line-height:1.12;letter-spacing:-1.3px;margin:0 0 12px;color:var(--text-ink, #000)}.gallery-explore-copy>p:not(.explore-eyebrow){font-size:14px;line-height:1.75;font-weight:600;color:var(--text-ink, #000);margin:0 0 19px;max-width:380px}
.gallery-explore-button{display:inline-flex;align-items:center;gap:10px;max-width:100%;min-height:63px;padding:9px 12px 9px 9px;border:1px solid #b94d20;border-radius:15px;background:linear-gradient(125deg,#c65220,#af411b);box-shadow:inset 0 1px #ffffff45,0 4px 0 #943b1c,0 8px 16px #b4532520;text-decoration:none;color:#fff;font-size:14px;font-weight:850;line-height:1.4;transition:transform .18s,box-shadow .18s,background .18s}.gallery-explore-button:hover{color:#fff!important;background:linear-gradient(125deg,#b7491d,#993916);transform:translateY(-2px);box-shadow:inset 0 1px #ffffff45,0 6px 0 #943b1c,0 10px 19px #b4532520}.explore-button-icon{display:grid;place-items:center;flex:none;width:40px;height:40px;border-radius:10px;background:#fff5e5;box-shadow:0 2px 0 #873a1f55}.gallery-explore-button>span:nth-child(2){min-width:0}.explore-button-arrow{display:grid;place-items:center;flex:none;width:32px;height:32px;border:1px solid #fff6;border-radius:10px;background:#ffffff12}
.gallery-explore-themes{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.gallery-explore-themes>a{display:inline-flex;align-items:center;gap:5px;min-height:39px;max-width:100%;padding:3px 8px 3px 4px;border:1px solid #e9d9c7;border-radius:11px;background:#ffffffb8;color:#71553d;text-decoration:none;font-size:var(--type-note-size);font-weight:800;line-height:1.3}.gallery-explore-themes>a:hover{background:#fff;border-color:#dbad87;color:#a0441e}.gallery-explore-themes>a>:global(svg:last-child){margin-left:1px;color:#a96b46}.gallery-explore a:focus-visible{outline:3px solid #277c88;outline-offset:4px}
@media(max-width:1180px){.gallery-explore{grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:16px;padding:26px 20px}.explore-paper{height:180px;width:53%}.explore-paper-0{transform:translate(-34px,8px) rotate(-14deg)}.explore-paper-1{transform:translate(34px,8px) rotate(14deg)}.gallery-explore-art{height:245px}.explore-art-stamp{right:0;bottom:8px}.gallery-explore h2{font-size:32px}.gallery-explore-button{font-size:var(--type-note-size);gap:8px}.gallery-explore-themes{gap:5px}.gallery-explore-themes>a{font-size:var(--type-note-size);padding-right:6px}}
@media(max-width:650px){.gallery-explore{grid-template-columns:minmax(0,1fr);gap:3px;padding:20px 18px 25px;text-align:center}.gallery-explore-art{height:240px;max-width:280px;width:100%;margin-inline:auto}.explore-paper{width:47%;height:200px}.explore-paper-0{transform:translate(-47px,8px) rotate(-14deg)}.explore-paper-1{transform:translate(47px,8px) rotate(14deg)}.explore-art-stamp{right:11%;bottom:9px;width:58px;height:58px}.gallery-explore h2{font-size:35px}.gallery-explore-copy>p:not(.explore-eyebrow){font-size:14px;margin-inline:auto}.gallery-explore-button{width:100%;justify-content:space-between;text-align:left;font-size:var(--type-note-size);gap:8px;min-height:64px}.gallery-explore-themes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.gallery-explore-themes>a{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;min-width:0;padding:9px 6px;font-size:var(--type-note-size);box-shadow:0 2px 0 #e7d4bf}.gallery-explore-themes>a>:global(svg:first-child){grid-column:1/-1;justify-self:center;width:33px;height:33px}.gallery-explore-themes>a>span{justify-self:center}.gallery-explore-themes>a>:global(svg:last-child){width:13px;height:13px;margin:0;justify-self:center}.explore-art-star{right:12%;top:0}}
@media(max-width:360px){.gallery-explore{padding-inline:13px}.gallery-explore h2{font-size:31px}.gallery-explore-button{font-size:var(--type-note-size);gap:6px;padding-right:9px}.explore-button-icon{width:34px;height:36px}.explore-button-arrow{width:29px;height:29px}.gallery-explore-themes>a{font-size:var(--type-note-size);gap:6px;padding:10px 5px}.gallery-explore-themes>a>:global(svg:first-child){width:27px;height:27px}}
@media(prefers-reduced-motion:reduce){.gallery-explore-button{transition:none}.gallery-explore-button:hover{transform:none}}
</style>
