---
import Icon from './HomeIcon.astro';
import {categories} from '../ui/categories';
const {variant='full',search='',active='',home=false}=Astro.props;
const path=Astro.url.pathname;
---
 <div class="hv-announcement"><span><Icon name="sun" size={14}/> A little creative time, just for you.</span><a href="/license/">Free for personal & classroom use <Icon name="arrow" size={14}/></a></div>
 <header class="hv-header"><div class="hv-header-inner"><a href="/" class="hv-brand" aria-label="JotColoring home"><img src="/logo-3d.webp" alt="JotColoring" width="254" height="48"/></a><nav class="hv-desktop-nav" aria-label="Main navigation"><a href="/coloring-pages/">Explore pages</a><a href="/coloring-pages/?age=kids">For kids</a><a href="/coloring-pages/?age=adults">For grown-ups</a></nav><div class="hv-header-actions"><a class="hv-favorites" href="/my-artwork/" aria-label="My artwork and favorites"><Icon name="heart"/><span>My artwork</span></a><a class="hv-ai" href="/create/text/"><Icon name="spark" size={18}/>AI Builder</a><a class="hv-button hv-primary hv-studio-nav" href="/studio/"><Icon name="brush" size={18}/>Open Studio</a><button class="hamburger hv-menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={24}/></button></div></div></header>
 <dialog id="mobile-menu" class="hv-mobile-menu"><div><img src="/logo-3d.webp" width="190" height="38" alt="JotColoring"/><button data-close-dialog aria-label="Close menu"><Icon name="close"/></button></div><nav aria-label="Mobile navigation"><a href="/coloring-pages/">Explore all coloring pages</a><a href="/coloring-pages/?age=kids">For kids</a><a href="/coloring-pages/?age=adults">For grown-ups</a><a href="/create/text/">AI Builder</a><a href="/studio/">Coloring Studio</a><a href="/my-artwork/">My artwork & favorites</a>{categories.map(c=><a href={`/coloring-pages/${c.id}/`}>{c.name}</a>)}</nav></dialog>

{!home&&variant!=='simple'&&<div class="iv-searchbar"><form action="/coloring-pages/" role="search"><Icon name="search" size={19}/><label class="sr-only" for="site-search">Search coloring pages</label><input id="site-search" type="search" name="q" value={search} placeholder="Find animals, flowers, a little magic…"/><button type="submit">Find a page <Icon name="arrow" size={16}/></button></form><nav aria-label="Popular categories">{categories.slice(0,6).map(c=><a href={`/coloring-pages/${c.id}/`} aria-current={active===c.id?'page':undefined}>{c.name}</a>)}</nav></div>}
<nav class="hv-mobile-bottom" aria-label="Quick navigation"><a href="/" aria-current={path==='/'?'page':undefined}><Icon name="home"/>Explore</a><a href="/create/text/" aria-current={path.startsWith('/create/')?'page':undefined}><Icon name="spark"/>AI Builder</a><a href="/studio/" aria-current={path.startsWith('/studio/')?'page':undefined}><Icon name="brush"/>Studio</a><a href="/my-artwork/" aria-current={path.startsWith('/my-artwork')?'page':undefined}><Icon name="heart"/>My artwork</a></nav>
