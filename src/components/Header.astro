---
import {categories} from '../ui/categories';
const {variant='full',active='',search='',animal=false}=Astro.props;
const path=Astro.url.pathname;
const navCats=categories.slice(0,7);
const last=variant==='ocean'?categories[7]:variant==='food'?{id:'food',name:'Food & treats',icon:'🧁'}:{id:'?age=kids',name:'For kids',icon:'✏️'};
---
<header class:list={['site-header',{'simple-header':variant==='simple'}]}>
 <div class="utility"><span>Print it. Color it. Make it yours.</span><div><a href="/coloring-pages/?age=kids">For kids</a><a href="/coloring-pages/?age=adults">For adults</a><a href="/my-artwork/">My artwork</a></div></div>
 <div class="header-main"><a class="brand" href="/" aria-label="JotColoring home"><img src="/logo.svg" width="310" height="58" alt="jotcoloring"/></a><button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">☰</button>
 {variant!=='simple'&&<form class="header-search" action="/coloring-pages/" role="search"><span aria-hidden="true">⌕</span><label class="sr-only" for="site-search">Search coloring pages</label><input id="site-search" name="q" value={search} placeholder={animal?'Search animal coloring pages':'Search animals, characters, flowers...'}/><button aria-label="Search">⌕</button></form>}
 <div class="header-actions"><a class="button secondary" href="/create/text/"><span class="sparkle">✦</span> AI Builder <span class="mobile-only">›</span></a><a class="button primary" href="/studio/"><span class="paint-icon">🖌</span><span class="desktop-only">Open Studio</span><span class="mobile-only">Studio ›</span></a></div>
 </div>
 {variant!=='simple'&&<nav class="category-nav" aria-label="Categories"><a class:list={[active==='all'&&'active']} href="/coloring-pages/"><span class="grid-icon">▦</span>{variant==='food'?'Explore':'All categories'}</a>{navCats.map(c=><a class:list={[active===c.id&&'active']} href={`/coloring-pages/${c.id}/`}><span class="category-icon">{c.icon}</span>{c.name}</a>)}<a href={last.id.startsWith('?')?`/coloring-pages/${last.id}`:`/coloring-pages/${last.id}/`}><span class="category-icon">{last.icon}</span>{last.name}</a></nav>}
</header>
<dialog id="mobile-menu" class="mobile-menu"><div><a class="brand" href="/"><img src="/logo.svg" width="240" height="46" alt="jotcoloring"/></a><button data-close-dialog aria-label="Close menu">✕</button></div><nav aria-label="Mobile navigation"><a href="/coloring-pages/">All coloring pages</a>{categories.map(c=><a href={`/coloring-pages/${c.id}/`}>{c.icon} {c.name}</a>)}<a href="/my-artwork/">My artwork & favorites</a></nav></dialog>
{variant!=='simple'&&<nav class="mobile-bottom" aria-label="Main navigation"><a class:list={[path==='/'&&'active']} href="/"><span>⌂</span>Explore</a><a class:list={[path.startsWith('/create')&&'active']} href="/create/text/"><span>✦</span>AI Builder</a><a href="/studio/"><span>🖌</span>Studio</a><a class:list={[path.startsWith('/my-artwork')&&'active']} href="/my-artwork/"><span>▧</span>My artwork</a></nav>}
