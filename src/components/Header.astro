---
import Icon from './HomeIcon.astro';
import SearchForm from './SearchForm.astro';
import CategoryIcon from './CategoryIcon.astro';
import ActionIcon from './ActionIcon.astro';
import NavMagicIcon from './NavMagicIcon.astro';
import NavPhotoIcon from './NavPhotoIcon.astro';
import {categories} from '../ui/categories';
import '../styles/popular-categories.css';
const {variant='full',search='',active='',home=false}=Astro.props;
const path=Astro.url.pathname;
---
 <header class="hv-header jc-header"><div class="hv-header-inner"><a href="/" class="hv-brand" aria-label="JotColoring home"><img src="/logo-3d.webp" alt="JotColoring" width="254" height="48"/></a><nav class="hv-desktop-nav jc-main-nav" aria-label="Main navigation"><a href="/coloring-pages/" aria-current={path.startsWith('/coloring-pages')?'page':undefined}><CategoryIcon name="all" size={34}/><span>Coloring Pages</span></a><a href="/create/photo/" aria-current={path==='/create/photo/'?'page':undefined}><NavPhotoIcon/><span>Photo To Coloring Page</span></a><a href="/create/text/" aria-current={path==='/create/text/'?'page':undefined}><NavMagicIcon/><span>Create With AI</span></a></nav><div class="hv-header-actions"><a class="hv-favorites" href="/my-artwork/" aria-label="My Artwork And Favorites"><ActionIcon name="heart" size={30}/><span>My Artwork</span></a><a class="hv-button hv-primary hv-studio-nav" href="/studio/"><ActionIcon name="brush" size={32}/>Open Studio</a><button type="button" class="hamburger hv-menu-button" aria-label="Open Menu" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={24}/></button></div></div></header>
 <dialog id="mobile-menu" class="hv-mobile-menu" aria-labelledby="mobile-menu-title"><h2 id="mobile-menu-title" class="sr-only">Browse JotColoring</h2><div><img src="/logo-3d.webp" width="190" height="38" alt="JotColoring"/><button type="button" data-close-dialog aria-label="Close Menu"><Icon name="close"/></button></div><nav aria-label="Mobile navigation"><a href="/coloring-pages/">Explore All Coloring Pages</a><a href="/create/photo/">Photo To Coloring Page</a><a href="/create/text/">Create With AI</a><a href="/studio/">Coloring Studio</a><a href="/my-artwork/">My Artwork & Favorites</a><a href="/coloring-pages/?age=kids">For Kids</a><a href="/coloring-pages/?age=adults">For Adults</a>{categories.map(c=><a href={`/coloring-pages/${c.id}/`}>{c.name}</a>)}</nav></dialog>

{!home&&variant!=='simple'&&<div class="iv-searchbar"><SearchForm value={search}/><nav class="jc-popular-categories" aria-label="Popular categories">{categories.slice(0,6).map(c=><a href={`/coloring-pages/${c.id}/`} aria-current={active===c.id?'page':undefined}><span class="jc-popular-category-icon"><CategoryIcon name={c.id} size={38}/></span><span>{c.name}</span></a>)}</nav></div>}
<nav class="hv-mobile-bottom" aria-label="Quick navigation"><a href="/coloring-pages/" aria-current={path.startsWith('/coloring-pages')?'page':undefined}><Icon name="grid"/>Pages</a><a href="/create/photo/" aria-current={path==='/create/photo/'?'page':undefined}><Icon name="photo"/>Photo</a><a href="/studio/" aria-current={path.startsWith('/studio/')?'page':undefined}><Icon name="brush"/>Studio</a><a href="/my-artwork/" aria-current={path.startsWith('/my-artwork')?'page':undefined}><Icon name="heart"/>My Artwork</a></nav>
