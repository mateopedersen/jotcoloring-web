---
import {NAVIGATION_COLLECTIONS,collectionPath} from '../taxonomy/navigation';
import {COLORING_TAXONOMY,categoryPath} from '../taxonomy/catalog';
import Icon from './HomeIcon.astro';
import SearchForm from './SearchForm.astro';
import CategoryIcon from './CategoryIcon.astro';
import ActionIcon from './ActionIcon.astro';
import NavMagicIcon from './NavMagicIcon.astro';
import NavPhotoIcon from './NavPhotoIcon.astro';
import '../styles/navigation.css';
const path=Astro.url.pathname;
const {search=''}=Astro.props;
---
<header class="hv-header jc-header jc-simple-header"><div class="hv-header-inner"><a href="/" class="hv-brand" aria-label="JotColoring home"><img src="/logo-3d.webp" alt="JotColoring" width="254" height="48"/></a><nav class="jc-header-tools" aria-label="Main navigation"><a href="/coloring-pages/" aria-current={path.startsWith('/coloring-pages/')?'page':undefined}><CategoryIcon name="all" size={32}/><span>Coloring Pages</span></a><a href="/create/photo/"><NavPhotoIcon/><span>Photo To Coloring Page</span></a><a href="/create/text/"><NavMagicIcon/><span>Create With AI</span></a></nav><div class="jc-header-quick"><a class="jc-header-artwork" href="/my-artwork/" aria-label="My Artwork And Favorites"><ActionIcon name="heart" size={30}/><span>My Artwork</span></a><a class="jc-header-studio" href="/studio/"><ActionIcon name="brush" size={32}/><span>Open Studio</span></a><button type="button" class="hamburger hv-menu-button jc-site-menu-button" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={22}/><span>Menu</span></button></div></div></header>
<dialog id="mobile-menu" class="jc-site-menu" aria-labelledby="mobile-menu-title">
 <div class="jc-menu-heading"><h2 id="mobile-menu-title">Find Your Coloring Page</h2><button type="button" data-close-dialog aria-label="Close menu"><Icon name="close" size={22}/></button></div>
 <SearchForm idPrefix="menu" value={search}/>
 <nav class="jc-menu-quick" aria-label="Coloring tools"><a href="/coloring-pages/"><CategoryIcon name="all" size={30}/>All Coloring Pages</a><a href="/studio/"><CategoryIcon name="nav-studio" size={30}/>Coloring Studio</a><a href="/create/photo/"><CategoryIcon name="nav-photo" size={30}/>Photo To Coloring Page</a><a href="/my-artwork/"><CategoryIcon name="nav-artwork" size={30}/>My Artwork</a></nav>
 <div class="jc-menu-section-heading"><h3>Browse Collections</h3><a href="/coloring-pages/">View All <Icon name="arrow" size={16}/></a></div>
 <nav class="jc-menu-collections" aria-label="Coloring collections">{NAVIGATION_COLLECTIONS.map(collection=><section class="jc-menu-group"><a class="jc-menu-collection-link" href={collectionPath(collection.id)}><CategoryIcon name={collection.icon} size={36}/><span>{collection.name}</span><Icon name="arrow" size={16}/></a><details><summary>Browse Subjects<Icon name="chevron" size={16}/></summary><div>{COLORING_TAXONOMY.filter(topic=>collection.roots.includes(topic.parent||topic.id)&&categoryPath(topic.id)!==collectionPath(collection.id)).map(topic=><a href={categoryPath(topic.id)} aria-current={path===categoryPath(topic.id)?'page':undefined}>{topic.name}</a>)}</div></details></section>)}</nav>
 <nav class="jc-menu-resources" aria-label="More from JotColoring"><a href="/coloring-by-age/">Browse By Age</a><a href="/create/text/">Create With AI</a><a href="/drawing-board/">Free Drawing Board</a><a href="/help/">Help & FAQ</a></nav>
</dialog>
