---
import {DIFFICULTY_LEVELS} from '../age/difficulty';
import VectorIcon from './VectorIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
const {active=[],category='',home=false}=Astro.props;
---
<section class:list={['difficulty-discovery',home&&'hv-container']} aria-label="Choose a coloring difficulty"><header><div><span>FIND YOUR COMFORT ZONE</span><h2>A little color. Your kind of challenge.</h2></div><a href="/studio/?starters=all"><VectorIcon name="all" size={28}/>10,000 Studio Pages <ArrowIcon size={17}/></a></header><div class="difficulty-levels">{DIFFICULTY_LEVELS.map((d,i)=><a href={`/coloring-pages/${category?category+'/':''}?difficulty=${d.id}`} class:list={[active.includes(d.id)&&'selected']} style={`--level-color:${d.color}`} aria-current={active.includes(d.id)?'page':undefined}><span class="difficulty-symbol"><VectorIcon name={['fill','brush','layers','mandalas'][i]} size={45}/><span class="difficulty-meter" aria-hidden="true">{[0,1,2,3].map(n=><i class:list={[n<=i&&'filled']}/>)}</span></span><span><strong>{d.label}</strong><small>{d.description}</small></span><b><ArrowIcon size={16}/></b></a>)}</div><div class="difficulty-guidance"><p>Detail levels describe the coloring spaces, not a strict age limit.</p><nav aria-label="Find your Studio starting point"><a href="/studio/?starters=kids"><VectorIcon name="nav-kids" size={30}/><span>Kids &amp; Beginners</span><ArrowIcon size={18}/></a><a href="/studio/?starters=adults"><VectorIcon name="nav-adults" size={30}/><span>Adults &amp; Detail Lovers</span><ArrowIcon size={18}/></a></nav></div></section>
<style>
.difficulty-discovery{container:difficulty / inline-size;padding-block:24px;margin-block:10px 20px}.difficulty-discovery header{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px}.difficulty-discovery header>div>span{font-size:var(--type-note-size);letter-spacing:1.1px;font-weight:800;color:#a65c32}.difficulty-discovery h2{font-size:clamp(21px,2.3vw,29px);line-height:1.2;margin:7px 0 0;letter-spacing:-.6px;color:var(--text-ink, #000)}.difficulty-discovery header>a{display:flex;align-items:center;gap:7px;font-size:var(--type-note-size);font-weight:800;color:#98502b;text-decoration:none;white-space:nowrap}.difficulty-levels{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.difficulty-levels>a{min-width:0;display:flex;align-items:center;gap:10px;padding:15px 11px;background:#fffdf8;border:1px solid #e5dfd3;border-radius:16px;text-decoration:none;box-shadow:0 3px #efe7da;color:var(--text-ink, #000);transition:transform .15s,border-color .15s}.difficulty-levels>a:hover,.difficulty-levels>a.selected{border-color:var(--level-color);transform:translateY(-2px);background:#fbf9f1}.difficulty-symbol{display:flex;flex:none;flex-direction:column;align-items:center;gap:3px}.difficulty-meter{display:flex;gap:2px}.difficulty-meter i{display:block;width:6px;height:4px;border-radius:2px;background:#dddcd1}.difficulty-meter .filled{background:var(--level-color)}.difficulty-levels>a>span:nth-child(2){flex:1;min-width:0}.difficulty-levels strong{font-size:16px;color:var(--level-color);font-weight:850;display:block;margin-bottom:5px}.difficulty-levels small{font-size:var(--type-note-size);line-height:1.55;display:block;color:var(--text-ink, #000)}.difficulty-levels b{flex:none;width:24px;height:24px;display:grid;place-items:center;border:1px solid #e9dfcf;border-radius:8px;color:var(--level-color)}.difficulty-discovery>p{font-size:var(--type-note-size);color:var(--text-ink, #000);line-height:1.7;margin:15px 0 0}.difficulty-discovery>p a{color:#93502c;font-weight:750;margin-left:6px}@container difficulty (max-width:960px){.difficulty-levels{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.difficulty-discovery header{display:block}.difficulty-discovery header>a{margin-top:13px}.difficulty-discovery h2{font-size:24px}.difficulty-levels>a{padding:11px 8px;gap:6px}.difficulty-symbol>svg{width:35px;height:35px}.difficulty-levels strong{font-size:15px}.difficulty-levels small{font-size:var(--type-note-size)}.difficulty-levels b{display:none}.difficulty-discovery>p{font-size:var(--type-note-size)}.difficulty-discovery>p>a{display:inline-block;margin-left:2px}.difficulty-discovery{padding-block:18px}}
@media(max-width:380px){.difficulty-levels>a{flex-direction:column;align-items:flex-start;padding:12px;gap:8px}.difficulty-levels>a>span:nth-child(2){width:100%}}
</style>

<style>
.difficulty-guidance{display:grid;justify-items:center;align-content:center;gap:16px;width:100%;max-width:980px;margin:26px auto 16px;padding:22px 16px;text-align:center}
.difficulty-guidance p{max-width:56ch;margin:0;font-size:clamp(17px,1.35vw,20px);font-weight:650;line-height:1.6;color:#000;text-wrap:balance}
.difficulty-guidance nav{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;width:100%}
.difficulty-guidance nav a{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;max-width:100%;padding:10px 17px;border:1px solid #edcdb4;border-radius:14px;background:#fff9f2;color:#8b401d;font-size:16px;font-weight:750;text-decoration:none;box-shadow:0 3px 0 #f0dfcf}
.difficulty-guidance nav a:hover{background:#fff0df;border-color:#d48e60;transform:translateY(-1px)}
.difficulty-guidance nav a>span{min-width:0}.difficulty-guidance nav svg{flex:none}
@media(max-width:480px){.difficulty-guidance{padding:20px 0;margin:20px auto 12px;gap:14px}.difficulty-guidance nav{display:grid;grid-template-columns:minmax(0,1fr);max-width:330px;gap:10px}.difficulty-guidance nav a{justify-content:flex-start;padding:12px 16px;font-size:16px;min-height:58px}.difficulty-guidance nav a>svg:last-child{margin-left:auto}}
</style>
