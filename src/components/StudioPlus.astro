---
import VectorIcon from './VectorIcon.astro';
import {LETTERING_STYLES} from '../studio/lettering';
---
<section id="create-panel" class="settings-panel studio-plus" data-panel="create" role="tabpanel" hidden>
 <div class="plus-heading"><VectorIcon name="magic" size={36}/><div><h2>Your creative toolkit.</h2><p>A little structure. A lot of possibility.</p></div></div>
 <button type="button" class="studio-button primary" data-plus-library>Choose from 10,000 pages</button>
 <button type="button" class="studio-button" data-plus-elements>Add an element or frame</button>
 <details class="studio-detail" open><summary>Arrange your elements</summary><p class="setting-hint">Choose an element in the Elements tab. Locked elements stay in place.</p><div class="plus-grid">{[['center','Center selected'],['fit','Fit selected to page'],['flip-x','Mirror left / right'],['flip-y','Mirror top / bottom'],['lock','Lock / unlock'],['reset','Clear element colors'],['palette','Color with my palette'],['copy','Copy element colors'],['paste','Paste element colors']].map(([id,title])=><button type="button" class="studio-button" data-element-action={id}>{title}</button>)}</div><h3>Arrange all unlocked elements</h3><div class="plus-grid">{[['row','In a row'],['grid','In a grid'],['ring','Around a circle']].map(([id,title])=><button type="button" class="studio-button" data-element-arrange={id}>{title}</button>)}</div></details>
 <details class="studio-detail"><summary>Keep your color stories</summary><label>Name this palette<input maxlength="40" data-palette-name placeholder="My ocean colors"/></label><button type="button" class="studio-button" data-named-palette-save>Save current swatches</button><label>My color stories<select data-named-palette><option value="">Choose a saved palette</option></select></label><div class="plus-grid"><button type="button" class="studio-button" data-named-palette-use>Use these colors</button><button type="button" class="studio-button" data-named-palette-remove>Remove palette</button></div><p class="setting-hint">Named palettes stay on this device. Up to 32 palettes, with 24 colors each.</p></details>
 <details class="studio-detail"><summary>Build your layers</summary><p class="setting-hint">Add the right layer without rearranging everything.</p><div class="plus-grid">{[['background','Background layer'],['shading','Shading layer'],['highlights','Highlight layer']].map(([id,title])=><button type="button" class="studio-button" data-smart-layer={id}>{title}</button>)}</div><button type="button" class="studio-button" data-remove-last-mark>Undo last mark on this layer</button></details>
 <details class="studio-detail"><summary>Your coloring session</summary><div class="plus-stats" data-plus-stats></div><div class="plus-session"><output data-session-time>00:00</output><button type="button" class="studio-button" data-session-toggle>Start timer</button><button type="button" class="studio-button" data-session-reset>Reset</button></div><p class="setting-hint">The optional timer pauses when this tab is hidden.</p></details>
 <button type="button" class="studio-button" data-command-open><VectorIcon name="search" size={25}/>Find a tool <kbd>⌘ / Ctrl K</kbd></button>
</section>
<template data-lettering-panel><details class="studio-detail" open><summary>Make your words stand out</summary><div class="letter-style-grid">{LETTERING_STYLES.map(s=><button type="button" data-letter-style={s.id} style={`font-family:${s.font};font-weight:${s.weight};font-style:${s.italic?'italic':'normal'}`}><span aria-hidden="true">Aa</span>{s.name}</button>)}</div><p class="setting-hint">Add text first, or choose a style to start a new text object.</p><label class="setting-row">Letter spacing <output data-letter-value="letterSpacing">0</output><input aria-label="Letter spacing" type="range" min="-8" max="30" value="0" data-letter-setting="letterSpacing"/></label><label class="setting-row">Line spacing <output data-letter-value="lineHeight">1.25</output><input aria-label="Line spacing" type="range" min="0.7" max="3" step="0.05" value="1.25" data-letter-setting="lineHeight"/></label><label class="setting-row">Bend the text <output data-letter-value="curve">0°</output><input aria-label="Bend the text" type="range" min="-150" max="150" step="5" value="0" data-letter-setting="curve"/></label><label class="setting-row">Outline width <output data-letter-value="outlineWidth">2</output><input aria-label="Outline width" type="range" min="0.5" max="12" step="0.5" value="2" data-letter-setting="outlineWidth"/></label><label class="check-row"><input type="checkbox" data-letter-shadow/> Add a soft shadow</label><div class="plus-grid">{[['center','Center on page'],['duplicate','Duplicate text'],['upper','UPPERCASE'],['title','Title Case'],['lower','lowercase'],['straight','Straighten text']].map(([id,title])=><button type="button" class="studio-button" data-letter-action={id}>{title}</button>)}</div><h3>A quick starting point</h3><div class="plus-grid">{[['hello','Hello Sunshine'],['name','My Masterpiece'],['birthday','Happy Birthday'],['thanks','Thank You']].map(([id,title])=><button type="button" class="studio-button" data-letter-template={id}>{title}</button>)}</div></details></template>
<dialog class="studio-modal command-dialog" data-command-dialog aria-labelledby="command-title"><div class="studio-modal-head"><h2 id="command-title">What would you like to do?</h2><button type="button" class="studio-button" data-command-close aria-label="Close tool finder">×</button></div><label>Find a tool<input type="search" data-command-query placeholder="Try palette, layer, text, page…"/></label><div data-command-results></div></dialog>
