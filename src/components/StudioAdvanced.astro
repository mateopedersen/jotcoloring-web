---
import VectorIcon from './VectorIcon.astro';
---
<details class="studio-detail" data-advanced-tips><summary>Choose your brush tip</summary><div class="tip-options">{[['round','Round','●'],['square','Square','■'],['chisel','Chisel','▰'],['star','Star','★'],['heart','Heart','♥'],['dash','Dash','━']].map(([id,label,symbol])=><button type="button" data-tip-shape={id} aria-pressed={id==='round'} title={`${label} brush tip`}><b aria-hidden="true">{symbol}</b>{label}</button>)}</div><canvas data-tip-preview width="260" height="80" aria-label="Live brush tip preview"/>
 <label class="setting-row">Edge hardness<output data-tip-value="hardness">100%</output><input data-tip="hardness" type="range" min="0" max="100" value="100"/></label><label class="setting-row">Stamp spacing<output data-tip-value="spacing">12%</output><input data-tip="spacing" type="range" min="1" max="150" value="12"/></label><label class="setting-row">Tip angle<output data-tip-value="angle">0°</output><input data-tip="angle" type="range" min="0" max="180" value="0"/></label><label class="setting-row">Tip roundness<output data-tip-value="roundness">100%</output><input data-tip="roundness" type="range" min="8" max="100" value="100"/></label><label class="setting-row">Paint flow<output data-tip-value="flow">100%</output><input data-tip="flow" type="range" min="1" max="100" value="100"/></label><label class="setting-row">Scatter<output data-tip-value="scatter">0%</output><input data-tip="scatter" type="range" min="0" max="150" value="0"/></label><label class="check-row"><input data-tip-flag="rainbow" type="checkbox"/> Rainbow trail</label><label class="check-row"><input data-tip-flag="pressureOpacity" type="checkbox"/> Pen pressure controls opacity</label><div class="two-buttons"><button type="button" class="studio-button" data-brush-preset="save">Save my brush</button><button type="button" class="studio-button" data-brush-preset="restore">Use saved brush</button></div></details>
<details class="studio-detail" data-advanced-selection><summary>Select exactly where to color</summary><div class="selection-tools">{[['select-rectangle','Box selection','grid'],['select-ellipse','Oval selection','mandalas'],['select-lasso','Freehand selection','edit']].map(([id,label,icon])=><button type="button" class="studio-button" data-selection-tool={id}><VectorIcon name={icon} size={24}/>{label}</button>)}</div><label>Combine selections<select data-selection-mode><option value="replace">New selection</option><option value="add">Add to selection</option><option value="subtract">Subtract from selection</option><option value="intersect">Keep overlap only</option></select></label><p class="setting-hint">Drag on the page. Freehand closes when you lift your finger. Brushes stay inside your selection.</p><div class="two-buttons">{[['all','Select all'],['paint','Select painted pixels'],['invert','Invert'],['grow','Grow edges'],['shrink','Shrink edges'],['clear','Deselect'],['save','Keep selection'],['restore','Restore selection'],['fill','Fill selection'],['erase','Erase selection'],['left','Move left'],['right','Move right'],['up','Move up'],['down','Move down']].map(([id,label])=><button type="button" class="studio-button" data-selection-action={id}>{label}</button>)}</div><label class="setting-row">Edge / move distance<input type="range" min="1" max="12" value="2" data-selection-distance aria-label="Selection adjustment distance"/></label><label class="check-row"><input type="checkbox" data-selection-hidden/> Hide selection tint</label><label class="check-row"><input type="checkbox" data-auto-inside/> Automatically protect the area under my brush</label><label class="check-row"><input type="checkbox" data-tap-assist checked/> Help taps close to an outline</label><label class="check-row"><input type="checkbox" data-drawn-boundaries checked/> Use my drawn outlines as fill boundaries</label><label class="setting-row">Fill edge overlap<input type="range" min="0" max="3" value="0" data-fill-grow aria-label="Fill edge overlap"/></label></details>
