---
import '../studio/studio.css';
import StudioAdvanced from './StudioAdvanced.astro';
import StudioLibrary from './StudioLibrary.astro';
import StudioPlus from './StudioPlus.astro';
import '../studio/plus.css';
import '../studio/library/library.css';
import {toolIcon} from '../studio/tool-icons';
import VectorIcon from './VectorIcon.astro';
import Icon from './HomeIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
import {PALETTES} from '../studio/creative';
import {STUDIO_FORMATS} from '../studio/formats';
import {STUDIO_V5_FEATURES} from '../studio/v5-features';
import {ADDITIONAL_FEATURES} from '../studio/additional-features';
import {STUDIO_FEATURES} from '../studio/workspace-state';
const {projectId=''}=Astro.props;
const tools=[['fill','Fill','F'],['brush','Brush','B'],['eraser','Erase','E'],['picker','Pick','I'],['select-rectangle','Select',''],['line','Line','L'],['rectangle','Box','R'],['ellipse','Oval','O'],['star','Star',''],['heart','Heart',''],['move','Move','V'],['zoom','Zoom','Z']];
const tabs=[['colors','Colors','studio'],['brush','Tools','brush'],['layers','Layers','layers'],['objects','Elements','all'],['text','Text','edit'],['project','Project','folder'],['create','Create','magic']];
---
<main id="main" class="jc-studio studio-v4" data-project-id={projectId}>
 <header class="studio-header">
  <a class="studio-logo" href="/" aria-label="JotColoring home"><img src="/logo-3d.webp" alt="JotColoring" width="300" height="80" /></a>
  <div class="studio-project"><span class="studio-kicker">YOUR COLORING DESK</span><button type="button" class="project-title-button" data-rename-project title="Rename artwork"><strong data-project-title>Opening your page…</strong><VectorIcon name="edit" size={22}/></button></div>
  <button type="button" class="studio-button easy-toggle" data-easy-mode aria-label="Easy mode" aria-pressed="false"><VectorIcon name="kids" size={24}/><span>Easy mode</span></button><span class="save-state" data-save-state role="status">Loading</span>
  <a class="studio-button library-link" href="/my-artwork/"><VectorIcon name="artwork" size={26}/><span>My artwork</span></a>
  <button type="button" class="studio-button" data-save aria-label="Save artwork"><VectorIcon name="save" size={26}/><span>Save</span></button>
  <button type="button" class="studio-button primary" data-download="png" aria-label="Download"><VectorIcon name="download" size={28}/><span>Download</span></button>
 </header>
 <div class="studio-message" data-message role="status" aria-live="polite">Opening the original line art…</div>
 <section class="studio-layout" aria-label="Coloring workspace">
  <aside class="studio-tool-rail"><div class="studio-rail-title">MAKE YOUR MARK</div><button type="button" class="studio-button starter-rail" data-open-pages-short title="Choose a ready-to-color page"><VectorIcon name="all" size={28}/><span>Pages</span></button><div class="studio-tools" role="toolbar" aria-label="Drawing tools">{tools.map(([id,label,key])=><button type="button" data-tool={id} aria-label={label} title={`${label}${key?' ('+key+')':''}`} aria-pressed={id==='fill'}><span set:html={toolIcon(id)}/><span>{label}</span></button>)}</div><button type="button" class="studio-button rail-help" data-help-open><span set:html={toolIcon('guide')}/><span>Guide</span></button></aside>
  <section class="studio-workspace">
   <div class="workspace-topline"><div><span class="live-dot"></span><strong data-tool-label>Fill a little joy.</strong><span class="workspace-hint" data-tool-hint>Pick a color. Tap an enclosed space.</span></div><div class="workspace-view-buttons"><button type="button" data-compare-original class="studio-button" title="Hold to see the original"><VectorIcon name="eye" size={22}/>Original</button><button type="button" data-focus class="studio-button" aria-pressed="false" title="Focus mode"><Icon name="expand" size={18}/><span>Focus</span></button></div></div>
   <div class="workspace-colors" aria-label="Quick color palette"><span>Quick colors</span><div data-quick-color-strip></div></div><div class="canvas-stage" data-stage><canvas data-canvas aria-label="Coloring canvas. Choose Fill to color an enclosed area, or Brush to draw." tabindex="0"></canvas><span class="brush-cursor" data-cursor aria-hidden="true"></span><div class="canvas-guide-grid" data-guide-grid hidden></div><aside class="reference-board" data-reference-board hidden><div><strong>Color reference</strong><button type="button" class="studio-button" data-reference-close aria-label="Close reference">×</button></div><img data-reference-image alt="Your private color reference" /></aside></div>
   <div class="canvas-toolbar" role="toolbar" aria-label="Canvas history and view"><div class="history-group"><button type="button" data-history="undo" aria-label="Undo" title="Undo (Ctrl/⌘ Z)" disabled><Icon name="undo" size={20}/><span>Undo</span></button><button type="button" data-history="redo" aria-label="Redo" title="Redo (Ctrl/⌘ Shift Z)" disabled><Icon name="redo" size={20}/><span>Redo</span></button></div><div class="zoom-group"><button type="button" data-zoom="out" aria-label="Zoom out"><Icon name="minus" size={18}/></button><output data-zoom-value>100%</output><button type="button" data-zoom="in" aria-label="Zoom in"><Icon name="plus" size={18}/></button><button type="button" data-fit>Fit page</button></div><button type="button" data-grid aria-pressed="false" title="Show alignment grid"><VectorIcon name="grid" size={22}/><span>Grid</span></button><button type="button" data-mobile-settings class="studio-button inspector-toggle" aria-expanded="false">Colors & tools</button></div>
   <div class="studio-bottom-note"><span><span data-dimensions></span> <output data-pointer-position aria-label="Position on page"></output></span><span>Private on this device <VectorIcon name="privacy" size={18}/></span></div>
  </section>
  <aside class="studio-settings" aria-label="Coloring settings"><div class="settings-drawer-head"><strong>Your colors & tools</strong><button type="button" data-close-inspector aria-label="Close colors and tools">Done <Icon name="close" size={17}/></button></div>
   <div class="inspector-heading"><h1>Make it yours.</h1><span>One color at a time.</span></div>
   <div class="settings-tabs" role="tablist" aria-label="Studio settings">{tabs.map(([id,label,icon])=><button type="button" role="tab" data-tab={id} aria-selected={id==='colors'} aria-controls={`${id}-panel`}><VectorIcon name={icon} size={23}/>{label}</button>)}</div>
   <div class="inspector-scroll">
    <section id="colors-panel" class="settings-panel" data-panel="colors" role="tabpanel">
     <div class="section-label"><h2>Color stories</h2><VectorIcon name="studio" size={28}/></div><label class="sr-only" for="palette-preset">Color palette</label><select id="palette-preset" data-palette-preset>{PALETTES.map((p,i)=><option value={i}>{p.name}</option>)}</select><div class="palette" data-preset-colors></div>
     <div class="active-color-row"><label class="exact-color">Your color<input type="color" value="#ff711c" data-color-input /></label><label>HEX<input type="text" value="#ff711c" maxlength="7" data-hex aria-label="HEX color" spellcheck="false" /></label><button class="studio-button" type="button" data-save-swatch title="Save this color"><Icon name="plus" size={18}/></button></div>
     <button type="button" class="studio-button color-wheel-toggle" data-add-color aria-expanded="false" aria-controls="advanced-color">Fine-tune this color <span>⌄</span></button>
     <div id="advanced-color" class="advanced-color"><div class="hsv-controls"><div class="sv-field" data-sv role="slider" tabindex="0" aria-label="Color saturation and brightness, use arrow keys" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100"><span data-sv-marker></span></div><input class="hue-range" type="range" min="0" max="359" value="22" data-hue aria-label="Hue" /></div></div>
     <h3>Colors that go together</h3><label class="sr-only" for="harmony-mode">Color harmony</label><select id="harmony-mode" data-harmony><option value="analogous">Neighboring colors</option><option value="complementary">Complementary</option><option value="triadic">Three-color harmony</option><option value="monochrome">Shades of this color</option></select><div class="palette small-palette" data-harmony-colors></div>
     <div class="two-buttons"><button type="button" class="studio-button" data-swap-colors>Swap colors</button><button type="button" class="studio-button" data-reset-colors>Black & white</button></div><details class="studio-detail"><summary>Color lab & palettes</summary><label>RGB<input data-rgb-color placeholder="255, 113, 28" aria-label="RGB color"/></label><label>HSL<input data-hsl-color placeholder="22, 100%, 55%" aria-label="HSL color"/></label><div class="two-buttons">{[['lighter','Lighter'],['darker','Darker'],['saturate','More vivid'],['hue','Shift hue']].map(([id,label])=><button type="button" class="studio-button" data-color-adjust={id}>{label}</button>)}</div><button type="button" class="studio-button" data-palette-artwork>Keep colors from my artwork</button><button type="button" class="studio-button" data-palette-export>Download my palette</button><label class="studio-file">Import a color palette<input data-palette-import type="file" accept="application/json,.json"/></label></details><h3>Recently used</h3><div class="palette small-palette" data-recent-colors></div><h3>My saved swatches</h3><div class="palette small-palette" data-saved-colors></div><p class="setting-hint">Use + to keep a color with this project. Shift-click a saved swatch to remove it.</p>
     <details class="studio-detail"><summary>Recolor your artwork</summary><label>Replace this color<input type="color" data-replace-from value="#ff711c"/></label><p class="setting-hint">Replace it with your current color. Locked layers stay protected.</p><div class="two-buttons"><button type="button" data-replace-color="layer" class="studio-button">This layer</button><button type="button" data-replace-color="all" class="studio-button">All artwork</button></div></details>
    </section>
    <section id="brush-panel" class="settings-panel" data-panel="brush" role="tabpanel" hidden>
     <h2>Your tools, your touch.</h2><label>Eyedropper sample<select data-picker-radius><option value="0">Exact pixel</option><option value="1">3 × 3 average</option><option value="2">5 × 5 average</option></select></label><label>Brush finish<select data-brush-style><option value="round">Smooth round brush</option><option value="pencil">Textured pencil</option><option value="crayon">Wax crayon</option><option value="marker">Highlight marker</option><option value="watercolor">Watercolor wash</option><option value="airbrush">Soft airbrush</option></select></label>
     <label class="setting-row">Steady hand <output data-smoothing-value>25%</output><input type="range" min="0" max="85" value="25" data-smoothing/></label><label class="check-row"><input type="checkbox" data-pressure checked/> Use stylus pressure</label><label class="check-row"><input type="checkbox" data-pen-only/> Paint with pen only</label><label class="check-row"><input type="checkbox" data-stay-inside/> Stay inside the selected area</label><p class="setting-hint">Choose “Select an area” below, tap a region with Fill, then use a brush. Your strokes stay inside that region.</p>
     <label>Symmetry<select data-symmetry><option value="none">Just my stroke</option><option value="horizontal">Mirror left & right</option><option value="vertical">Mirror top & bottom</option><option value="both">Four-way reflection</option><option value="radial-4">Four-part radial</option><option value="radial-8">Eight-part radial</option><option value="radial-12">Twelve-part radial</option><option value="radial-16">Sixteen-part radial</option></select></label><label class="check-row"><input type="checkbox" data-shape-filled/> Fill shapes with color</label><p class="setting-hint">Hold Shift while drawing a box or oval to keep it square.</p>
     <h3>Fill & patterns</h3><label>Fill style<select data-fill-effect><option value="solid">Solid color</option><option value="linear">Two-color gradient</option><option value="radial">Center glow</option><option value="stripes">Diagonal stripes</option><option value="dots">Polka dots</option><option value="checks">Checkerboard</option><option value="weave">Woven ribbons</option><option value="bricks">Brick pattern</option><option value="scales">Scallop pattern</option></select></label><label>Second color<input type="color" data-secondary value="#f8d071"/></label><label class="setting-row">Gradient angle<input type="range" min="0" max="360" value="45" data-effect-angle/></label><label class="setting-row">Pattern size<input type="range" min="6" max="100" value="24" data-effect-spacing/></label>
     <label>Fill behavior<select data-fill-behavior><option value="direct">Fill with my current color</option><option value="select">Select an area, then color it</option></select></label><label class="check-row"><input type="checkbox" data-group-regions/> Select several areas together</label><button type="button" class="studio-button" data-clear-selection>Clear area selection</button><label class="setting-row">Edge tolerance <output data-threshold-value>100</output><input type="range" min="20" max="220" value="100" data-threshold/></label><label class="check-row"><input type="checkbox" data-close-gaps/> Close tiny outline gaps</label><StudioAdvanced/>
    </section>
    <section id="layers-panel" class="settings-panel" data-panel="layers" role="tabpanel" hidden><h2>Build it in layers.</h2><p class="setting-hint">Keep backgrounds, shading, and details separate.</p><button type="button" class="studio-button" data-layers-toggle aria-expanded="true" aria-controls="studio-layers">Your layers</button><div id="studio-layers" class="layer-content"><div data-layers></div><button type="button" class="studio-button" data-add-layer><VectorIcon name="layers" size={24}/>Add paint layer</button></div><div class="active-layer-editor"><canvas width="220" height="120" data-layer-preview aria-label="Active paint layer preview"></canvas><label>Layer name<input data-layer-name maxlength="120"/></label><label class="check-row"><input type="checkbox" data-layer-lock/> Lock this layer</label><label class="check-row"><input type="checkbox" data-alpha-lock/> Color only existing paint</label><label class="check-row"><input type="checkbox" data-clip-below/> Clip to the paint layer below</label><label class="setting-row">Layer opacity<output data-layer-opacity-value>100%</output><input type="range" min="0" max="100" value="100" data-layer-opacity/></label><label>Blend mode<select data-layer-blend><option value="source-over">Normal</option><option value="multiply">Multiply · darken</option><option value="screen">Screen · lighten</option><option value="overlay">Overlay · contrast</option></select></label><div class="two-buttons"><button type="button" class="studio-button" data-layer-action="duplicate">Duplicate</button><button type="button" class="studio-button" data-layer-action="solo">Solo / restore</button><button type="button" class="studio-button" data-layer-action="clear">Clear paint</button><button type="button" class="studio-button" data-layer-action="delete">Remove layer</button></div></div></section>
    <section id="objects-panel" class="settings-panel" data-panel="objects" role="tabpanel" hidden><h2>A little something extra.</h2><button type="button" class="studio-button primary" data-open-objects><VectorIcon name="all" size={28}/>Explore 817 elements</button><p class="setting-hint">Select a named part, such as an ear, to color matching parts together.</p>
        <label>Placed objects<select data-object-list><option value="">Select a placed object</option></select></label>
        <section class="object-controls" data-object-controls hidden><h3 data-object-title>Selected object</h3><p data-object-region>Choose Fill, select a part, then choose a color.</p><label class="check-row"><input type="checkbox" data-object-visible checked /> Show object</label><div class="text-actions"><button type="button" class="studio-button" data-object-order="up">Bring forward</button><button type="button" class="studio-button" data-object-order="down">Send backward</button></div><div class="text-grid"><label>X<input type="number" data-object-x min="-4096" max="8192" /></label><label>Y<input type="number" data-object-y min="-4096" max="8192" /></label><label>Scale<input type="number" data-object-scale min="0.1" max="16" step="0.1" /></label><label>Rotation<input type="number" data-object-rotation min="-180" max="180" /></label></div><div class="text-actions"><button type="button" class="studio-button" data-object-apply>Apply transform</button><button type="button" class="studio-button" data-object-duplicate>Duplicate</button><button type="button" class="studio-button" data-object-delete>Remove</button></div></section>

</section><section id="text-panel" class="settings-panel" data-panel="text" role="tabpanel" hidden><h2>Say it with color.</h2><h3 class="studio-text-heading">Add a message</h3><label>Text<textarea data-text-input rows="2" maxlength="500" placeholder="Make it yours"></textarea></label>
        <label>Text object<select data-text-list><option value="">New text</option></select></label>
        <div class="text-grid"><label>Size<input type="number" data-text-size value="72" min="10" max="400" /></label><label>Rotation<input type="number" data-text-rotation value="0" min="-180" max="180" /></label><label>X<input type="number" data-text-x value="80" min="0" /></label><label>Y<input type="number" data-text-y value="80" min="0" /></label><label>Scale<input type="number" data-text-scale value="1" min="0.2" max="5" step="0.1" /></label><label>Align<select data-text-align><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select></label></div>
        <div class="text-actions"><button type="button" data-apply-text class="studio-button pale">Apply text</button><button type="button" data-delete-text class="studio-button">Delete text</button></div>
<label>Lettering style<select data-text-font><option value="sans-serif">Clean sans serif</option><option value="serif">Classic serif</option><option value="monospace">Typewriter</option><option value="cursive">Handwritten</option></select></label><div class="two-buttons"><label class="check-row"><input type="checkbox" data-text-bold checked/> Bold</label><label class="check-row"><input type="checkbox" data-text-italic/> Italic</label></div><label class="check-row"><input type="checkbox" data-text-outline/> Colorable outline letters</label></section>
<section id="project-panel" class="settings-panel" data-panel="project" role="tabpanel" hidden><h2>Your creative space.</h2><button type="button" class="studio-button primary" data-open-pages><VectorIcon name="all" size={28}/>Explore 10,000 coloring pages</button><label>Paper color<input type="color" value="#ffffff" data-paper-color/></label><label class="setting-row">Outline strength<output data-line-opacity-value>100%</output><input type="range" min="0" max="100" value="100" data-line-opacity/></label><label class="check-row"><input type="checkbox" data-left-handed/> Left-handed layout</label>
<h3>A different perspective</h3><div class="two-buttons"><button type="button" class="studio-button" data-grayscale-view aria-pressed="false">Check in grayscale</button><button type="button" class="studio-button" data-flip-view aria-pressed="false">Mirror my view</button></div><label>Canvas guides<select data-grid-style><option value="grid">Drawing grid</option><option value="thirds">Rule of thirds</option></select></label><h3>Bring your inspiration</h3><label class="studio-file">Open a reference image<input type="file" accept="image/png,image/jpeg,image/webp" data-reference-file/></label><button type="button" class="studio-button" data-extract-palette disabled>Make a palette from my reference</button><p class="setting-hint">Your image stays on this device and is never included in downloads.</p>
<h3>Save a version</h3><label>Checkpoint name<input data-version-name maxlength="60" placeholder="Before adding a background"/></label><button type="button" class="studio-button" data-version-save><VectorIcon name="save" size={24}/>Keep this version</button><div data-versions class="version-list"></div><details class="studio-detail"><summary>Undo history</summary><div data-history-list class="history-list"></div></details><button type="button" class="studio-button" data-backup-project><VectorIcon name="backup" size={24}/>Download editable backup</button>
<h3>Start something new</h3><label>Canvas shape<select data-blank-preset><option value="portrait">Portrait · 1024 × 1536</option><option value="landscape">Landscape · 1536 × 1024</option><option value="square">Square · 1200 × 1200</option></select></label><div class="two-buttons"><button type="button" class="studio-button" data-start-blank>New blank page</button><button type="button" class="studio-button" data-open-pdf>Import PDF</button></div><button type="button" class="studio-button reset-button" data-reset>Reset painting</button><p class="setting-hint">Your current project saves before opening a new one. Reset can be undone.</p></section>
<StudioPlus/></div><div class="inspector-bottom"><div class="quick-sizes" aria-label="Quick brush sizes">{[[1,'Fine'],[4,'Small'],[12,'Medium'],[32,'Wide'],[80,'Big']].map(([n,label])=><button type="button" data-quick-size={n}><i style={`width:${Math.min(20,Number(n)/4+2)}px;height:${Math.min(20,Number(n)/4+2)}px`}/>{label}</button>)}</div><label class="brush-numeric"><span>Exact size</span><input type="number" min="1" max="240" value="12" data-size-number aria-label="Brush size in pixels"/><span>px</span></label><label class="setting-row">Size<output data-size-value>12</output><input data-size type="range" min="1" max="240" value="12"/></label><label class="setting-row">Opacity<output data-opacity-value>100%</output><input data-opacity type="range" min="1" max="100" value="100"/></label><label class="check-row"><input type="checkbox" data-outlines checked/> Keep outlines on top</label></div></aside></section>
<dialog class="studio-modal export-modal" data-export-dialog><div class="studio-modal-head"><div><span class="studio-kicker">LOOK WHAT YOU MADE</span><h2>Take your colors with you.</h2><p>A real file, ready to print, share, or keep.</p></div><button type="button" data-export-close aria-label="Close download"><Icon name="close" size={20}/></button></div><div class="studio-export-layout"><div class="export-artwork-preview"><img data-export-preview alt="Your colored artwork, ready to download"/></div><form data-studio-export-form><label>Filename<input data-export-filename maxlength="100" required/></label><fieldset class="studio-format-grid"><legend>Choose your format</legend>{STUDIO_FORMATS.map(f=><label><input type="radio" name="studio-format" value={f.id} checked={f.id==='png'}/><span><VectorIcon name={f.icon} size={35}/><strong>{f.label}</strong><small>{f.hint}</small></span></label>)}</fieldset><div class="two-fields"><label>Rotate download<select data-export-rotation><option value="0">Keep current orientation</option><option value="90">90° clockwise</option><option value="180">180°</option><option value="270">90° counterclockwise</option></select></label><label>Image size<select data-export-scale><option value="1">Original resolution</option><option value="0.75">75% · smaller copy</option><option value="0.5">50% · quick sharing</option></select></label><label>JPEG / WEBP quality<select data-export-quality><option value="0.92">High quality</option><option value="1">Maximum quality</option><option value="0.8">Smaller file</option></select></label></div><label class="check-row"><input type="checkbox" data-export-outline/> Include the original uncolored page</label><p class="setting-hint">PDF stays under 1 MB. SVG contains your lossless artwork as an embedded image. Word includes your colored page in a .docx document.</p><button type="submit" class="studio-button primary export-go"><VectorIcon name="download" size={30}/>Download my artwork</button><button type="button" class="studio-button" data-export-all>All 7 formats · ZIP pack</button><p data-studio-export-status role="status" aria-live="polite"></p></form></div></dialog>
<dialog class="studio-modal help-modal" data-help-dialog><div class="studio-modal-head"><div><span class="studio-kicker">A LITTLE GUIDANCE</span><h2>Make yourself at home.</h2></div><button type="button" data-help-close aria-label="Close guide"><Icon name="close" size={20}/></button></div><div class="help-steps"><div><VectorIcon name="fill" size={50}/><h3>Tap to color.</h3><p>Pick Fill and a color, then tap inside a closed outline. Undo is always close by.</p></div><div><VectorIcon name="brush" size={50}/><h3>Find your finish.</h3><p>Open Tools for pencils, crayons, washes, symmetry, gradients, and area protection.</p></div><div><VectorIcon name="layers" size={50}/><h3>Keep your options.</h3><p>Use layers and named checkpoints to try a new direction. Download your favorite.</p></div></div><p class="shortcut-guide"><b>B</b> Brush · <b>F</b> Fill · <b>E</b> Erase · <b>I</b> Pick · <b>V</b> Move · <b>Space</b> Pan · <b>0</b> Fit · <b>+ / −</b> Zoom · <b>Ctrl/⌘ Z</b> Undo</p><details class="studio-detail"><summary>Explore the creative features</summary><div class="feature-guide">{[...STUDIO_FEATURES,...ADDITIONAL_FEATURES,...STUDIO_V5_FEATURES].map(([id,title,description])=><article data-feature={id}><h3>{title}</h3><p>{description}</p></article>)}</div></details></dialog>
  <dialog class="studio-modal" data-object-dialog><div class="studio-modal-head"><div><h2>Find your finishing touch.</h2><p>817 colorable elements: subjects, frames, symbols, and decorative variations.</p></div><button type="button" data-close-objects aria-label="Close object library"><Icon name="close" size={20}/></button></div><div class="object-search"><label>Find an object<input type="search" data-object-search placeholder="Try fox, flower, vehicle…" /></label><label>Category<select data-object-category><option value="">All categories</option></select></label></div><p class="object-results-status" data-object-results role="status"></p><div class="object-library-grid" data-object-grid></div><div class="object-pagination"><button type="button" data-object-page="previous"><ArrowIcon kind="left" size={18}/> Previous</button><span data-object-page-label></span><button type="button" data-object-page="next">Next <ArrowIcon kind="right" size={18}/></button></div></dialog>
  <dialog class="studio-modal pdf-modal" data-pdf-dialog><div class="studio-modal-head"><div><h2>Import a coloring PDF</h2><p>Open a black-and-white page. It stays on this device.</p></div><button type="button" data-close-pdf aria-label="Close PDF import"><Icon name="close" size={20}/></button></div><label class="pdf-file-label">Choose PDF<input type="file" data-pdf-file accept="application/pdf,.pdf" /></label><p class="setting-hint">Up to 20 MB and 100 pages. PDF layers are flattened to a locked outline; choose closed areas with Fill or group areas manually. Password-protected and active PDFs are rejected.</p><label class="pdf-page-picker" hidden data-pdf-page-label>Page<select data-pdf-page></select></label><p data-pdf-status role="status" aria-live="polite"></p><img data-pdf-preview alt="Selected PDF page preview" hidden /><button type="button" class="studio-button primary" data-import-pdf disabled>Open this page in Studio</button></dialog>
<StudioLibrary/></main>
<script>import {mountStudio} from "../studio/controller";mountStudio();</script>
