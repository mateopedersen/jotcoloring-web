---
import SearchIcon from './SearchIcon.astro';
import ActionIcon from './ActionIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
import type {Content} from '../server/types';
import '../styles/coloring-guide.css';
const {item}=Astro.props as {item?:Content};
const steps=[
 {id:'discover',name:'Find a page',title:'Find a page you love.',body:'Explore a theme or search for a subject you love. Open a coloring page for a closer look, or use Quick preview when it is available.',hint:'Animals, flowers, imaginary worlds. Follow your curiosity.',image:'/guides/find-a-page.webp',width:1212,height:585,alt:'The real JotColoring collection, with uncolored page previews, age recommendations and PDF, Image and Studio controls.',href:'/coloring-pages/',action:'Explore coloring pages',screen:'The coloring collection'},
 {id:'download',name:'Choose your way',title:'Paper or pixels? Your call.',body:'Choose PDF for printing or Image for a digital copy. The download window opens over the page, so you can keep your place in the collection.',hint:'Prefer to color online? Open the same page in Studio.',image:'/guides/download-window.webp',width:1120,height:838,alt:'The real JotColoring download window, showing an uncolored Woodland Friends preview, PDF and Image choices, file sizes and the Download button.',href:item?.downloads.pdf||'/coloring-pages/',action:'Try the download window',screen:'PDF & Image downloads'},
 {id:'color',name:'Make it yours',title:'One little tap. A lot of color.',body:'In Studio, choose Fill, tap an area, then pick a color. Use Save to keep your editable project, or Download to take a finished copy with you.',hint:'Your saved projects are kept in My Artwork in this browser.',image:'/guides/color-in-studio.webp',width:1280,height:889,alt:'An actual JotColoring Studio session with an orange dinosaur, preserved black outlines, color palette, layers, Save and Download controls.',href:item?`/studio/?page=${encodeURIComponent(item.id)}`:'/studio/',action:'Try Coloring Studio',screen:'A real coloring session'}
];
---
<section id="how-it-works" class="jc-coloring-guide hv-container" data-coloring-guide aria-labelledby="how-title"><header class="jc-guide-heading"><div><p class="hv-kicker">A LITTLE INSPIRATION. A FEW SIMPLE STEPS.</p><h2 id="how-title">Your first page,<br/><span>made your way.</span></h2></div><p>Search, download, and color along with these step-by-step examples.</p></header>
 <div class="jc-guide-tabs" role="tablist" aria-label="How JotColoring works">{steps.map((step,i)=><button type="button" id={`guide-tab-${i}`} role="tab" data-guide-tab={i} aria-selected={i===0?'true':'false'} aria-controls={`guide-panel-${i}`} tabindex={i===0?0:-1}><span class="jc-guide-tab-number">0{i+1}</span>{i===0?<SearchIcon size={41}/>:<ActionIcon name={i===1?'pdf':'brush'} size={41}/>}<span><b>{step.name}</b><small>Step {i+1} of 3</small></span><ArrowIcon kind="right" size={18}/></button>)}</div>
 {steps.map((step,i)=><div id={`guide-panel-${i}`} class="jc-guide-panel" role="tabpanel" aria-labelledby={`guide-tab-${i}`} data-guide-panel={i} data-guide-title={step.title} data-guide-screen={step.screen} data-guide-description={step.body} hidden={i!==0}><div class="jc-guide-copy"><p class="jc-guide-step-label">0{i+1}<span>{step.screen}</span></p><h3>{step.title}</h3><p>{step.body}</p><div class="jc-guide-tip"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z" fill="#f5d6a6" stroke="#a96636" stroke-width="1.5"/></svg><span>{step.hint}</span></div><a class="jc-guide-action" href={step.href}>{step.action}<ArrowIcon kind="right" size={19}/></a>{i<2&&<button type="button" class="jc-guide-next" data-guide-next={i+1}>Next: {steps[i+1].name}<ArrowIcon kind="right" size={16}/></button>}</div><figure class="jc-guide-screen"><div class="jc-guide-screenbar"><span class="jc-guide-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>JotColoring · {step.screen}</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 10h12v11H6V10Zm3 0V6a3 3 0 0 1 6 0v4"/></svg></div><button type="button" class="jc-guide-screen-button" data-guide-enlarge={i} aria-haspopup="dialog" aria-controls="guide-screen-viewer" aria-label={`Enlarge screen: ${step.screen}`}><img src={step.image} alt={step.alt} width={step.width} height={step.height} loading="lazy"/><span class="jc-guide-zoom"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 9V3h6m6 0h6v6M3 15v6h6m6 0h6v-6"/></svg>View screen</span></button><figcaption>Captured in the working JotColoring tools.</figcaption></figure></div>)}
 <dialog id="guide-screen-viewer" class="jc-guide-viewer" aria-labelledby="guide-viewer-title"><header><div><p>A CLOSER LOOK</p><h2 id="guide-viewer-title"></h2></div><button type="button" data-guide-close aria-label="Close screen preview"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header><img data-guide-viewer-image alt=""/><footer><button type="button" data-guide-viewer-prev aria-label="Previous screen"><ArrowIcon kind="left" size={18}/></button><p data-guide-viewer-copy></p><button type="button" data-guide-viewer-next aria-label="Next screen"><ArrowIcon kind="right" size={18}/></button></footer></dialog>
</section>
<script>import {mountColoringGuide} from '../ui/coloring-guide';mountColoringGuide();</script>
