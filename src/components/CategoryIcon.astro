---
import CreativeIcon from './CreativeIcon.astro';
interface Props {name:string;size?:number}
const {name,size=28}=Astro.props;
const symbols=new Set(['all','animals','flowers','fantasy','mandalas','holidays','vehicles','space','ocean','food','dinosaurs','woodland','pets','farm-animals','birds']);
const symbol=symbols.has(name)?name:'all';
---
{['all','animals','flowers','mandalas'].includes(symbol)?<CreativeIcon name={symbol} size={size} class="category-3d"/>:<svg class="category-3d" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" focusable="false"><use href={`/illustrations/category-3d.svg#${symbol}`}/></svg>}
