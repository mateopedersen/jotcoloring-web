---
import {numberTopic} from '../taxonomy/number-topics';
interface Props {counts:{number:string;count:number}[];active?:number}
const {counts,active}=Astro.props;
const topics=counts.flatMap(row=>{const topic=numberTopic(row.number);return topic&&row.count>0?[{...topic,count:row.count}]:[];}).sort((a,b)=>a.number-b.number);
---
{topics.length>0&&<nav class="number-topics" aria-label="Number topics"><h2>Choose a number</h2><div>{topics.map(topic=><a href={topic.path} aria-current={active===topic.number?'page':undefined}><strong>{topic.name}</strong><span>{topic.count} pages</span></a>)}</div></nav>}
<style>.number-topics{margin:24px 0}.number-topics h2{font-size:22px}.number-topics>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:10px}.number-topics a{display:flex;flex-direction:column;gap:4px;padding:14px;border:1px solid #d9ded8;border-radius:12px;color:inherit;text-decoration:none}.number-topics a[aria-current=page]{background:#e7f3e9;border-color:#397652}.number-topics span{font-size:13px;color:#58625b}</style>
