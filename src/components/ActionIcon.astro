---
import CreativeIcon from './CreativeIcon.astro';
interface Props {name:'pdf'|'webp'|'brush'|'heart';size?:number}
const {name,size=38}=Astro.props;
const id=`jc${crypto.randomUUID().replaceAll('-','')}`;
---
{name==='brush'?<CreativeIcon name="studio" size={size} class="jc-action-icon jc-action-icon-brush"/>:<svg class:list={['jc-action-icon',`jc-action-icon-${name}`]} width={size} height={size} viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
 <defs>
  <linearGradient id={`${id}-paper`} x1="14" y1="7" x2="75" y2="84" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".58" stop-color="#fff9ef"/><stop offset="1" stop-color="#dfc3a9"/></linearGradient>
  <linearGradient id={`${id}-orange`} x1="14" y1="10" x2="75" y2="82" gradientUnits="userSpaceOnUse"><stop stop-color="#ffd19b"/><stop offset=".34" stop-color="#ff9b47"/><stop offset=".7" stop-color="#ef6e27"/><stop offset="1" stop-color="#a73e1b"/></linearGradient>
  <linearGradient id={`${id}-wood`} x1="20" y1="65" x2="74" y2="13" gradientUnits="userSpaceOnUse"><stop stop-color="#963d21"/><stop offset=".32" stop-color="#d66d2b"/><stop offset=".55" stop-color="#ffb361"/><stop offset=".8" stop-color="#cb5c24"/><stop offset="1" stop-color="#863b25"/></linearGradient>
  <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff8de"/><stop offset=".3" stop-color="#c8ab8b"/><stop offset=".55" stop-color="#fffef2"/><stop offset=".8" stop-color="#a98668"/><stop offset="1" stop-color="#fce8ca"/></linearGradient>
  <linearGradient id={`${id}-green`} x1="12" y1="13" x2="80" y2="82" gradientUnits="userSpaceOnUse"><stop stop-color="#d9ed9c"/><stop offset=".45" stop-color="#89ba69"/><stop offset="1" stop-color="#347a67"/></linearGradient>
  <linearGradient id={`${id}-sky`} x1="9" y1="8" x2="75" y2="69" gradientUnits="userSpaceOnUse"><stop stop-color="#dffff8"/><stop offset=".55" stop-color="#93d7d0"/><stop offset="1" stop-color="#4aa5a9"/></linearGradient>
 </defs>
 <ellipse cx="49" cy="85" rx="34" ry="5" fill="#774126" opacity=".16"/>
 {name==='pdf'&&<>
  <path d="M25 9h33l18 17v51q0 7-7 7H25q-7 0-7-7V16q0-7 7-7Z" fill="#ae7651" opacity=".35"/>
  <path d="M21 7h33l18 17v50q0 7-7 7H21q-7 0-7-7V14q0-7 7-7Z" fill={`url(#${id}-paper)`} stroke="#d3a98a" stroke-width="2"/>
  <path d="M54 7v12q0 5 5 5h13" fill="#f6deca" stroke="#d3a98a" stroke-width="2"/>
  <path d="M56 8v10q0 4 4 4h9" stroke="#fff" stroke-width="2" opacity=".8"/>
  <path d="M24 33h32M24 40h27" stroke="#dfc7b0" stroke-width="2.5" stroke-linecap="round"/>
  <rect x="10" y="49" width="58" height="24" rx="6" fill="#984026" opacity=".25"/>
  <rect x="8" y="46" width="58" height="24" rx="6" fill={`url(#${id}-orange)`} stroke="#c35c2b" stroke-width="1.5"/>
  <path d="M13 49h46" stroke="#ffe7cb" stroke-width="2" opacity=".65" stroke-linecap="round"/>
  <text x="37" y="63" fill="white" text-anchor="middle" font-family="system-ui,sans-serif" font-weight="800" font-size="15" letter-spacing=".5">PDF</text>
  <path d="M24 77h29" stroke="#e6c9ae" stroke-width="2" stroke-linecap="round"/>
 </>}
 {name==='webp'&&<>
  <path d="m14 19 55-8q6-1 7 5l6 49q1 7-6 8l-55 8q-6 1-7-5L8 27q-1-7 6-8Z" fill="#a56b4f" opacity=".25"/>
  <rect x="10" y="11" width="68" height="62" rx="9" fill={`url(#${id}-paper)`} stroke="#d7b296" stroke-width="2"/>
  <rect x="16" y="17" width="56" height="46" rx="4" fill={`url(#${id}-sky)`}/>
  <circle cx="57" cy="29" r="8" fill="#ffcb70"/><circle cx="54" cy="26" r="2.7" fill="#fff5d3" opacity=".8"/>
  <path d="m16 55 15-24 12 16 11-12 18 21v7H16Z" fill={`url(#${id}-green)`}/>
  <path d="m31 31 5 7-6-2-5 5Z" fill="#fff5df"/><path d="m16 55 14-9 10 8 11-12 21 14v7H16Z" fill={`url(#${id}-orange)`} opacity=".88"/>
  <path d="M20 20h27M20 24h15" stroke="white" stroke-width="2" stroke-linecap="round" opacity=".55"/>
  <path d="M20 68h48" stroke="#d5b299" stroke-width="2" stroke-linecap="round"/>
 </>}

 {name==='heart'&&<>
  <path d="M49 81 18 53C-3 31 21 6 44 26l5 5 5-5C77 6 101 31 80 53L49 81Z" fill="#a45339" opacity=".25"/>
  <path class="jc-heart-fill" d="M48 77 17 49C-1 29 21 7 43 26l5 5 5-5C75 7 97 29 79 49L48 77Z" fill="#fff0e3" stroke="#cf855e" stroke-width="2"/>
  <path d="M19 34c2-10 11-13 18-9" stroke="#fff" stroke-width="5" opacity=".85" stroke-linecap="round"/>
  <path d="M75 44 56 62" stroke="#d58c6c" stroke-width="3" opacity=".4" stroke-linecap="round"/>
 </>}
</svg>}
