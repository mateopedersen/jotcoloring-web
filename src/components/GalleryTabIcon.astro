---
interface Props { kind:'trending'|'newest'|'easy'|'detailed'; size?:number }
const {kind,size=44}=Astro.props;
const id=(name:string)=>`gallery-${kind}-${name}`;
---
<svg class="jc-gallery-illustration" data-gallery-icon={kind} width={size} height={size} viewBox="0 0 128 128" fill="none" aria-hidden="true" focusable="false">
 <defs>
  <linearGradient id={id('paper')} x1="22" y1="16" x2="99" y2="115" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".7" stop-color="#fff8ed"/><stop offset="1" stop-color="#e9d8c0"/></linearGradient>
  <linearGradient id={id('orange')} x1="20" y1="12" x2="110" y2="112" gradientUnits="userSpaceOnUse"><stop stop-color="#ffd18e"/><stop offset=".48" stop-color="#f58a3d"/><stop offset="1" stop-color="#bd4a1f"/></linearGradient>
  <linearGradient id={id('blue')} x1="20" y1="15" x2="100" y2="110" gradientUnits="userSpaceOnUse"><stop stop-color="#d7f3ed"/><stop offset=".5" stop-color="#79c5c9"/><stop offset="1" stop-color="#3a8a97"/></linearGradient>
  <radialGradient id={id('gold')}><stop stop-color="#fff3b3"/><stop offset=".6" stop-color="#ffc765"/><stop offset="1" stop-color="#e88b30"/></radialGradient>
 </defs>
 <ellipse cx="64" cy="112" rx="45" ry="7" fill="#7c4b32" opacity=".14"/>
 {kind==='trending'&&<g stroke-linejoin="round">
  <path d="M29 30 78 19l14 66-48 11z" fill="#e9c8a7" stroke="#d6a788" stroke-width="2.5"/>
  <path d="M40 21 92 27l-6 68-52-5z" fill={`url(#${id('paper')})`} stroke="#d8bca7" stroke-width="2.5"/>
  <path d="M22 35h55a5 5 0 0 1 5 5v57a5 5 0 0 1-5 5H22a5 5 0 0 1-5-5V40a5 5 0 0 1 5-5Z" fill={`url(#${id('paper')})`} stroke="#cfa78d" stroke-width="3"/>
  <rect x="25" y="44" width="49" height="40" rx="3" fill="#e9f4e8" stroke="#c1d6c3" stroke-width="2"/>
  <path d="m29 76 12-14 8 9 8-12 13 17Z" fill="#74ae83"/><circle cx="61" cy="53" r="5" fill="#fbc16a"/>
  <path d="m92 39 4.2 9 9.8 1-7.3 6.6 2 9.8-8.7-5-8.7 5 2-9.8-7.3-6.6 9.8-1Z" fill={`url(#${id('gold')})`} stroke="#c67a29" stroke-width="2.5"/>
 </g>}
 {kind==='newest'&&<g stroke-linejoin="round">
  <path d="M34 17h45l17 17v62a7 7 0 0 1-7 7H34a7 7 0 0 1-7-7V24a7 7 0 0 1 7-7Z" fill={`url(#${id('paper')})`} stroke="#cda88f" stroke-width="3"/>
  <path d="M79 18v16h16" fill="#f4dac3" stroke="#cda88f" stroke-width="2.5"/>
  <path d="M39 44h38M39 53h30" stroke="#d7bca5" stroke-width="3" stroke-linecap="round"/>
  <path d="m42 82 11-15 8 8 8-12 14 19Z" fill="#9ac69e" stroke="#72a985" stroke-width="2"/><circle cx="70" cy="62" r="4.5" fill="#f6c261"/>
  <circle cx="92" cy="87" r="20" fill={`url(#${id('blue')})`} stroke="#4a91a0" stroke-width="3"/>
  <path d="M92 77v20M82 87h20" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
  <path d="m99 17 2.5 5.5L107 25l-5.5 2.5L99 33l-2.5-5.5L91 25l5.5-2.5Z" fill="#f4aa4d"/>
 </g>}
 {kind==='easy'&&<g stroke-linejoin="round" stroke-linecap="round">
  <rect x="19" y="17" width="76" height="90" rx="8" fill={`url(#${id('paper')})`} stroke="#cda88f" stroke-width="3"/>
  <circle cx="55" cy="59" r="19" fill="#fff" stroke="#9a6a4c" stroke-width="3.5"/>
  <path d="M55 32v-6M55 92v-6M28 59h-6M88 59h-6M36 40l-4-4M78 82l-4-4M74 40l4-4M32 82l4-4" stroke="#df9b55" stroke-width="4"/>
  <circle cx="48" cy="56" r="2" fill="#976444"/><circle cx="62" cy="56" r="2" fill="#976444"/><path d="M48 65q7 7 14 0" stroke="#976444" stroke-width="3"/>
  <path d="m83 96 19-31 9 6-19 31-13 7Z" fill={`url(#${id('orange')})`} stroke="#b95b2c" stroke-width="3"/>
  <path d="m84 95 9 6M99 70l9 6" stroke="#ffe1b9" stroke-width="3"/><path d="m79 109 5-11 7 5Z" fill="#edc596" stroke="#a86c48" stroke-width="2"/><path d="m79 109 4-3 2 2Z" fill="#684235"/>
 </g>}
 {kind==='detailed'&&<g stroke-linejoin="round">
  <rect x="22" y="15" width="79" height="94" rx="8" fill={`url(#${id('paper')})`} stroke="#cda88f" stroke-width="3"/>
  <circle cx="61" cy="60" r="31" fill="#fffdf6" stroke="#d6a682" stroke-width="2.5"/>
  {[0,45,90,135,180,225,270,315].map(angle=><ellipse cx="61" cy="42" rx="7" ry="16" transform={`rotate(${angle} 61 60)`} fill={angle%90===0?`url(#${id('blue')})`:`url(#${id('gold')})`} stroke="#ba7a4e" stroke-width="2"/>)}
  <circle cx="61" cy="60" r="11" fill="#ffedc1" stroke="#bd7b46" stroke-width="2.5"/><circle cx="61" cy="60" r="4.5" fill="#df8c48"/>
  <path d="M34 91h53M40 97h41" stroke="#dfc4ac" stroke-width="2.2" stroke-linecap="round"/>
  <path d="m88 103 15-25 7 4-15 25-10 5Z" fill={`url(#${id('orange')})`} stroke="#b95b2c" stroke-width="2.5"/><path d="m88 102 7 5M101 82l7 4" stroke="#ffe0b6" stroke-width="2.5"/>
 </g>}
</svg>
