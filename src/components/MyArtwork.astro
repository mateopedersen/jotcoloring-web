---
import ActionIcon from './ActionIcon.astro';
import CategoryIcon from './CategoryIcon.astro';
import {libraryIcon} from '../artwork/icons';
import '../artwork/library.css';
const scopes=[['all','All saves','all'],['projects','My artwork','brush'],['favorites','Favorite pages','heart'],['starred','Starred','star'],['recent','Recently opened','clock'],['unfiled','Not on a board','folder'],['in-progress','In progress','edit'],['finished','Finished','check'],['archived','Archive','archive'],['trash','Trash','trash']];
const sorts=[['updated-desc','Last saved · newest'],['updated-asc','Last saved · oldest'],['created-desc','Date added · newest'],['created-asc','Date added · oldest'],['title-asc','Title · A–Z'],['title-desc','Title · Z–A'],['opened-desc','Recently opened'],['rating-desc','Highest rated'],['size-desc','Largest files'],['size-asc','Smallest files'],['manual','Custom order'],['tags-desc','Most tags']];
---
<main id="main" class="artwork-library" data-library>
 <section class="aw-hero"><div><p class="aw-eyebrow">YOUR CREATIVE CORNER</p><h1>My artwork<span>Your colors. Your collections.</span></h1><p>Save favorite coloring pages, organize boards, and continue your saved Studio projects.</p><div class="aw-hero-actions"><button type="button" class="aw-primary" data-aw="new-board"><span set:html={libraryIcon('plus')}/>Create a board</button><a href="/coloring-pages/"><span set:html={libraryIcon('search')}/>Find a coloring page</a></div></div><div class="aw-hero-art" aria-hidden="true"><span><CategoryIcon name="flowers" size={72}/></span><span><CategoryIcon name="animals" size={72}/></span><span><ActionIcon name="brush" size={70}/></span><b>MADE BY YOU,<br/> KEPT FOR YOU.</b></div></section>
 <div class="aw-summary" data-aw-summary></div>
 <div class="aw-local-note"><span set:html={libraryIcon('lock')}/><span><strong>Saved on this device.</strong> Your artwork and boards stay in this browser. Download a backup to keep a portable copy.</span><button type="button" data-aw="backup-all">Back up library <span set:html={libraryIcon('download')}/></button></div>
 <div class="aw-mobile-tools"><button type="button" data-aw="import">Import backup</button><button type="button" data-aw="storage">Storage & backup</button><button type="button" data-aw="archived-boards">Archived boards</button><button type="button" data-aw="shortcuts">Shortcuts</button></div>
 <div class="aw-shell"><aside class="aw-sidebar"><div class="aw-side-heading"><h2>Your library</h2><button type="button" data-aw="refresh" aria-label="Refresh library" title="Refresh library"><span set:html={libraryIcon('refresh')}/></button></div><nav aria-label="Library views">{scopes.map(([id,label,icon])=><button type="button" data-aw="scope" data-scope={id} aria-pressed={id==='all'}><span set:html={libraryIcon(icon)}/><span>{label}</span><b data-scope-count={id}>0</b></button>)}</nav><div class="aw-side-heading"><h2>Your boards</h2><button type="button" data-aw="new-board" aria-label="Create a board"><span set:html={libraryIcon('plus')}/></button></div><div data-aw-board-nav class="aw-board-nav"></div><button type="button" class="aw-side-link" data-aw="archived-boards"><span set:html={libraryIcon('archive')}/>Archived boards</button><button type="button" class="aw-side-link" data-aw="import"><span set:html={libraryIcon('upload')}/>Import a backup</button><button type="button" class="aw-side-link" data-aw="storage"><span set:html={libraryIcon('info')}/>Storage & backup</button><button type="button" class="aw-side-link" data-aw="shortcuts"><span set:html={libraryIcon('spark')}/>Keyboard shortcuts</button></aside>
 <section class="aw-content"><section class="aw-boards-section" aria-label="Your boards"><div class="aw-section-title"><h2>Your inspiration boards</h2><label><span class="sr-only">Sort boards</span><select data-aw-board-sort><option value="manual">Custom order</option><option value="name">Name · A–Z</option><option value="newest">Newest boards</option><option value="count">Most saves</option></select></label></div><div class="aw-boards-grid" data-aw-boards></div></section>
 <div class="aw-collection-heading"><div><p class="aw-eyebrow" data-aw-breadcrumb>YOUR COLLECTION</p><h2 data-aw-title>All saves</h2><p data-aw-description>Every little idea, in one place.</p></div><div class="aw-heading-tools"><button type="button" data-aw="undo" disabled title="Undo organization change" aria-label="Undo organization change"><span set:html={libraryIcon('undo')}/></button><button type="button" data-aw="redo" disabled title="Redo organization change" aria-label="Redo organization change"><span set:html={libraryIcon('redo')}/></button><button type="button" data-aw="board-settings" hidden><span set:html={libraryIcon('settings')}/>Board settings</button></div></div>
 <div class="aw-toolbar"><label class="aw-search"><span set:html={libraryIcon('search')}/><span class="sr-only">Search your artwork, notes, tags and boards</span><input type="search" data-aw-search placeholder="Search your saves…" maxlength="160"/><button type="button" data-aw="clear-search" aria-label="Clear library search" hidden><span set:html={libraryIcon('close')}/></button></label><label class="aw-sort"><span class="sr-only">Sort artwork</span><select data-aw-sort>{sorts.map(([value,label])=><option value={value}>{label}</option>)}</select></label><div class="aw-layout-buttons" role="group" aria-label="Collection layout">{[['masonry','Masonry layout'],['grid','Grid layout'],['list','List layout']].map(([value,label])=><button type="button" data-aw="layout" data-layout={value} aria-label={label} aria-pressed={value==='masonry'} title={label}><span set:html={libraryIcon(value)}/></button>)}</div></div>
 <div class="aw-controls"><button type="button" data-aw="filters" aria-expanded="false" aria-controls="aw-filters"><span set:html={libraryIcon('filter')}/>Filters <b data-aw-filter-count></b></button><button type="button" data-aw="select-mode" aria-pressed="false"><span set:html={libraryIcon('select')}/>Select</button><button type="button" data-aw="display"><span set:html={libraryIcon('settings')}/>Display</button><button type="button" data-aw="export-view"><span set:html={libraryIcon('download')}/>Export this view</button><button type="button" data-aw="reset-filters" hidden>Clear filters</button><span data-aw-result-count></span></div>
 <div class="aw-filter-panel" id="aw-filters" hidden>
  <label>Type<select data-aw-filter="kind"><option value="all">All types</option><option value="project">Saved artwork</option><option value="favorite">Favorite pages</option></select></label>
  <label>Status<select data-aw-filter="status"><option value="all">Any status</option><option value="idea">Idea</option><option value="in-progress">In progress</option><option value="finished">Finished</option></select></label>
  <label>Priority<select data-aw-filter="priority"><option value="all">Any priority</option><option value="high">High</option><option value="normal">Normal</option><option value="low">Low</option></select></label>
  <label>Tag<select data-aw-filter="tag"><option value="">All tags</option></select></label>
  <label>Rating<select data-aw-filter="rating"><option value="0">Any rating</option>{[1,2,3,4,5].map(v=><option value={v}>{v}+ stars</option>)}</select></label>
  <label>Notes<select data-aw-filter="notes"><option value="all">With or without notes</option><option value="with">Has notes</option><option value="without">No notes</option></select></label>
  <label>Shape<select data-aw-filter="orientation"><option value="all">Any shape</option><option value="portrait">Portrait artwork</option><option value="landscape">Landscape artwork</option><option value="square">Square artwork</option></select></label>
  <label>Coloring<select data-aw-filter="painted"><option value="all">All stages</option><option value="colored">Has colors or objects</option><option value="blank">Uncolored artwork</option></select></label>
  <label>Saved<select data-aw-filter="period"><option value="all">Any time</option><option value="today">Today</option><option value="week">Last 7 days</option><option value="month">Last 30 days</option><option value="year">Last year</option></select></label><label>Saved after<input type="date" data-aw-filter="from"/></label><label>Saved before<input type="date" data-aw-filter="to"/></label>
 </div>
 <div class="aw-bulk" data-aw-bulk hidden><strong data-aw-selected>0 selected</strong><button type="button" data-aw="select-all">Select visible</button><button type="button" data-aw="invert-selection">Invert</button><button type="button" data-aw="selection-clear">Clear</button><select data-aw-bulk-action aria-label="Bulk action"><option value="">Choose an action…</option><option value="boards">Add to boards</option><option value="move">Move to a board</option><option value="unfile">Remove from all boards</option><option value="tags">Add tags</option><option value="remove-tags">Remove tags</option><option value="status">Change status</option><option value="priority">Set priority</option><option value="rating">Set rating</option><option value="star">Star</option><option value="unstar">Remove stars</option><option value="archive">Archive</option><option value="unarchive">Unarchive</option><option value="trash">Move to trash</option><option value="restore">Restore from trash</option><option value="export">Export editable backup</option></select><button type="button" data-aw="bulk-apply" class="aw-primary">Apply</button><button type="button" data-aw="exit-selection" aria-label="Exit selection"><span set:html={libraryIcon('close')}/></button></div>
 <p class="aw-status" data-aw-status role="status" aria-live="polite">Opening your collection…</p><div class="aw-cards" data-aw-cards data-layout="masonry" data-density="medium" aria-label="Your saved collection"></div><div class="aw-empty" data-aw-empty hidden><span set:html={libraryIcon('boards')}/><h3 data-aw-empty-title>Your next colorful idea starts here.</h3><p data-aw-empty-copy>Save a page or open a coloring page in Studio to start your collection.</p><a href="/coloring-pages/">Explore coloring pages <span set:html={libraryIcon('arrow')}/></a><button type="button" data-aw="reset-filters">Reset filters</button></div>
 </section></div>
 <dialog class="aw-dialog" data-aw-dialog aria-labelledby="aw-dialog-title"><div class="aw-dialog-header"><h2 id="aw-dialog-title"></h2><button type="button" data-aw="close-dialog" aria-label="Close dialog"><span set:html={libraryIcon('close')}/></button></div><div data-aw-dialog-body></div></dialog>
 <input type="file" data-aw-import accept=".zip,application/zip" hidden/>
</main>
<script>import {mountLibrary} from '../artwork/controller';mountLibrary();</script>
