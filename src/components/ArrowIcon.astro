---
interface Props {kind?:'diagonal'|'right'|'left'|'up';size?:number;}
const {kind='right',size=20}=Astro.props;
const paths={diagonal:'M6 18 18 6M7 6h11v11',right:'M5 12h14m-6-6 6 6-6 6',left:'M19 12H5m6-6-6 6 6 6',up:'M12 19V5m-6 6 6-6 6 6'};
---
<svg class="jc-direction-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d={paths[kind]} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
