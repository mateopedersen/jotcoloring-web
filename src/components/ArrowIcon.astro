---
interface Props {kind?:'diagonal'|'right'|'left'|'up';size?:number}
const {kind='right',size=20}=Astro.props;
const paths={diagonal:'M5 19 19 5M7 5h12v12',right:'M4 12h16m-6-6 6 6-6 6',left:'M20 12H4m6-6-6 6 6 6',up:'M12 20V4m-6 6 6-6 6 6'};
---
<svg class="jc-direction-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d={paths[kind]} stroke="#fff" stroke-opacity=".28" stroke-width="3.3" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 .6)"/><path d={paths[kind]} stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
