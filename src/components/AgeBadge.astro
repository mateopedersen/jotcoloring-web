---
import {ageBand,ageLabel} from '../age/model';
import type {Content} from '../server/types';
import '../age/age.css';
const {item}=Astro.props as {item:Content};const band=ageBand(item.recommendedAge?.band);
---
{band&&<a class="jc-age-badge" data-recommended-age={band.id} href={`/coloring-by-age/${band.id}/`} title="Suggested by drawing detail and coloring-space size."><svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true"><path d="m12 3 2.8 5.7L21 10l-4.5 4.4 1.1 6.2L12 17.7l-5.6 2.9 1.1-6.2L3 10l6.2-1.3L12 3Z" fill="#f7d49f" stroke="#a86b3e" stroke-width="1.4" stroke-linejoin="round"/></svg>{ageLabel(band.id)}</a>}
