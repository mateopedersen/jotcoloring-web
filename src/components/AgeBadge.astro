---
import GlyphIcon from './GlyphIcon.astro';
import {selectFilterURL} from '../ui/filter-url';
import {ageBand,ageLabel} from '../age/model';
import type {Content} from '../server/types';
import '../age/age.css';
import '../age/badge.css';
const {item,currentURL}=Astro.props as {item:Content;currentURL?:string};const band=ageBand(item.recommendedAge?.band);
const scoped=band&&currentURL?selectFilterURL(currentURL,'recommended_age',[band.id]):undefined;
const href=scoped?scoped.pathname+scoped.search+scoped.hash:`/coloring-by-age/${band?.id}/`;
---
{band&&<a class="jc-age-badge" data-recommended-age={band.id} href={href} aria-label={ageLabel(band.id)} title="Suggested by drawing detail and coloring-space size."><span class="jc-age-badge-icon"><GlyphIcon name="star" size={15}/></span><span class="jc-age-badge-copy"><span>Suggested for</span><strong>{band.id==='adults'?'Adults':`Ages ${band.short}`}</strong></span></a>}
