---
import GlyphIcon from './GlyphIcon.astro';
import {ageBand,ageLabel} from '../age/model';
import type {Content} from '../server/types';
import '../age/age.css';
const {item}=Astro.props as {item:Content};const band=ageBand(item.recommendedAge?.band);
---
{band&&<a class="jc-age-badge" data-recommended-age={band.id} href={`/coloring-by-age/${band.id}/`} title="Suggested by drawing detail and coloring-space size."><GlyphIcon name="star" size={15}/>{ageLabel(band.id)}</a>}
