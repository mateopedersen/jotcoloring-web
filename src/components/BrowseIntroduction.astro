---
const {paragraphs,text}=Astro.props as {paragraphs?:readonly string[];text?:string};
const copy=(paragraphs||text?.split(/\n\s*\n/)||[]).map(p=>p.trim()).filter(Boolean);
---
<div class="jc-browse-introduction">{copy.map(paragraph=><p>{paragraph}</p>)}</div>
<style>
 .jc-browse-introduction{width:100%;max-width:none;min-width:0;}
 .jc-browse-introduction p{width:100%;max-width:none;margin:0;color:var(--text-ink,#30261e);font-size:16px;font-weight:500;line-height:1.7;overflow-wrap:break-word;word-break:normal;}
 .jc-browse-introduction p+p{margin-top:12px;}
 @media(max-width:480px){.jc-browse-introduction p{font-size:15px;line-height:1.7;}}
</style>
