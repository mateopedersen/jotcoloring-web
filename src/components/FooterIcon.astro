---
import CreativeIcon from './CreativeIcon.astro';
import ActionIcon from './ActionIcon.astro';
const {name}=Astro.props;
const aliases:Record<string,string>={brush:'studio',heart:'artwork',magic:'ai',document:'license'};
---
<span class="jc-footer-link-icon" aria-hidden="true">{name==='pdf'?<ActionIcon name="pdf" size={40}/>:<CreativeIcon name={aliases[name]||name} size={40}/>}</span>
