---
import VectorIcon from './VectorIcon.astro';
interface Props {name:string;size?:number}
const {name,size=40}=Astro.props;
const aliases:Record<string,string>={brush:'studio',heart:'artwork',magic:'ai',document:'license'};
---
<span class="jc-footer-link-icon" aria-hidden="true"><VectorIcon name={aliases[name]||name} size={size}/></span>
