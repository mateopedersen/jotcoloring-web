---
import ShareArt from './ShareArt.astro';
import SocialMark from './SocialMark.astro';
import Icon from './HomeIcon.astro';
import ActionIcon from './ActionIcon.astro';
import {SHARE_PLATFORMS,SHARE_GROUPS} from '../sharing/platforms';
import '../sharing/sharing.css';
---
<dialog id="jc-share-dialog" class="jc-share-dialog" aria-labelledby="jc-share-heading" data-share-dialog>
 <header class="jc-share-header"><ShareArt size={67}/><div><p>A LITTLE COLOR. PASSED ALONG.</p><h2 id="jc-share-heading" tabindex="-1">Share a coloring page.</h2><span>Send a favorite to a friend or save it for later.</span></div><button type="button" class="jc-share-close" data-share-close aria-label="Close sharing"><Icon name="close" size={22}/></button></header>
 <div class="jc-share-loading" data-share-loading><ShareArt size={84}/><p>Getting your coloring page ready…</p></div>
 <div class="jc-share-layout" data-share-content hidden>
  <aside class="jc-share-preview"><figure><div class="jc-share-paper"><img data-share-image alt="" width="1024" height="1536"/></div><figcaption><span>FOUND ON JOTCOLORING</span><h3 data-share-title></h3><p data-share-description></p></figcaption></figure>
   <button type="button" class="jc-share-image-button" data-share-native-image><ActionIcon name="webp" size={30}/><span data-share-native-label>Prepare image for apps</span><Icon name="arrow" size={17}/></button>
   <button type="button" class="jc-share-png" data-share-save-image><Icon name="download" size={18}/>Save a PNG copy</button>
   <p class="jc-share-image-info" data-share-image-info>A clean, uncolored image. Ready for your next post.</p>
   <a class="jc-share-license" href="/license/"><Icon name="check" size={16}/>Keep the JotColoring credit.<span>Personal &amp; non-commercial educational use.</span></a>
  </aside>
  <section class="jc-share-tools" aria-label="Sharing options">
   <div class="jc-share-link"><label for="jc-share-url">A link to this coloring page</label><div><input id="jc-share-url" data-share-url readonly type="url"/><button type="button" data-share-copy-link><Icon name="link" size={18}/>Copy link</button></div></div>
   <div class="jc-share-picker-heading"><div><h3>Choose where to share</h3><p>Pick a favorite, or explore {SHARE_PLATFORMS.length} apps.</p></div><button type="button" class="jc-share-device" data-share-native-link><Icon name="share" size={18}/>More apps</button></div>
   <div class="jc-share-platforms" data-share-platforms aria-label="Popular sharing apps">{SHARE_PLATFORMS.slice(0,12).map(platform=><button type="button" class="jc-share-platform" data-share-platform={platform.id} aria-pressed="false"><SocialMark platform={platform}/><span>{platform.name}</span></button>)}</div>
   <div class="jc-share-destination" data-share-destination hidden><div><strong data-share-selected-name></strong><span data-share-method></span></div><p data-share-instructions></p><a data-share-open href="#" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><span data-share-open-label></span><Icon name="arrow-up-right" size={18}/></a></div>
   <details class="jc-share-directory" data-share-directory><summary><span><Icon name="grid" size={19}/>All {SHARE_PLATFORMS.length} social networks &amp; apps</span><Icon name="chevron" size={17}/></summary><div class="jc-share-directory-body"><label class="jc-share-search" for="jc-share-search"><Icon name="search" size={19}/><input id="jc-share-search" data-share-search type="search" placeholder="Search Instagram, Discord, Mastodon…" autocomplete="off"/><span class="sr-only">Search sharing apps</span></label><div class="jc-share-groups" aria-label="Filter sharing apps"><button type="button" data-share-group="all" aria-pressed="true">All</button>{SHARE_GROUPS.map(group=><button type="button" data-share-group={group} aria-pressed="false">{group}</button>)}</div><p class="jc-share-result-count" data-share-result-count>{SHARE_PLATFORMS.length} apps</p><div class="jc-share-directory-grid">{SHARE_PLATFORMS.map(platform=><button type="button" class="jc-share-platform jc-share-platform--list" data-share-platform={platform.id} data-share-directory-item aria-pressed="false"><SocialMark platform={platform}/><span>{platform.name}<small>{platform.intent?'Sharing draft':'Copy & open'}</small></span><Icon name="chevron" size={13}/></button>)}</div><p data-share-empty hidden>No apps match. Try another name or choose All.</p></div></details>
   <div class="jc-share-caption"><label for="jc-share-caption">Make the message your own</label><textarea id="jc-share-caption" data-share-caption rows="3" maxlength="1500"></textarea><div class="jc-share-caption-actions"><button type="button" data-share-copy-caption><Icon name="copy" size={18}/>Copy caption + link</button><a data-share-email href="mailto:"><Icon name="mail" size={18}/>Email</a><button type="button" class="jc-share-reset" data-share-reset>Reset</button></div></div>
   <div data-share-manual hidden><label for="jc-share-manual">Select and copy this text</label><textarea id="jc-share-manual" data-share-manual-text readonly rows="4"></textarea></div>
   <p class="jc-share-privacy"><Icon name="check" size={16}/>You choose what gets posted. Nothing is sent when this window opens.</p>
  </section>
 </div>
 <footer class="jc-share-footer"><p data-share-status role="status" aria-live="polite"></p><button type="button" data-share-retry hidden>Try again</button><button type="button" data-share-close>Keep exploring<Icon name="arrow" size={17}/></button></footer>
</dialog>
<script>import {mountSharing} from '../sharing/controller';mountSharing();</script>
