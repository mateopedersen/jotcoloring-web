---
interface Props {kind:string}
const {kind}=Astro.props;
const line=['thin','medium','bold'].includes(kind);
const weight=kind==='thin'?1.5:kind==='medium'?3:5;
const width=kind==='portrait'?31:kind==='square'?39:52;
const height=kind==='portrait'?45:kind==='square'?39:31;
const x=40-width/2,y=30-height/2;
---
<svg class="ai-choice-illustration" viewBox="0 0 80 64" width="80" height="64" fill="none" aria-hidden="true" focusable="false">
 {line?<>
  <rect x="8" y="11" width="65" height="44" rx="9" fill="#e9cbae" opacity=".5"/>
  <rect x="6" y="7" width="65" height="44" rx="9" fill="#fffdf7" stroke="#d9b899"/>
  <path d="M16 34c8-23 17-21 23-5s15 16 22-8" stroke="#322921" stroke-width={weight} stroke-linecap="round" stroke-linejoin="round"/>
 </>:<>
  <ellipse cx="42" cy="57" rx="24" ry="3" fill="#e8d5c2" opacity=".7"/>
  <rect x={x+3} y={y+4} width={width} height={height} rx="4" fill="#e8c6a5"/>
  <rect x={x} y={y} width={width} height={height} rx="4" fill="#fffdf8" stroke="#bd8a60" stroke-width="1.5"/>
  <path d={`M${x+5} ${y+6}h${width-10}`} stroke="#fff" stroke-width="3" stroke-linecap="round"/>
  <path d={`M${x+7} ${y+height-9}h${width-14}M${x+7} ${y+height-5}h${width-20}`} stroke="#ddc0a4" stroke-width="1.4" stroke-linecap="round"/>
  <path d={`M${x+width/2-7} ${y+height/2+2}q7-15 14 0q-7 9-14 0Z`} fill="#ffe4c7" stroke="#ca763c" stroke-width="1.3"/>
 </>}
</svg>
