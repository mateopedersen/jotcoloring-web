---
import CategoryDirectory from '../components/CategoryDirectory.astro';
import CatalogFilters from './CatalogFilters.astro';
import '../styles/catalog-listing.css';
import {categoryById} from '../taxonomy/catalog';
import DifficultyNavigation from '../components/DifficultyNavigation.astro';
import CreatePlayground from '../components/CreatePlayground.astro';
import RelatedCollections from '../components/RelatedCollections.astro';
import AgeNavigation from '../components/AgeNavigation.astro';
import {AGE_BANDS} from '../age/model';
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Icon from '../components/HomeIcon.astro';
import {clearFilterURL} from '../ui/filter-url';
import {displayTitle} from '../ui/titles';
import {createCatalog,parseCatalogQuery} from '../server/catalog';
import {AppError} from '../server/http';
import type {Env,CatalogPage,CatalogQuery} from '../server/types';
const repo=createCatalog(env as unknown as Env);
import type {CatalogLocation} from '../taxonomy/catalog-location';
import {collectionForRoot,collectionPath} from '../taxonomy/navigation';
import {categoryPath} from '../taxonomy/catalog';
import {loadSeriesDirectory} from '../server/series-directory';
import SeriesDirectory from './SeriesDirectory.astro';
import CatalogStream from './CatalogStream.astro';
import {landingIdentity} from '../taxonomy/landing-identity';
import {landingSummary} from '../taxonomy/landing-summary';
import {catalogParameters} from '../taxonomy/catalog-query';
import {catalogAllPath} from '../taxonomy/routes';
import {DIRECTORY_SEO,ALL_PAGES_SEO} from '../seo/catalog-copy';
import {catalogBreadcrumbs} from '../taxonomy/catalog-breadcrumbs';
const {location}=Astro.props as {location:CatalogLocation};
const collection=location.collection,topic=location.topic,number=location.number;
const category=collection?.roots[0]||topic?.parent||topic?.id||(number?'education':'');
const subcategory=topic?.parent?topic.id:number?'numbers':'';
const clearFilters=clearFilterURL(Astro.url.href);
const params=catalogParameters(location,Astro.url.searchParams);
const categoryCountsPromise=repo.categories().catch(()=>[]);
const filtered=[...Astro.url.searchParams.keys()].some(key=>key!=='page');
const categoryCounts=await categoryCountsPromise;
let series:Awaited<ReturnType<typeof loadSeriesDirectory>>=[];
if(!filtered&&!location.allPages)try{series=await loadSeriesDirectory(env as unknown as Env,repo,location,categoryCounts)}catch(e){console.error('Collection directory unavailable',e instanceof Error?e.message:'unknown');}
const directoryMode=series.length>0;
const independentCover=directoryMode?Promise.resolve(series.find(entry=>entry.cover)?.cover||null):number?Promise.resolve(null):(collection?repo.categoryCovers(collection.roots).then(c=>c.find(Boolean)||null):repo.categoryCover(subcategory||category||undefined)).catch(()=>null);
let error='';let result:CatalogPage={items:[],total:0,page:1,page_size:12,total_pages:0,next_cursor:null,has_more:false};let query:CatalogQuery={age:[],difficulty:[],sort:'trending'};
try{query=parseCatalogQuery(params);if(!directoryMode)result=await repo.list(query)}catch(e){const invalid=e instanceof AppError&&e.status<500;error=invalid?e.message:'These coloring pages are temporarily busy. Please try again in a moment.';Astro.response.status=invalid?e.status:503;if(!invalid){Astro.response.headers.set('Retry-After','2');console.error('Catalog request failed',e);}}
const cover=number?result.items[0]||null:await independentCover;
const emptyHref=cover?Astro.url.pathname:subcategory?categoryPath(category):'/coloring-pages/';
const identity=landingIdentity(location);
const heading=query.q?`Coloring pages for “${query.q}”`:identity.heading;
const summary=query.q?`Browse the drawings matching “${query.q}” and narrow your selection with the filters.`:landingSummary(location);
const intro=query.q?'Explore the pages that match your idea. Try another word, choose a theme or adjust the filters to find something you love.':identity.intro;
const directoryRoot=!collection&&!topic&&!number;
const focusedSEO=directoryRoot&&!query.q?(location.allPages?ALL_PAGES_SEO:DIRECTORY_SEO):undefined;

const activeFilters=[...(query.age||[]),...(query.difficulty||[]),...(query.recommended_age?[AGE_BANDS.find(b=>b.id===query.recommended_age)!.label]:[])];
if(number&&!result.total&&!filtered)Astro.response.status=404;
const mainCollection=collection||collectionForRoot(category);
const shortcutTopics=collection?collection.roots.map(categoryById).filter(t=>t&&categoryPath(t.id)!==collectionPath(collection.id)&&categoryCounts.some(c=>c.id===t.id&&c.count>0)):[];
const crumbs=catalogBreadcrumbs(location).map(crumb=>({name:crumb.name,href:crumb.path}));
const paginationTitle=result.page>1?` — Page ${result.page}`:'';
const canonical=Astro.url.pathname+(!filtered&&result.page>1?`?page=${result.page}`:'');
let relatedCollections:Awaited<ReturnType<typeof repo.relatedCollections>>|undefined;
if(!directoryMode&&!error&&!number)try{relatedCollections=await repo.relatedCollections(query,result)}catch(e){console.error('Optional collection recommendations unavailable',e instanceof Error?e.message:'unknown');}
---
<Layout title={focusedSEO?.title||`${heading}${paginationTitle} | JotColoring`} description={focusedSEO?.description||intro} canonical={canonical} socialFallback={cover?.social_image?{src:cover.social_image,alt:`Example from ${heading}: ${cover.alt}`,title:heading,description:intro}:undefined} noindex={filtered||!!error||(!directoryMode&&!result.total)}><Header active={category} search={query.q||''}/>
<main id="main" class="iv-catalog-wrap hv-container jc-catalog-page"><nav class="breadcrumbs" aria-label="Breadcrumb">{crumbs.map((crumb,i)=><>{i>0&&<Icon name="chevron" size={12}/>}<a href={crumb.href} aria-current={i===crumbs.length-1?'page':undefined}>{crumb.name}</a></>)}</nav>
<section class="iv-category-hero iv-category-hero--compact"><span class="jc-collection-symbol" aria-hidden="true"><CategoryIcon name={identity.icon} size={76}/></span><div class="jc-collection-heading"><h1>{query.q?heading:displayTitle(heading)}</h1><a class="jc-view-pages" href={directoryMode?'#collection-series':'#catalog-results'}>{directoryMode?'View Collections':'View Coloring Pages'}<Icon name="arrow" size={17}/></a></div><div class="jc-collection-overview"><p>{summary}</p></div></section>
{!directoryMode&&shortcutTopics.length>0&&<nav class="jc-subject-shortcuts" aria-label="Subjects in this collection">{shortcutTopics.map(t=><a href={categoryPath(t!.id)}><CategoryIcon name={t!.icon} size={24}/>{t!.name}<Icon name="arrow" size={14}/></a>)}</nav>}
<div class="jc-catalog-shell"><section class="iv-catalog-main jc-catalog-results">
{directoryMode?<><SeriesDirectory entries={series} title={category==='education'?(series.every(entry=>entry.number)?'Choose A Number Collection':'Choose A Learning Collection'):'Choose Your Next Collection'}/><nav class="jc-browse-all" aria-label="All drawings in this collection"><a href={catalogAllPath(location.path)}>Browse All Coloring Pages<Icon name="arrow" size={18}/></a></nav></>:<>
<div class="jc-search-result-note" role="status">{result.search_match?.mode==='corrected'&&<>Showing results for <strong>{result.search_match.interpreted}</strong>. Your search: “{query.q}”.</>}{query.q&&result.total>0&&result.search_match?.mode!=='corrected'&&<>Best matches for <strong>“{query.q}”</strong> · {result.total} {result.total===1?'page':'pages'}</>}</div>
<CatalogFilters total={result.total} unavailable={!!error} query={query} category={subcategory||collection?.id||category} currentURL={Astro.url.href} counts={categoryCounts}/>
{activeFilters.length>0&&<div class="iv-active-filters"><span>Showing: {activeFilters.join(' · ')}</span><a href={clearFilters.pathname+clearFilters.search+clearFilters.hash}>Clear filters ×</a></div>}
{error?<div class="empty" role="alert">{error} <a href={Astro.url.pathname+Astro.url.search+'#catalog-results'}>Try Again</a></div>:result.items.length===0?<div class="empty iv-empty"><Icon name="search" size={34}/><h2>A different little adventure?</h2><p>No pages match this selection yet. Try another word or fewer filters.</p><a class="hv-button hv-outline" href={emptyHref}>Explore more pages <Icon name="arrow" size={16}/></a></div>:<div class="catalog-grid jc-catalog-grid">{result.items.map(item=><Card item={item} showCategory={!topic&&!number} filterURL={Astro.url.href}/>)}</div>}
<CatalogStream result={result} source={location.path}/>

<div class="iv-catalog-explore" aria-label="More ways to browse">
<CategoryDirectory counts={categoryCounts} collectionId={mainCollection?.id}/>
<DifficultyNavigation active={query.difficulty} currentURL={Astro.url.href}/><AgeNavigation compact active={query.recommended_age} currentURL={Astro.url.href}/>
</div>
{relatedCollections&&<RelatedCollections result={relatedCollections} query={query}/>}
</>}
</section></div>{!directoryMode&&<CreatePlayground contained/>}</main><script>import '../ui/catalog';import {mountCatalogStream} from '../ui/catalog-stream';mountCatalogStream();</script></Layout>
