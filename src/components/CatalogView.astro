---
import CategoryDirectory from '../components/CategoryDirectory.astro';
import CategoryFacts from '../components/CategoryFacts.astro';
import {categoryById} from '../taxonomy/catalog';
import DifficultyNavigation from '../components/DifficultyNavigation.astro';
import {DIFFICULTY_LEVELS,difficultyLabel} from '../age/difficulty';
import CreatePlayground from '../components/CreatePlayground.astro';
import RelatedCollections from '../components/RelatedCollections.astro';
import AgeNavigation from '../components/AgeNavigation.astro';
import {AGE_BANDS} from '../age/model';
import ArrowIcon from '../components/ArrowIcon.astro';
import {env} from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Card from '../components/Card.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Icon from '../components/HomeIcon.astro';
import FileActions from '../components/FileActions.astro';
import {clearFilterURL} from '../ui/filter-url';
import {animalCategories,coloringTopic} from '../ui/categories';
import {categoryCopy,animalCopy} from '../ui/category-copy';
import {displayTitle} from '../ui/titles';
import {createCatalog,parseCatalogQuery} from '../server/catalog';
import type {Env,CatalogPage,CatalogQuery} from '../server/types';
const repo=createCatalog(env as unknown as Env);
import type {CatalogLocation} from '../taxonomy/catalog-location';
import {NAVIGATION_COLLECTIONS,collectionForRoot,collectionPath} from '../taxonomy/navigation';
import {categoryPath} from '../taxonomy/catalog';
import {canonicalNumberSubject} from '../taxonomy/number-topics';
import NumberTopicDirectory from './NumberTopicDirectory.astro';
import {landingIdentity} from '../taxonomy/landing-identity';
const {location}=Astro.props as {location:CatalogLocation};
const collection=location.collection,topic=location.topic,number=location.number;
const category=collection?.roots[0]||topic?.parent||topic?.id||(number?'education':'');
const subcategory=topic?.parent?topic.id:number?'numbers':'';
const animal=category==='animals'&&!number;
const categoryInfo=collection||(category?categoryById(category):undefined);
const clearFilters=clearFilterURL(Astro.url.href);
const params=new URLSearchParams(Astro.url.search);if(collection){params.delete('category');params.delete('subcategory');params.set('collection',collection.id);}else{if(category)params.set('category',category);if(subcategory)params.set('subcategory',subcategory);}if(number)params.set('number',String(number.number));params.set('limit',animal?'6':'12');
let error='';let result:CatalogPage={items:[],total:0,page:1,page_size:12,total_pages:0,next_cursor:null,has_more:false};let query:CatalogQuery={age:[],difficulty:[],sort:'trending'};
try{query=parseCatalogQuery(params);result=await repo.list(query)}catch(e){error=e instanceof Error?e.message:'The catalog could not be loaded.';Astro.response.status=400;}
let samples:(import('../server/types').Content|null)[]=[];
const selected=result.items[0];
let cover=null;
try{
 if(animal){const visuals=await repo.categoryCovers([...animalCategories.map(c=>c.id),subcategory||category]);samples=visuals.slice(0,-1);cover=visuals.at(-1)||null;}
 else cover=number?result.items[0]||null:collection?(await repo.categoryCovers(collection.roots)).find(Boolean)||null:await repo.categoryCover(subcategory||category||undefined);
}catch{/* The collection still renders if its decorative artwork is unavailable. */}
const emptyHref=cover?Astro.url.pathname:subcategory?categoryPath(category):'/coloring-pages/';
const identity=landingIdentity(location);
const heading=query.q?`Coloring pages for “${query.q}”`:identity.heading;
const intro=query.q?'Explore the pages that match your idea. Try another word, choose a theme or adjust the filters to find something you love.':identity.intro;
const pageHref=(page:number)=>{const p=new URLSearchParams(Astro.url.search);p.set('page',String(page));return `${Astro.url.pathname}?${p}#catalog-results`};
const activeFilters=[...(query.age||[]),...(query.difficulty||[]),...(query.recommended_age?[AGE_BANDS.find(b=>b.id===query.recommended_age)!.label]:[])];
const filtered=[...Astro.url.searchParams.keys()].some(key=>key!=='page');
if(number&&!result.total&&!filtered)Astro.response.status=404;
const numberCounts=category==='education'?(await (env as unknown as Env).CATALOG_DB!.prepare("SELECT ("+canonicalNumberSubject()+") AS number,COUNT(*) AS count FROM content c WHERE c.status='published' AND c.active_version IS NOT NULL AND EXISTS(SELECT 1 FROM content_category cc WHERE cc.content_id=c.id AND cc.category_id='numbers') GROUP BY number").all<{number:string;count:number}>()).results:[];
const mainCollection=collection||collectionForRoot(category);
const crumbs=[{name:'Home',href:'/'},{name:'Coloring pages',href:'/coloring-pages/'},...(mainCollection?[{name:mainCollection.name,href:collectionPath(mainCollection.id)}]:[]),...(topic?[{name:topic.name,href:categoryPath(topic.id)}]:[]),...(number?[{name:'Numbers & Counting',href:categoryPath('numbers')},{name:number.name,href:number.path}]:[])];
const paginationTitle=result.page>1?` — Page ${result.page}`:'';
const canonical=Astro.url.pathname+(!filtered&&result.page>1?`?page=${result.page}`:'');
const relatedCollections=!error&&!number?await repo.relatedCollections(query,result):undefined;
---
<Layout title={`${heading}${paginationTitle} — JotColoring`} description={intro} canonical={canonical} socialFallback={cover?.social_image?{src:cover.social_image,alt:`Example from ${heading}: ${cover.alt}`,title:heading,description:intro}:undefined} noindex={filtered||!!error||!result.total}><Header active={category} search={query.q||''}/>
<main id="main" class="iv-catalog-wrap hv-container"><nav class="breadcrumbs" aria-label="Breadcrumb">{crumbs.map((crumb,i)=><>{i>0&&<Icon name="chevron" size={12}/>}<a href={crumb.href} aria-current={i===crumbs.length-1?'page':undefined}>{crumb.name}</a></>)}</nav>
<section class="iv-category-hero"><div><p class="hv-kicker">{categoryInfo?'A LITTLE WORLD TO MAKE YOUR OWN':'THE JOTCOLORING COLLECTION'}</p><h1>{query.q?heading:displayTitle(heading)}</h1><p class="iv-category-intro">{intro}</p><CategoryFacts/></div><div class="iv-category-art" aria-hidden="true"><span class="iv-cover-orbit"></span>{cover?<img src={cover.thumbnail} srcset={cover.thumbnailSrcset} sizes="300px" loading="lazy" alt="" width="300" height="300" decoding="async" fetchpriority="high"/>:<span class="iv-cover-placeholder"><CategoryIcon name={subcategory||category||'all'} size={100}/></span>}<span class="iv-cover-badge"><CategoryIcon name={subcategory||category||'all'} size={32}/></span><span class="iv-cover-caption">Your next canvas.<Icon name="brush" size={14}/></span></div></section>
<CategoryDirectory counts={await repo.categories()} collectionId={mainCollection?.id}/>{category==='education'&&<NumberTopicDirectory counts={numberCounts} active={number?.number}/> }
<div class="browse-shell iv-browse-shell"><Sidebar animal={animal} category={category} active={subcategory} age={query.age||[]} difficulty={query.difficulty||[]}/><section class:list={['main-content','iv-catalog-main',animal&&'animals-page']}><DifficultyNavigation active={query.difficulty} currentURL={Astro.url.href}/><AgeNavigation compact active={query.recommended_age}/>
{animal&&<div class="iv-themes"><div class="iv-small-heading"><h2>Follow your favorite creatures</h2><span>Explore an animal theme</span></div><div class="subcategory-strip">{animalCategories.map((c,i)=><a class:list={[subcategory===c.id&&'is-active']} href={categoryPath(c.id)}>{samples[i]?<img loading="lazy" decoding="async" src={samples[i]!.thumbnail} srcset={samples[i]!.thumbnailSrcset} sizes="auto, 180px" alt={samples[i]!.alt} width="180" height="150"/>:<span class="iv-theme-placeholder" aria-hidden="true"><CategoryIcon name={c.id} size={54}/></span>}<strong>{c.name}</strong></a>)}</div></div>}
<div class="jc-search-result-note" role="status">{result.search_match?.mode==='corrected'&&<>Showing results for <strong>{result.search_match.interpreted}</strong>. Your search: “{query.q}”.</>}{query.q&&result.total>0&&result.search_match?.mode!=='corrected'&&<>Best matches for <strong>“{query.q}”</strong> · {result.total} {result.total===1?'page':'pages'}</>}</div>
<form class="filter-bar iv-filter-bar" id="catalog-filters" action={Astro.url.pathname}>{query.q&&<input type="hidden" name="q" value={query.q}/>}<div class="iv-filter-label"><Icon name="grid" size={16}/><strong id="catalog-results">{result.total} {result.total===1?'page':'pages'}</strong></div><label class="sr-only" for="category-filter">Category</label><select id="category-filter" name="category" data-filter-select><option value="">All categories</option>{NAVIGATION_COLLECTIONS.map(c=><option value={c.id} selected={mainCollection?.id===c.id}>{c.name}</option>)}</select><label class="sr-only" for="age-filter">Recommended age</label><select id="age-filter" name="recommended_age" data-filter-select><option value="">All recommended ages</option>{AGE_BANDS.map(a=><option value={a.id} selected={query.recommended_age===a.id}>{a.label}</option>)}</select><label class="sr-only" for="difficulty-filter">Difficulty</label><select id="difficulty-filter" name="difficulty" data-filter-select><option value="">All levels</option>{DIFFICULTY_LEVELS.map(d=><option value={d.id} selected={query.difficulty?.includes(d.id)}>{d.label}</option>)}</select><label class="sr-only" for="sort-filter">Sort pages</label><select class="sort-select" id="sort-filter" name="sort" data-filter-select><option value="trending" selected={query.sort==='trending'}>{query.q?'Best matches':'Featured first'}</option><option value="newest" selected={query.sort==='newest'}>Newest first</option><option value="title" selected={query.sort==='title'}>A–Z</option></select><button type="submit" class="jc-apply-filters" data-apply-filters>Apply filters</button></form>
{activeFilters.length>0&&<div class="iv-active-filters"><span>Showing: {activeFilters.join(' · ')}</span><a href={clearFilters.pathname+clearFilters.search+clearFilters.hash}>Clear filters ×</a></div>}
{error?<div class="empty" role="alert">{error} <a href="/coloring-pages/">Reset filters</a></div>:result.items.length===0?<div class="empty iv-empty"><Icon name="search" size={34}/><h2>A different little adventure?</h2><p>No pages match this selection yet. Try another word or fewer filters.</p><a class="hv-button hv-outline" href={emptyHref}>Explore more pages <Icon name="arrow" size={16}/></a></div>:<div class:list={[animal&&'animals-results']}><div class:list={['catalog-grid',animal&&'animal-grid']}>{result.items.map((item,i)=><Card item={item} quick={animal} selected={animal&&i===0} showCategory/>)}</div>{animal&&selected&&<aside class="quick-preview" id="quick-preview" aria-label="Quick preview"><div class="iv-small-heading"><h2>Quick preview</h2><Icon name="search" size={17}/></div><p class="jc-preview-status" data-preview-status role="status" hidden></p><div data-preview-body><img loading="lazy" decoding="async" src={selected.preview} alt={selected.alt} width="512" height="512"/><h3>{selected.title}</h3><div class="badges"><span class="badge">{selected.categoryName}</span><span class="badge">{difficultyLabel(selected.difficulty)}</span></div><a class="button primary wide" href={`/studio/?page=${selected.id}`}><Icon name="brush" size={18}/>Color in Studio <Icon name="arrow" size={16}/></a><FileActions item={selected} variant="preview"/></div><p data-preview-error role="alert" hidden></p><p class="iv-preview-note">Your download is a clean, uncolored page.</p></aside>}</div>}
{result.total_pages>1&&<nav class="pagination" aria-label="Pagination">{result.page>1?<a href={pageHref(result.page-1)} aria-label="Previous page"><ArrowIcon kind="left" size={18}/></a>:<span aria-disabled="true"><ArrowIcon kind="left" size={18}/></span>}{Array.from({length:Math.min(result.total_pages,100)},(_,i)=>i+1).filter(p=>p===1||p===result.total_pages||Math.abs(p-result.page)<=2).map(p=><a class:list={[p===result.page&&'active']} aria-current={p===result.page?'page':undefined} href={pageHref(p)}>{p}</a>)}{result.has_more&&<a href={pageHref(result.page+1)} aria-label="Next page"><ArrowIcon kind="right" size={18}/></a>}</nav>}
{category&&<section class="iv-category-note"><span><CategoryIcon name={category} size={29}/></span><div><h2>Make this collection your own.</h2><p>{categoryCopy[category].note}</p></div><a href="/studio/" class="hv-text-link">Try Studio <Icon name="arrow" size={16}/></a></section>}
{relatedCollections&&<RelatedCollections result={relatedCollections} query={query}/>}
</section></div><CreatePlayground contained/></main><script>import '../ui/catalog';</script></Layout>
