---
import {COLORING_TAXONOMY,categoryPath} from '../taxonomy/catalog';
import SearchIcon from './SearchIcon.astro';
import Icon from './HomeIcon.astro';
interface Props {variant?:'hero'|'header';value?:string;idPrefix?:string;action?:string;recommendedAge?:string}
const {variant='header',value='',idPrefix,action='/coloring-pages/',recommendedAge}=Astro.props;
const inputId=idPrefix?`${idPrefix}-search`:variant==='hero'?'home-search':'site-search',listId=`${inputId}-suggestions`;
---
<form class:list={['jc-search-shell',variant==='hero'?'hv-search':'jc-header-search']} action={action} method="get" role="search" data-search-form data-category-options={JSON.stringify(COLORING_TAXONOMY.map(({id,name,aliases})=>({id,name,aliases,href:categoryPath(id)})))} data-recommended-age={recommendedAge}>
 <SearchIcon size={variant==='hero'?48:38}/><label class="sr-only" for={inputId}>Search coloring pages</label>
 <input id={inputId} name="q" type="search" value={value} maxlength="160" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="search" enterkeyhint="search" placeholder="Search pages…"/>
 <button type="button" class="jc-search-clear" data-search-clear aria-label="Clear search" hidden><Icon name="close" size={17}/></button>
 <button type="submit" class="jc-search-submit" aria-label="Search coloring pages"><span class="jc-search-label">Search</span><Icon name="arrow" size={18}/></button>
 <div class="jc-search-panel" data-search-panel hidden><p class="jc-search-panel-status" data-search-status role="status" aria-live="polite"></p><div id={listId} class="jc-search-options" role="listbox" aria-label="Coloring page suggestions"></div></div>
</form>

<style>
/* Keep space for the query in every place this shared form is used. */
form.jc-search-shell {
 container-type:inline-size;
 gap:8px;
}
form.jc-search-shell > .jc-search-icon {
 width:38px;
 height:38px;
}
form.jc-search-shell input[type=search] {
 flex:1 1 0;
 min-width:0;
 width:0;
 font-family:'Avenir Next',Avenir,'Manrope Variable',Arial,sans-serif;
 font-size:16px;
 font-weight:550;
 line-height:1.4;
 padding-block:12px;
}
form.jc-search-shell .jc-search-submit {
 min-height:48px;
 padding:11px 16px;
 gap:8px;
 font-family:'Manrope Variable','Avenir Next',Avenir,sans-serif;
 font-size:14px;
 font-weight:700;
 line-height:1.4;
}
form.jc-search-shell .jc-search-submit > svg {
 flex:none;
 width:18px;
 height:18px;
}
@container (max-width:340px) {
 form.jc-search-shell > .jc-search-icon { width:32px;height:32px; }
 form.jc-search-shell .jc-search-submit { padding-inline:12px; }
 form.jc-search-shell .jc-search-submit > svg { display:none; }
}
</style>
