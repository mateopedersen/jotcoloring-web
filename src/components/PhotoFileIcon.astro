---
const {format='webp',size=56}=Astro.props;
const id=`photo-file-${crypto.randomUUID()}`,styles={pdf:['#ffc07f','#ef7838','#a6492b','PDF'],webp:['#abddbc','#65ae9b','#397c73','IMG'],png:['#c3bded','#9c83cd','#694e98','PNG'],jpeg:['#a9cfe2','#6aa6c4','#396d8e','JPG'],svg:['#e2b7e7','#bc82bd','#855483','SVG'],docx:['#a0c8f0','#6191d1','#325e9a','DOC']};
const s=styles[format as keyof typeof styles]||styles.webp;
---
<svg class="jc-photo-file-icon" width={size} height={size} viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id={`${id}-paper`} x1="22" y1="8" x2="75" y2="84" gradientUnits="userSpaceOnUse"><stop stop-color="white"/><stop offset=".6" stop-color="#fff8ee"/><stop offset="1" stop-color="#dbc4ac"/></linearGradient><linearGradient id={`${id}-badge`} x1="16" y1="39" x2="67" y2="80" gradientUnits="userSpaceOnUse"><stop stop-color={s[0]}/><stop offset=".45" stop-color={s[1]}/><stop offset="1" stop-color={s[2]}/></linearGradient><linearGradient id={`${id}-fold`} x1="54" y1="11" x2="75" y2="28" gradientUnits="userSpaceOnUse"><stop stop-color="#fffdf5"/><stop offset="1" stop-color="#d6b89c"/></linearGradient></defs>
 <ellipse cx="48" cy="87" rx="34" ry="5" fill="#6b4129" opacity=".14"/><path d="M25 11h31l20 20v47q0 7-7 7H25q-7 0-7-7V18q0-7 7-7Z" fill="#b78660" opacity=".28"/><path d="M22 8h31l20 20v47q0 7-7 7H22q-7 0-7-7V15q0-7 7-7Z" fill={`url(#${id}-paper)`} stroke="#cba787" stroke-width="1.7"/><path d="M53 8v14q0 6 6 6h14" fill={`url(#${id}-fold)`} stroke="#cba787" stroke-width="1.7"/><path d="M21 15h27" stroke="white" stroke-width="2" stroke-linecap="round"/>
 {format==='svg'?<><path d="M27 39c8-22 22 21 34-5" stroke={s[2]} stroke-width="2.3" stroke-linecap="round"/><path d="m27 39 2-13m32 8-1 13" stroke={s[1]} stroke-width="1.1"/><circle cx="27" cy="39" r="3.4" fill="white" stroke={s[2]} stroke-width="1.6"/><circle cx="61" cy="34" r="3.4" fill="white" stroke={s[2]} stroke-width="1.6"/><rect x="27" y="24" width="4" height="4" rx="1" fill={s[1]}/><rect x="58" y="45" width="4" height="4" rx="1" fill={s[1]}/></>:format==='docx'?<><path d="M27 34h23m-23 5h31m-31 5h26" stroke={s[1]} stroke-width="2.5" stroke-linecap="round"/></>:format==='pdf'?<><path d="M27 34h22m-22 7h30" stroke="#dcc5ac" stroke-width="2.4" stroke-linecap="round"/><path d="M43 29c-1 13-9 16-8 12s18-4 17-1-11-15-9-11Z" stroke="#cd9d75" stroke-width="1.3"/></>:<><rect x="25" y="31" width="36" height="20" rx="3" fill={s[0]} opacity=".65"/><circle cx="51" cy="36" r="3.5" fill="#ffe5a6"/><path d="m26 48 10-12 10 10 6-6 9 9v2H26Z" fill={s[1]}/><path d="m36 36 4 5-4-1-4 1Z" fill="#fff7e7"/></>}
 <rect x="10" y="55" width="63" height="24" rx="6" fill={s[2]} opacity=".2"/><rect x="8" y="51" width="63" height="24" rx="6" fill={`url(#${id}-badge)`} stroke={s[2]} stroke-width="1.4"/><path d="M14 54h50" stroke="white" opacity=".55" stroke-width="2" stroke-linecap="round"/><text x="39.5" y="68" text-anchor="middle" fill="white" font-family="system-ui,sans-serif" font-weight="850" font-size="14" letter-spacing=".6">{s[3]}</text><path d="M26 79h31" stroke="#fff7e9" stroke-width="1.4" stroke-linecap="round"/>
</svg>
