---
import {ageBand,type AgeBand} from '../age/model';
const {band,size=62}=Astro.props as {band:AgeBand;size?:number};const item=ageBand(band)!,id=`age-${crypto.randomUUID()}`;
---
<svg class="jc-age-icon" width={size} height={size} viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id={id} x1="15" y1="5" x2="80" y2="85" gradientUnits="userSpaceOnUse"><stop stop-color="#fffef8"/><stop offset="1" stop-color="#f0dac1"/></linearGradient></defs><ellipse cx="49" cy="85" rx="31" ry="5" fill="#805533" opacity=".15"/><rect x="20" y="13" width="58" height="69" rx="12" fill="#b99776" opacity=".5" transform="rotate(7 49 48)"/><rect x="14" y="8" width="60" height="71" rx="12" fill={`url(#${id})`} stroke="#d7b595" stroke-width="1.5"/><path d="M25 18h35" stroke="#fff" stroke-width="3" stroke-linecap="round"/><circle cx="44" cy="42" r="21" fill={item.color}/><path d="M30 29q7-7 18-4" stroke="white" stroke-opacity=".35" stroke-width="3" stroke-linecap="round"/>{band==='adults'?<g stroke="#fff" stroke-width="1.6"><circle cx="44" cy="42" r="7"/><ellipse cx="44" cy="42" rx="15" ry="6"/><ellipse cx="44" cy="42" rx="15" ry="6" transform="rotate(60 44 42)"/><ellipse cx="44" cy="42" rx="15" ry="6" transform="rotate(120 44 42)"/><circle cx="44" cy="42" r="2" fill="#fff"/></g>:<text x="44" y="48" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size={band==='13-17'?14:18} font-weight="800">{item.short}</text>}<path d="M28 69h30" stroke="#dbc4ad" stroke-width="3" stroke-linecap="round"/><path d="m64 60 15-34 7 3-15 34-8 6 1-9Z" fill="#ed8b42" stroke="#a4562e" stroke-width="1.2"/><path d="m67 58 13-28" stroke="#ffd6a3" stroke-width="2"/><path d="m64 60 7 3-8 6Z" fill="#f4d1a8"/><path d="m63 66 3 1-3 2Z" fill="#553c2e"/></svg>
