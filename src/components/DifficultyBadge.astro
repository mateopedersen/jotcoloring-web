---
import {DIFFICULTY_LEVELS} from '../age/difficulty';
import type {Content} from '../server/types';
const {item,overlay=false,large=false}=Astro.props as {item:Content;overlay?:boolean;large?:boolean};
const index=DIFFICULTY_LEVELS.findIndex(d=>d.id===item.difficulty),level=DIFFICULTY_LEVELS[index];
---
{level&&<a class:list={['jc-detail-badge',overlay&&'jc-detail-badge-overlay',large&&'jc-detail-badge-large']} style={`--detail-color:${level.color}`} href={`/coloring-pages/${item.category?item.category+'/':''}?difficulty=${level.id}`} data-detail-level={level.id} title={`Suggested detail level: ${level.label}. ${level.description}`}><span class="jc-detail-meter" aria-hidden="true">{[0,1,2,3].map(i=><i class:list={[i<=index&&'filled']}/>)}</span>{large&&<small>Detail level</small>}<strong>{level.label}</strong></a>}
<style>
.jc-detail-badge{display:inline-flex;align-items:center;gap:5px;background:#fffef8f5;border:1px solid #e7dfd0;border-radius:8px;padding:5px 7px;color:var(--detail-color);text-decoration:none;box-shadow:0 2px 5px #62421d08;max-width:100%;line-height:1.25}.jc-detail-badge strong{font-size:10px;font-weight:850;white-space:nowrap}.jc-detail-meter{display:flex;gap:2px;align-items:flex-end;height:11px;flex:none}.jc-detail-meter i{display:block;background:#e0dfd4;width:3px;height:5px;border-radius:1px}.jc-detail-meter i:nth-child(2){height:7px}.jc-detail-meter i:nth-child(3){height:9px}.jc-detail-meter i:nth-child(4){height:11px}.jc-detail-meter .filled{background:var(--detail-color)}.jc-detail-badge-overlay{position:absolute;top:11px;left:11px;z-index:3}.jc-detail-badge-large{padding:8px 11px;gap:8px;margin:0 0 17px}.jc-detail-badge-large strong{font-size:13px}.jc-detail-badge-large small{font-size:11px;color:var(--text-ink, #000);font-weight:700}.jc-detail-badge:hover{border-color:var(--detail-color)}@media(max-width:600px){.jc-detail-badge-overlay{top:8px;left:8px;padding:4px 6px}.jc-detail-badge-overlay strong{font-size:9px}}
</style>
