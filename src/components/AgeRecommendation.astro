---
import GlyphIcon from './GlyphIcon.astro';
import {ageBand} from '../age/model';
import AgeIcon from './AgeIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
import type {Content} from '../server/types';
import '../age/age.css';
const {item}=Astro.props as {item:Content};const band=ageBand(item.recommendedAge?.band);
const reasons={'3-5':'Broad coloring spaces and fewer details make this an easier place to start.','6-8':'A few more shapes and manageable spaces offer a little more variety.','9-12':'This drawing includes smaller coloring areas and a richer mix of details.','13-17':'Fine lines and many smaller spaces suit a more patient coloring session.',adults:'Many small spaces and fine decorative lines make this a more intricate coloring page.'};
---
{band&&<section class="jc-age-recommendation" aria-label="Recommended age" data-recommended-age={band.id}><div class="jc-age-recommendation-main"><AgeIcon band={band.id} size={66}/><div><p>RECOMMENDED AGE</p><strong>{band.id==='adults'?'Adult coloring':`Ages ${band.short}`}</strong><span>{band.id==='adults'?'Intricate detail':band.id==='13-17'?'Detailed coloring':band.id==='9-12'?'A little more detail':band.id==='6-8'?'Moderate detail':'Big, simple spaces'}</span></div><a href={`/coloring-by-age/${band.id}/`} aria-label={`Explore coloring pages for ${band.label.toLowerCase()}`}><span>See similar pages</span><ArrowIcon kind="right" size={18}/></a></div><details><summary>Why this age recommendation?<GlyphIcon name="down" size={16}/></summary><p>{reasons[band.id]} This is a suggested starting age, based on the size of the coloring spaces and the amount of detail. {band.group==='kids'?'Start with the bigger shapes; the smaller details are optional. Older colorists can enjoy it, too.':'Choose what feels comfortable for your interests and experience.'}</p></details></section>}
