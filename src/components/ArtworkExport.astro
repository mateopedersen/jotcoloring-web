---
import ArrowIcon from '../components/ArrowIcon.astro';
import ActionIcon from './ActionIcon.astro';
const {projectId=''}=Astro.props;
---
<main id="main" class="artwork-export" data-project-id={projectId}>
  <div class="export-breadcrumb"><span><a data-studio-link href="/studio/">Studio</a>&nbsp; /&nbsp; Download</span><a data-studio-link href="/studio/"><ArrowIcon kind="left" size={18}/>&nbsp; Back to Studio</a></div>
  <div class="export-layout"><div class="export-preview"><canvas data-export-canvas aria-label="Preview of your current artwork"></canvas></div>
    <section class="export-form"><p class="export-eyebrow" data-export-eyebrow>OPENING YOUR ARTWORK</p><h1>Your artwork is ready.</h1><p class="export-subtitle">Take your colors with you.</p>
      <form data-export-form>
        <label class="field-label" for="artwork-filename">Filename</label><input id="artwork-filename" name="filename" type="text" maxlength="100" value="my-artwork-colored" required />
        <fieldset class="export-formats"><legend>Format</legend><label><input type="radio" name="format" value="pdf" checked /><span class="format-tile"><i><ActionIcon name="pdf" size={36}/></i><strong>PDF</strong><small>Ready to print</small><b aria-hidden="true">✓</b></span></label><label><input type="radio" name="format" value="webp" /><span class="format-tile"><i><ActionIcon name="webp" size={36}/></i><strong>Image</strong><small>Digital image</small><b aria-hidden="true">✓</b></span></label></fieldset>
        <div class="paper-fields"><label for="artwork-paper">Paper size<select id="artwork-paper" name="paper"><option value="a4">A4 (210 × 297 mm)</option></select></label><label for="artwork-orientation">Orientation<select id="artwork-orientation" name="orientation"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></label></div><p class="pdf-only" data-pdf-only hidden>PDF only. WEBP keeps your artwork’s original pixel size and orientation.</p>
        <label class="outline-option"><input type="checkbox" name="outline" /><span>Include the original outline page<small>Get both the colored artwork and the black & white outline version in your download.</small></span><img data-outline-thumbnail alt="Original uncolored outline" width="100" height="120" hidden /></label>
        <p data-package-hint class="package-hint">PDF files are limited to 1 MB. Artwork proportions are preserved.</p><button class="export-submit" type="submit" disabled>⇩&nbsp; Download artwork</button><div class="export-status" data-export-status role="status" aria-live="polite">Loading your saved project…</div><p class="export-file-details" data-file-details></p>
        <button type="button" data-print-preview class="print-preview-button" disabled>Open PDF print preview</button><a data-print-link class="print-link" target="_blank" rel="noopener" hidden>Open your PDF print preview</a>
      </form><a class="keep-coloring" data-studio-link href="/studio/"><ArrowIcon kind="left" size={18}/>&nbsp; Keep coloring</a>
    </section>
  </div>
</main>
<script>import {mountExport} from '../studio/export-controller';mountExport();</script>
<style>
.artwork-export{padding:20px 32px 30px;color:#252531}.export-breadcrumb{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;font-size:15px;color:#667085}.export-breadcrumb a,.keep-coloring{color:#d54d0c;text-decoration:none}.export-layout{display:grid;grid-template-columns:1.45fr 1fr;gap:18px;align-items:stretch}.export-preview,.export-form{border:1px solid #e1e5eb;border-radius:9px;background:#fff;box-shadow:0 2px 6px #00000004}.export-preview{padding:18px;display:flex;justify-content:center;align-items:center;min-height:550px}.export-preview canvas{max-width:100%;max-height:calc(100vh - 215px);width:auto;height:auto;object-fit:contain}.export-form{padding:30px 32px}.export-eyebrow{color:#e6520e;font-size:14px;letter-spacing:.3px;margin:0 0 20px}.export-form h1{font-size:38px;line-height:1.1;font-family:'Outfit Variable',sans-serif;font-weight:900;letter-spacing:-1.1px;margin:0 0 6px}.export-subtitle{font-size:27px;line-height:1.25;margin:0 0 32px}.field-label,.export-form legend,.paper-fields>label{font-weight:700;font-size:16px}.export-form input[type=text],.export-form select{width:100%;font:inherit;border:1px solid #cfd5df;border-radius:6px;background:#fff;color:#252531;padding:13px 17px;min-height:48px;margin-top:7px}.export-formats{border:0;padding:0;margin:24px 0;display:grid;grid-template-columns:1fr 1fr;gap:14px}.export-formats legend{margin-bottom:10px}.export-formats>label{position:relative}.export-formats input{position:absolute;width:1px;height:1px;opacity:0}.format-tile{min-height:156px;border:1px solid #e1e5eb;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;cursor:pointer;position:relative}.format-tile i{font-style:normal;font-size:42px;color:#60616c}.format-tile strong{font-size:19px}.format-tile small{font-size:15px;color:#6b7384}.format-tile b{display:none;position:absolute;top:10px;right:10px;color:white;background:#ff681b;border-radius:50%;width:26px;height:26px;text-align:center;line-height:26px}.export-formats input:checked+.format-tile{border-color:#ff681b;background:#fff7f1}.export-formats input:checked+.format-tile i{color:#fb5c10}.export-formats input:checked+.format-tile b{display:block}.export-formats input:focus-visible+.format-tile{outline:3px solid #005ec4;outline-offset:3px}.paper-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.export-form select:disabled{background:#f3f4f6;color:#737b8b}.pdf-only,.package-hint{font-size:12px;color:#647084;line-height:1.45}.outline-option{border-top:1px solid #e1e5eb;margin-top:28px;padding-top:23px;display:flex;align-items:center;gap:12px;font-size:16px;line-height:1.4}.outline-option input{width:20px;height:20px;accent-color:#ff681b;flex-shrink:0}.outline-option span{flex:1}.outline-option small{display:block;font-size:13px;line-height:1.6;color:#677185;margin-top:5px}.outline-option img{object-fit:contain;max-width:100px;max-height:120px;border:1px solid #e1e5eb;border-radius:5px;padding:4px}.export-submit{width:100%;border:1px solid #ff6417;background:linear-gradient(120deg,#ff782d,#fa5c14);color:#fff;border-radius:7px;font:inherit;font-size:22px;font-weight:700;min-height:62px;cursor:pointer;margin-top:12px}.export-submit:disabled{opacity:.5;cursor:not-allowed}.export-status{font-size:13px;margin-top:10px;line-height:1.5;color:#525e73}.export-status[role=alert]{color:#ad2a19}.export-file-details{font-size:12px;color:#657087}.keep-coloring{display:block;text-align:center;font-size:17px;margin-top:22px}.print-preview-button{background:none;border:0;color:#c24c14;font:inherit;font-size:13px;cursor:pointer;margin-top:5px}.print-preview-button:disabled{color:#737b8b;cursor:not-allowed}.print-link{font-size:13px;color:#b24314;display:block;margin-top:8px}.print-link[hidden]{display:none}
@media(max-width:1000px){.export-form{padding:24px}.export-form h1{font-size:31px}.export-subtitle{font-size:21px}.outline-option img{max-width:65px}.artwork-export{padding:18px}.format-tile{min-height:125px}}
@media(max-width:700px){.artwork-export{padding:12px}.export-layout{grid-template-columns:1fr}.export-preview{min-height:0;padding:12px}.export-preview canvas{max-height:60vh}.export-form{padding:24px 18px}.export-form h1{font-size:31px}.export-subtitle{margin-bottom:24px}.export-breadcrumb{font-size:12px}.export-submit{font-size:19px;min-height:54px}.paper-fields{gap:10px}.export-form select{font-size:13px;padding:10px}.outline-option{font-size:14px}.outline-option small{font-size:12px}.export-formats{margin:20px 0}}
@media(min-width:1001px){.export-form{padding:26px 32px 20px}.export-eyebrow{margin-bottom:16px}.export-subtitle{margin-bottom:24px}.export-formats{margin:20px 0}.format-tile{min-height:140px}.outline-option{margin-top:20px;padding-top:16px}.outline-option img{max-height:100px}.package-hint{margin:8px 0}.export-submit{min-height:56px;margin-top:6px}.export-status{margin-top:6px;font-size:12px}.export-file-details:empty{display:none}.print-preview-button{margin-top:2px;font-size:12px}.keep-coloring{margin-top:14px}}
</style>
