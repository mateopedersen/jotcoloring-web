---
import Compare from './Compare.astro';
import ImageLicense from './ImageLicense.astro';
import type {Content} from '../server/types';
const {item,marketing=false,quick=false,selected=false,showCategory=false}=Astro.props as {item:Content;marketing?:boolean;quick?:boolean;selected?:boolean;showCategory?:boolean};
---
<article class:list={['art-card',selected&&'selected']} data-content-id={item.id}><ImageLicense item={item} assets={marketing?[item.thumbnail,item.home_color]:[item.thumbnail]}/>
 {marketing?<Compare line={item.thumbnail} color={item.home_color} alt={item.alt}/>:quick?<button class="art-picture select-preview" data-id={item.id} aria-label={`Preview ${item.title}`} aria-pressed={selected}><img src={item.thumbnail} alt={item.alt} width="512" height="512" loading="lazy"/></button>:<a class="art-picture" href={`/coloring/${item.slug}/`}><img src={item.thumbnail} alt={item.alt} width="512" height="512" loading="lazy"/></a>}
 <div class="art-info"><a class="art-title" href={`/coloring/${item.slug}/`}>{item.title}</a>{showCategory&&<p>{item.categoryName}</p>}<div class="card-bottom"><div class="format-links"><a href={item.downloads.pdf} aria-label={`Download ${item.title} PDF`}>♧ PDF</a><a href={item.downloads.webp} aria-label={`Download ${item.title} WEBP`}>♧ WEBP</a></div><div class="card-actions"><a href={`/studio/?page=${item.id}`} aria-label={`Color ${item.title} in Studio`}>🖌</a><a href={item.downloads.pdf} aria-label={`Download ${item.title}`}>♧<span class="download-arrow">↓</span></a></div></div></div>
</article>
