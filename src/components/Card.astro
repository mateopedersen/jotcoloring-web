---
import Compare from './Compare.astro';
import ImageLicense from './ImageLicense.astro';
import Icon from './HomeIcon.astro';
import type {Content} from '../server/types';
const {item,marketing=false,quick=false,selected=false,showCategory=false}=Astro.props as {item:Content;marketing?:boolean;quick?:boolean;selected?:boolean;showCategory?:boolean};
---
<article class:list={['art-card','iv-card',selected&&'selected']} data-content-id={item.id}><ImageLicense item={item} assets={marketing?[item.thumbnail,item.home_color]:[item.thumbnail]}/>
 <div class="iv-card-picture">{marketing?<Compare line={item.thumbnail} color={item.home_color} alt={item.alt}/>:quick?<button class="art-picture select-preview" data-id={item.id} aria-label={`Preview ${item.title}`} aria-pressed={selected}><img src={item.thumbnail} alt={item.alt} width="512" height="512" loading="lazy"/><span class="iv-preview-label"><Icon name="search" size={14}/>Quick preview</span></button>:<a class="art-picture" href={`/coloring/${item.slug}/`}><img src={item.thumbnail} alt={item.alt} width="512" height="512" loading="lazy"/></a>}</div>
 <div class="art-info">{showCategory&&<p class="iv-card-category">{item.categoryName}</p>}<a class="art-title" href={`/coloring/${item.slug}/`}>{item.title}<Icon name="arrow" size={15}/></a><div class="card-bottom"><div class="format-links"><a href={item.downloads.pdf} aria-label={`Download ${item.title} PDF`}><Icon name="file" size={15}/>PDF</a><a href={item.downloads.webp} aria-label={`Download ${item.title} WEBP`}><Icon name="download" size={15}/>WEBP</a></div><a class="iv-card-color" href={`/studio/?page=${item.id}`} aria-label={`Color ${item.title} in Studio`}><Icon name="brush" size={15}/>Color in Studio</a></div></div>
</article>
