---
import GlyphIcon from './GlyphIcon.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ActionIcon from './ActionIcon.astro';
import PhotoFileIcon from './PhotoFileIcon.astro';
import DownloadArt from './DownloadArt.astro';
import {catalogDownload,formatChoice,fileSize,downloadPage,type DownloadItem} from '../downloads/model';
import type {Content} from '../server/types';
import '../downloads/downloads.css';
const {item,format='pdf'}=Astro.props as {item?:Content;format?:string};
const record:DownloadItem|undefined=item?catalogDownload(item):undefined;
const Heading=record?'h1':'h2';
const selected=record?.files.find(f=>f.kind===formatChoice(format))||record?.files[0];
---
<main id="download-main" class="jc-download-screen" data-download-screen hidden={!record} aria-labelledby="jc-download-title" data-preview-ads={import.meta.env.DEV?'true':'false'}>
 <nav class="jc-dl-breadcrumb" aria-label="Download navigation"><a data-dl-back href={record?.publicPage||'/coloring-pages/'}><span aria-hidden="true"><ArrowIcon kind="left" size={18}/></span> Back to browsing</a><span>JotColoring <b aria-hidden="true">/</b> Download</span></nav>
 <section class="jc-dl-card"><header class="jc-dl-heading"><DownloadArt/><div><p>PRINT IT. COLOR IT. MAKE IT YOURS.</p><Heading id="jc-download-title" tabindex="-1">Download your coloring page</Heading><span>Choose a file, then save it to your device.</span></div><a class="jc-dl-close" data-dl-back href={record?.publicPage||'/coloring-pages/'} aria-label="Close download and keep browsing"><GlyphIcon name="close" size={20}/></a></header>
 <div class="jc-dl-grid"><figure class="jc-dl-preview"><div class="jc-dl-paper"><img data-dl-image src={record?.preview} alt={record?.alt||''} width={record?.width||1024} height={record?.height||1536} hidden={!record}/><div class="jc-dl-loading-art" data-dl-loading hidden={!!record}><DownloadArt/><span>Opening your coloring page…</span></div></div><figcaption><span data-dl-preview-label>Uncolored original</span><span data-dl-dimensions>{record?`${record.width.toLocaleString('en-US')} × ${record.height.toLocaleString('en-US')} px`:''}</span></figcaption></figure>
 <div class="jc-dl-copy"><p class="jc-dl-kicker" data-dl-kicker>READY FOR YOUR COLORS</p><h2 data-dl-title>{record?.title||'Preparing your files…'}</h2><p class="jc-dl-description" data-dl-description>{record?.description||'Choose the file you need, then save it to your device.'}</p><p class="jc-dl-choose">Choose your file</p><div class="jc-dl-formats" data-dl-formats role="group" aria-label="Download file format">{record?.files.map(f=><a class="jc-dl-format" href={downloadPage(item!.slug,f.kind)} data-dl-option={f.kind} aria-current={selected?.kind===f.kind?'true':undefined}><ActionIcon name={f.mime==='application/pdf'?'pdf':'webp'} size={40}/><span><strong>{f.label}</strong><small>{fileSize(f.bytes)}</small></span><b aria-hidden="true">✓</b></a>)}</div><div class="jc-dl-selected"><strong data-dl-file-label>{selected?.detail||''}</strong><p data-dl-file-hint>{selected?.kind==='pdf'?'Choose A4 paper in your print settings.':'The actual file is WEBP. Use PDF if you prefer a print document.'}</p></div>
 <a data-dl-final class="jc-dl-save" href={selected?.url||'#'} download={selected?.filename} aria-disabled={!record?'true':undefined}><DownloadArt/><span data-dl-save-label>{selected?`Download ${selected.label}`:'Preparing files…'}</span><GlyphIcon name="download" size={20}/></a><p class="jc-dl-status" data-dl-status role="status" aria-live="polite">{record?'Your original file is ready.':''}</p><button class="jc-dl-retry" data-dl-retry type="button" hidden>Try loading the files again</button>
 <p class="jc-dl-permission" data-dl-permission>Free for personal and non-commercial educational use. <a href="/license/">Artwork license</a></p><details class="jc-dl-details"><summary>File details</summary><dl><div><dt>File name</dt><dd data-dl-filename>{selected?.filename||'—'}</dd></div><div><dt>File type</dt><dd data-dl-mime>{selected?.mime||'—'}</dd></div><div><dt>File size</dt><dd data-dl-size>{fileSize(selected?.bytes)}</dd></div><div><dt>PDF limit</dt><dd>1,000,000 bytes maximum</dd></div></dl></details><div class="jc-dl-extra-links"><a data-dl-studio href={record?.studio||'/studio/'}>Color in Studio <span aria-hidden="true"><ArrowIcon kind="diagonal" size={18}/></span></a><a data-dl-settings hidden>Adjust export settings <span aria-hidden="true"><ArrowIcon kind="diagonal" size={18}/></span></a></div></div></div>
 <footer class="jc-dl-card-footer"><span><GlyphIcon name="check" size={20}/><span data-dl-footer-note>No account needed. Ready when you are.</span></span><a data-dl-back href={record?.publicPage||'/coloring-pages/'}>Keep exploring <span aria-hidden="true"><ArrowIcon kind="right" size={18}/></span></a></footer></section>
 <section class="jc-dl-guide" aria-label="Using your download"><div><ActionIcon name="pdf" size={48}/><span><h2>From file to paper.</h2><p>Open your PDF, match the paper size, and check the print preview before printing.</p><a href="/printing-guide/">Printing guide <ArrowIcon kind="diagonal" size={18}/></a></span></div><div><ActionIcon name="brush" size={48}/><span><h2>A page to make your own.</h2><p>Add your favorite colors on paper, or explore fills, brushes and layers in Studio.</p><a href="/studio/" data-dl-guide-studio>Explore Coloring Studio <ArrowIcon kind="diagonal" size={18}/></a></span></div></section>
 <aside class="jc-dl-ad-space" data-dl-ad-space data-ad-placement="download-page-normal-flow" data-ad-active="false" aria-label="Advertisements" hidden={!record||!import.meta.env.DEV}><span>Advertisements</span><div aria-hidden="true"></div></aside>
 <template data-dl-art-png><PhotoFileIcon format="png" size={40}/></template><template data-dl-art-jpeg><PhotoFileIcon format="jpeg" size={40}/></template><template data-dl-art-svg><PhotoFileIcon format="svg" size={40}/></template><template data-dl-art-docx><PhotoFileIcon format="docx" size={40}/></template><template data-dl-art-pdf><ActionIcon name="pdf" size={40}/></template><template data-dl-art-image><ActionIcon name="webp" size={40}/></template>
 {record&&<script type="application/json" data-dl-seed set:html={JSON.stringify({record,format:selected?.kind}).replace(/</g,'\\u003c')}/>}
</main>
<script>import {mountDownloads} from '../downloads/controller';mountDownloads();</script>
