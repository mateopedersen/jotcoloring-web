---
import ArrowIcon from '../components/ArrowIcon.astro';
import Compare from './Compare.astro';
import ActionIcon from './ActionIcon.astro';
import Icon from './HomeIcon.astro';
const {mode='text',example,ideas=[]}=Astro.props;const photo=mode==='photo';
const styleImages=['/style-simple.svg','/style-cute.svg',example?.home_color||example?.thumbnail];
const presetIdea=photo?'':(Astro.url.searchParams.get('prompt')||'').trim().slice(0,1000);
---
<main id="main" class:list={['creator-main',photo&&'photo-creator']} data-mode={mode}>
{photo&&<section class="photo-heading jc-photo-heading"><div><p class="jc-photo-kicker"><Icon name="photo" size={16}/> PHOTO TO COLORING PAGE</p><h1>Turn your favorite photo into a coloring page.</h1><p>Choose a photo, pick your line style, and create a page to print or color in Studio.</p><div class="jc-photo-steps"><span><b>01</b> Choose a photo</span><span><b>02</b> Create your outlines</span><span><b>03</b> Make it yours</span></div></div><div class="jc-photo-emblem" aria-hidden="true"><Icon name="photo" size={40}/><Icon name="spark" size={25}/></div></section>}
<div class="creator-columns"><section class="creator-form-panel">
{!photo&&<><div class="breadcrumbs"><a href="/create/text/">AI Builder</a><span>/</span>Create</div><h1>Create a page from your imagination.</h1></>}
<nav class="creator-mode-tabs" aria-label="Creation mode"><a class:list={[!photo&&'active']} href="/create/text/">T &nbsp; Text to page</a><a class:list={[photo&&'active']} href="/create/photo/">▧ &nbsp; Photo to page</a></nav>
<form id="creator-form"><input type="hidden" name="mode" value={mode}/>
{photo?<><h2>Original photo</h2><div class="original-photo"><img id="photo-preview" alt="Your selected photo" hidden/><div id="photo-empty"><span class="jc-photo-empty-icon"><Icon name="photo" size={38}/></span><p>A favorite face. A special place.<br/>Start with your photo.</p></div><button type="button" id="replace-photo" class="button" hidden>Replace photo</button></div><label class="photo-drop" id="photo-drop" for="photo-input"><Icon name="photo" size={27}/><div>Choose or drop a photo<small>PNG, JPG or WEBP · up to 2 MB / 2.4 MP</small></div><input class="sr-only" id="photo-input" type="file" accept="image/png,image/jpeg,image/webp"/></label><div class="photo-option"><label for="detail-photo">Detail</label><select name="detail_level" id="detail-photo"><option value="20">Simple</option><option value="50" selected>Balanced</option><option value="90">Detailed</option></select></div><div class="photo-option"><label for="line-photo">Line weight</label><select name="line_weight" id="line-photo"><option value="thin">Thin</option><option value="medium" selected>Medium</option><option value="bold">Bold</option></select></div><label class="simplify"><span>Simplify background</span><input name="simplify_background" type="checkbox" checked/><small>Remove busy details for a cleaner coloring page.</small></label><input type="hidden" name="style" value="detailed"/><input type="hidden" name="page_shape" value="portrait"/></>:<><label class="form-heading" for="prompt">Describe what you want to see</label><textarea name="prompt" id="prompt" rows="3" maxlength="1000" minlength="3" required placeholder="A fox and a rabbit in a woodland garden, surrounded by flowers and leaves.">{presetIdea}</textarea><fieldset class="style-field"><legend>Choose a style</legend><div class="style-choices">{['Simple','Cute','Detailed'].map((label,i)=><label><input type="radio" name="style" value={label.toLowerCase()} checked={i===2}/><span>{example&&<img src={styleImages[i]} alt="" width="140" height="140"/>}<b>{label}</b></span></label>)}</div></fieldset><fieldset><legend>Line weight</legend><div class="segmented">{['Thin','Medium','Bold'].map((label,i)=><label><input type="radio" name="line_weight" value={label.toLowerCase()} checked={i===1}/><span>{label}</span></label>)}</div></fieldset><label class="form-heading" for="detail-level">Detail level</label><input id="detail-level" name="detail_level" type="range" min="0" max="100" value="50"/><div class="range-labels"><span>Simpler</span><output id="detail-output">Balanced</output><span>More detailed</span></div><fieldset><legend>Page shape</legend><div class="segmented page-shapes">{['Portrait','Square','Landscape'].map((label,i)=><label><input type="radio" name="page_shape" value={label.toLowerCase()} checked={i===0}/><span>▯ {label}</span></label>)}</div></fieldset><input type="hidden" name="simplify_background" value="true"/></>}
<button type="submit" class="button primary wide generate-button"><Icon name="spark" size={20}/>{photo?'Create coloring page':'Generate coloring page'} <ArrowIcon kind="right" size={18}/></button><p id="provider-state" class="provider-state" role="status">Checking generation availability…</p><p id="generation-status" role="status" hidden></p><button type="button" id="cancel-job" hidden>Cancel queued generation</button>
</form></section><section class="creator-result"><div class="result-heading"><h2 id="result-title">{example?.title||'Your coloring page'}</h2><div class="result-tabs" role="group" aria-label="Preview mode"><button type="button" data-view="line" aria-pressed="false">Line art</button><button type="button" data-view="color" class="active" aria-pressed="true">Color preview</button></div><span class="preview-possibilities">Preview the possibilities</span></div><p class="example-label" id="example-label">Example illustration — your generated result will appear here.</p><div id="result-image" class="result-image">{example?<Compare line={example.preview} color={example.home_color} alt={example.alt}/>:<div class="empty">Describe your idea to create a coloring page.</div>}</div><div class="result-actions jc-file-actions jc-file-actions--creator"><a id="result-studio" class="button primary" href={example?`/studio/?page=${example.id}`:'/studio/'}><ActionIcon name="brush" size={32}/>Open in Studio <Icon name="arrow" size={16}/></a><a data-file-format="pdf" id="result-pdf" class="button" href={example?.downloads.pdf||'/coloring-pages/'}><ActionIcon name="pdf" size={32}/>{photo?"Download PDF":"PDF"}</a><a data-file-format="webp" id="result-webp" class="button" href={example?.downloads.webp||'/coloring-pages/'}><ActionIcon name="webp" size={32}/>{photo?"Download Image":"Image"}</a></div><p class="download-note">Downloads include the uncolored page.</p>{!photo&&<section class="more-ideas"><div class="section-heading"><h3>More ideas for you</h3><a href="/coloring-pages/">View more ideas <ArrowIcon kind="right" size={18}/></a></div><div class="ideas-grid">{ideas.map((item:any)=><a href={`/coloring/${item.slug}/`}><Compare line={item.thumbnail} color={item.home_color} alt={item.alt} interactive={false}/><span>{item.title}</span></a>)}</div><p>Illustrations from the JotColoring collection.</p></section>}</section></div></main>
<script>import '../ui/creator';</script>
<style>
.creator-main{padding:18px;background:#fafbfc}.creator-columns{display:grid;grid-template-columns:34% minmax(0,1fr);gap:15px}.creator-form-panel,.creator-result{background:#fff;border:1px solid var(--border);border-radius:9px;padding:20px}.creator-form-panel h1{font-size:29px;letter-spacing:-.8px;line-height:1.2;margin-bottom:19px}.creator-mode-tabs{display:flex;border-bottom:1px solid var(--border);margin:5px 0 20px;gap:15px}.creator-mode-tabs a{padding:10px 15px;font-size:16px}.creator-mode-tabs a.active{color:var(--orange-dark);border-bottom:3px solid var(--orange);font-weight:600}.form-heading,legend{font-weight:600;display:block;margin-bottom:9px;font-size:16px}textarea{width:100%;font-size:16px;min-height:100px;padding:13px;line-height:1.55}fieldset{padding:0;margin:18px 0;border:0;min-width:0}.style-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.style-choices input,.segmented input{position:absolute;opacity:0;width:1px;height:1px}.style-choices span{display:block;border:2px solid transparent;border-radius:7px;overflow:hidden;text-align:center}.style-choices img{height:120px;object-fit:cover;width:100%;object-position:center 35%;border:1px solid var(--border);border-radius:5px}.style-choices b{font-weight:500;display:block;margin-top:5px}.style-choices input:checked+span{border-color:var(--orange);color:var(--orange-dark)}.style-choices input:focus-visible+span,.segmented input:focus-visible+span{outline:3px solid var(--orange)}.segmented{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.segmented label span{display:block;text-align:center;border:1px solid #d5dce6;border-radius:6px;padding:9px 5px;cursor:pointer;color:var(--text-ink, #000)}.segmented input:checked+span{color:var(--orange-dark);background:var(--peach);border-color:var(--orange)}.page-shapes{font-size:12px}.creator-form-panel input[type=range]{width:100%;padding:0;height:19px}.range-labels{display:flex;justify-content:space-between;font-size:12px;color:var(--text-ink, #000)}.range-labels output{color:var(--text-ink, #000)}.generate-button{min-height:52px;font-size:15px}.generate-button span{font-size:26px}.provider-state{font-size:12px;color:#8a5a31;margin:10px 0 0}.provider-state.available{color:#3f6b45}.creator-result{padding:14px 19px}.result-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.result-heading h2{font-size:29px;letter-spacing:-.7px}.result-tabs{display:flex;align-items:center;white-space:nowrap}.result-tabs button{padding:10px 14px;border:0;border-radius:0;font-size:14px;color:var(--text-ink, #000)}.result-tabs .active{border-bottom:2px solid var(--orange);color:var(--orange-dark)}.preview-possibilities{font-size:12px;color:var(--text-ink, #000)}.example-label{font-size:11px;color:var(--text-ink, #000);margin:4px 0 8px}.result-image{max-width:610px;margin:0 auto;background:white;box-shadow:0 3px 9px #0001;border-radius:8px;border:1px solid var(--border);padding:6px;overflow:hidden}.result-image :global(.compare){aspect-ratio:1.05;max-height:550px}.result-image :global(.compare img){object-position:center 40%}.result-image :global(.generated-result img){object-fit:contain;object-position:center}.result-image.line-only :global(.color),.result-image.line-only :global(.compare-divider),.result-image.line-only :global(input){display:none}.result-actions{display:flex;justify-content:center;gap:14px;margin:12px 0 0}.result-actions .primary{min-width:240px}.result-actions>.button{min-width:110px}.creator-result>.download-note{text-align:center;font-size:11px;margin-bottom:12px}.more-ideas{border-top:1px solid var(--border);padding-top:13px}.ideas-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.ideas-grid a{border:1px solid var(--border);padding:3px;border-radius:5px}.ideas-grid .compare{aspect-ratio:1.8}.ideas-grid span{font-size:12px;display:block;text-align:center}.more-ideas>p{font-size:10px;color:var(--text-ink, #000);margin-top:5px}.photo-heading{position:relative;padding:0 12px 14px}.photo-heading h1{font-size:45px}.photo-heading>p{font-size:23px;color:var(--text-ink, #000);margin:2px 0 0}.camera-decor{position:absolute;right:30px;top:0;font-size:60px}.photo-creator{background:#fff;padding:20px 26px}.photo-creator .creator-columns{grid-template-columns:33% minmax(0,1fr)}.photo-creator .creator-form-panel{padding:12px}.photo-creator .creator-mode-tabs{margin:0 0 14px;gap:0}.photo-creator .creator-mode-tabs a{font-size:14px;flex:1;padding:8px 4px;text-align:center}.photo-creator .creator-mode-tabs a.active{border:1px solid #ffc19e;background:var(--peach);border-radius:6px}.original-photo{position:relative;border-radius:7px;border:1px solid var(--border);margin:10px 0;overflow:hidden;aspect-ratio:1.13;background:#fffbf5}.original-photo img{width:100%;height:100%;object-fit:contain}.original-photo button{position:absolute;right:9px;top:9px;background:#fff;padding:7px 10px;font-size:12px}#photo-empty{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:var(--text-ink, #000);text-align:center;font-size:14px}#photo-empty>span{font-size:55px}.photo-drop{display:flex;gap:14px;align-items:center;justify-content:center;border:1px dashed #abb4c4;padding:14px 5px;border-radius:6px;cursor:pointer}.photo-drop:focus-within{outline:3px solid var(--orange)}.photo-drop>span{font-size:32px;color:var(--text-ink, #000)}.photo-drop small{display:block;font-size:10px;color:var(--text-ink, #000)}.photo-option{display:flex;align-items:center;justify-content:space-between;margin:14px 0}.photo-option select{width:58%;padding:6px 10px}.simplify{display:flex;align-items:center;gap:10px;margin:15px 0 24px;font-size:13px}.simplify input{width:27px;height:27px;flex:none}.simplify small{color:var(--text-ink, #000);font-size:11px;max-width:170px}.photo-creator .result-image{max-width:none}.photo-creator .result-image :global(.compare){aspect-ratio:1.45;max-height:none}.photo-creator .result-heading h2{font-size:25px}.photo-creator .preview-possibilities{display:none}.photo-creator .result-actions .primary{flex:1}.photo-creator .result-actions>.button{min-width:0;flex:1;padding:12px}.photo-creator .creator-result{padding:12px}.photo-creator .result-image{box-shadow:none;padding:0}.photo-creator .result-actions{gap:10px}
@media(max-width:1100px){.creator-columns{grid-template-columns:36% minmax(0,1fr)}.result-heading{flex-wrap:wrap}.preview-possibilities{display:none}.creator-form-panel{padding:14px}.creator-form-panel h1{font-size:25px}.style-choices{gap:7px}.style-choices img{height:100px}.result-actions{gap:7px}.result-actions .primary{min-width:0}.result-actions>.button{min-width:70px;font-size:12px;padding:12px}.photo-heading h1{font-size:35px}.photo-heading>p{font-size:19px}.camera-decor{display:none}.photo-creator .result-actions .button{font-size:11px}.photo-creator .creator-columns{grid-template-columns:36% minmax(0,1fr)}}
@media(max-width:700px){.creator-main,.photo-creator{padding:8px 12px 20px}.creator-columns,.photo-creator .creator-columns{display:flex;flex-direction:column;gap:14px}.creator-form-panel,.creator-result{padding:14px}.creator-form-panel h1{font-size:28px}.creator-mode-tabs{margin-bottom:15px}.creator-mode-tabs a{font-size:14px;padding:9px 12px}.style-choices img{height:110px}.style-choices b{font-size:13px}.segmented{gap:7px}.result-heading h2{font-size:23px}.result-tabs button{font-size:12px;padding:8px}.result-image :global(.compare){max-height:480px}.result-actions{gap:7px}.result-actions>.button{min-width:60px;padding:10px;font-size:12px}.result-actions .primary{flex:1}.photo-heading{padding:0 0 10px}.photo-heading h1{font-size:29px;letter-spacing:-.8px}.photo-heading p{font-size:16px}.photo-creator .result-image :global(.compare){aspect-ratio:1}.ideas-grid{gap:8px}.ideas-grid span{font-size:10px}.creator-result .section-heading a{font-size:10px}}
</style>
