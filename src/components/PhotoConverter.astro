---
import NavPhotoIcon from './NavPhotoIcon.astro';
import PhotoConversionArt from './PhotoConversionArt.astro';
import PhotoFileIcon from './PhotoFileIcon.astro';
import ActionIcon from './ActionIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
import {PHOTO_FORMATS} from '../photo/files';
import '../photo/photo.css';
const previous=Astro.url.searchParams.get('job');
---
<main id="main" class="jc-photo-converter" data-photo-converter>
 <header class="jc-photo-hero"><div><p class="jc-photo-eyebrow"><NavPhotoIcon size={37}/> PHOTO TO COLORING PAGE</p><h1>Your photo.<br/><span>Your very own coloring page.</span></h1><p>Keep the people, places and little details that make it yours. Create clean outlines directly from your photo, then print, download or color online.</p><div class="jc-photo-promises"><span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6Z" fill="#d9e7cb" stroke="#789567"/><path d="m8 12 3 3 5-6" stroke="#638653" stroke-width="1.8" stroke-linecap="round"/></svg>Private on your device</span><span>Same scene & proportions</span><span>No AI credits needed</span></div></div><div class="jc-photo-hero-art"><PhotoConversionArt size={300}/><span>FROM A MOMENT<br/><b>TO A LITTLE MASTERPIECE</b></span></div></header>
 {previous&&/^[a-f0-9-]{36}$/.test(previous)&&<p class="jc-photo-previous">Looking for your earlier AI result? <a href={`/create/text/?job=${previous}`}>Open that saved result <ArrowIcon size={16}/></a></p>}
 <div class="jc-photo-workspace"><section class="jc-photo-settings" aria-labelledby="photo-upload-title"><div class="jc-photo-section-title"><span>01</span><div><p>MAKE IT PERSONAL</p><h2 id="photo-upload-title">Start with your photo.</h2></div></div>
 <form id="photo-converter-form"><label class="jc-photo-upload" data-photo-drop><input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" id="photo-converter-input" aria-label="Choose a photo to convert"/><div data-photo-empty><NavPhotoIcon size={75}/><strong>Drop a photo here</strong><span>or choose one from your device</span><small>JPG, PNG or WEBP · up to 20 MB / 32 MP</small></div><img data-photo-source alt="Your selected original photo" hidden/><span class="jc-photo-replace" data-photo-replace hidden><NavPhotoIcon size={23}/> Choose another photo</span></label><p class="jc-photo-source-info" data-photo-source-info>Nothing is uploaded. Your photo stays in this tab.</p>
 <div class="jc-photo-control-heading"><h3>Find your favorite outlines.</h3><p>Keep more details or give the lines a little breathing room.</p></div><div class="jc-photo-presets" role="group" aria-label="Outline presets"><button type="button" data-photo-preset="clean" aria-pressed="false">Clean & simple</button><button type="button" data-photo-preset="balanced" aria-pressed="true">Balanced</button><button type="button" data-photo-preset="detailed" aria-pressed="false">Fine details</button></div>
 <label class="jc-photo-range-label" for="photo-detail">Detail <output id="photo-detail-value">55</output></label><input id="photo-detail" type="range" min="0" max="100" value="55"/><div class="jc-photo-range-ends"><span>Fewer small lines</span><span>More photo detail</span></div>
 <label class="jc-photo-range-label" for="photo-smoothing">Smooth fine texture <output id="photo-smoothing-value">65</output></label><input id="photo-smoothing" type="range" min="0" max="100" value="65"/><div class="jc-photo-range-ends"><span>Keep texture</span><span>Cleaner surfaces</span></div>
 <fieldset class="jc-photo-weight"><legend>Line weight</legend><div>{['fine','medium','bold'].map((weight,i)=><label><input type="radio" name="photo-weight" value={weight} checked={i===1}/><span><svg viewBox="0 0 35 16" width="35" height="16" fill="none" aria-hidden="true"><path d="M3 12C11-7 22 23 32 4" stroke="currentColor" stroke-width={i+1.2} stroke-linecap="round"/></svg>{weight==='fine'?'Fine':weight==='medium'?'Medium':'Bold'}</span></label>)}</div></fieldset>
 <label class="jc-photo-gap"><input id="photo-close-gaps" type="checkbox" checked/><span><strong>Connect tiny breaks</strong><small>Connect short breaks supported by the original image.</small></span></label>
 <details class="jc-photo-engine"><summary>Processor options</summary><label for="photo-engine">Outline method</label><select id="photo-engine"><option value="smart">Smart contours · recommended</option><option value="direct">Direct trace · lightweight</option></select><p>Smart contours recognizes visible boundaries at two scales. The processor downloads once; your photo stays on your device. Direct trace is available for older browsers.</p></details>
 <button class="jc-photo-primary" type="submit" data-photo-convert disabled><NavPhotoIcon size={31}/><span>Create my coloring page</span><ArrowIcon size={20}/></button><div class="jc-photo-minor-actions"><button type="button" data-photo-cancel hidden>Stop processing</button><button type="button" data-photo-reset>Start fresh</button></div><p class="jc-photo-status" data-photo-status role="status" aria-live="polite">Choose a photo to get started.</p></form></section>
 <section class="jc-photo-output" aria-labelledby="photo-output-title"><div class="jc-photo-section-title"><span>02</span><div><p>THE SAME MOMENT, IN OUTLINES</p><h2 id="photo-output-title">Ready for your colors.</h2></div><span class="jc-photo-ready" data-photo-ready hidden>Outlines ready</span></div>
 <div class="jc-photo-preview-tabs" role="group" aria-label="Photo preview mode"><button type="button" data-photo-view="line" aria-pressed="true" disabled>Coloring page</button><button type="button" data-photo-view="compare" aria-pressed="false" disabled>Compare original</button><button type="button" data-photo-view="original" aria-pressed="false" disabled>Original photo</button></div>
 <div class="jc-photo-result-frame" data-photo-frame data-view="line"><div class="jc-photo-result-empty" data-photo-result-empty><PhotoConversionArt size={285}/><h3>A moment worth coloring.</h3><p>Your converted photo will appear here.<br/>Every contour comes from the image you choose.</p></div><canvas data-photo-canvas role="img" aria-label="Black-and-white contours traced from your photo" hidden></canvas><img data-photo-comparison-source alt="The original photo for comparison" hidden/><div class="jc-photo-compare-divider" data-photo-divider hidden aria-hidden="true"><span><ArrowIcon kind="left" size={14}/><ArrowIcon size={14}/></span></div><input type="range" min="0" max="100" value="50" data-photo-comparison aria-label="Compare original photo with coloring outlines" hidden/></div><div class="jc-photo-result-caption"><span data-photo-dimensions>Your photo’s proportions are preserved.</span><span data-photo-method>Traced on your device</span></div>
 <p class="jc-photo-region-note" data-photo-regions role="status"></p>
 <div class="jc-photo-fidelity-note"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8V4h4m6 0h4v4M5 16v4h4m6 0h4v-4" stroke="#a7784f" stroke-width="1.8" stroke-linecap="round"/><path d="m8 12 3 3 5-6" stroke="#a7784f" stroke-width="1.8" stroke-linecap="round"/></svg><p><strong>Your scene stays yours.</strong> Smart contours follows the original image without generating new people or objects. Use Compare original to check every detail. Sharp, well-lit photos work best; blur and hidden detail cannot be recovered.</p></div>
 <section class="jc-photo-export" aria-labelledby="photo-export-title"><div class="jc-photo-export-heading"><div><p>03 · PRINT. SAVE. MAKE IT YOURS.</p><h2 id="photo-export-title">A file for every way you create.</h2></div><PhotoFileIcon format="svg" size={59}/></div><fieldset data-photo-formats disabled><legend class="sr-only">Choose a download format</legend><div class="jc-photo-formats">{PHOTO_FORMATS.map((f,i)=><label><input type="radio" name="photo-format" value={f.id} checked={i===0}/><span><PhotoFileIcon format={f.id} size={48}/><span><strong>{f.label}</strong><small>{f.hint}</small></span><b aria-hidden="true">✓</b></span></label>)}</div></fieldset><div class="jc-photo-export-actions"><button type="button" class="jc-photo-primary" data-photo-download disabled><PhotoFileIcon format="pdf" size={32}/><span data-photo-download-label>Download PDF</span><ArrowIcon size={20}/></button><button type="button" class="jc-photo-studio" data-photo-studio disabled><ActionIcon name="brush" size={32}/><span>Color in Studio</span><ArrowIcon kind="diagonal" size={18}/></button></div><p class="jc-photo-file-note">PDFs stay under 1 MB. SVG uses vector outline paths; Word contains the coloring image in a DOCX document. A small JotColoring credit is added below the drawing.</p><p data-photo-export-status role="status" aria-live="polite"></p></section>
 </section></div>
 <section class="jc-photo-tips"><div><NavPhotoIcon size={48}/><h2>A few little tips.<br/><span>A clearer coloring page.</span></h2></div><article><span>01</span><h3>Let the light in.</h3><p>Choose a sharp photo with a clear subject. Strong shadows and soft focus can hide the contours you want to keep.</p></article><article><span>02</span><h3>Make the details work for you.</h3><p>Use Clean & simple for textured scenes. Increase Detail to bring out lighter lines, and compare against your original.</p></article><article><span>03</span><h3>Keep a copy you can use.</h3><p>Choose PDF for printing, Image for a smaller file, or PNG for lossless pixels. Use SVG in vector apps and Word in documents.</p></article></section>
</main>
<script>import {mountPhotoConverter} from '../photo/controller';mountPhotoConverter();</script>
