---
import {ROOT_CATEGORIES,childCategories,categoryById,categoryPath,COLORING_TAXONOMY} from '../taxonomy/catalog';
import {hasIllustration} from '../icons/registry';
import CategoryIcon from './CategoryIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
interface Props {counts:{id:string;count:number}[];parent?:string}
const {counts,parent}=Astro.props;
const totals=new Map(counts.map(c=>[c.id,c.count]));
const topics=parent?childCategories(parent):ROOT_CATEGORIES;
const groups=topics.map(c=>({...c,count:totals.get(c.id)||0,children:childCategories(c.id)}));
---
{groups.length>0&&<section class="taxonomy-directory" aria-labelledby="topic-directory-title">
<div class="taxonomy-heading"><div><p class="hv-kicker">EXPLORE BY SUBJECT</p><h2 id="topic-directory-title">{parent?`${categoryById(parent)?.name} themes`:'Find your next coloring theme'}</h2><p>{parent?'Choose a closer look at your favorite subject.':`${ROOT_CATEGORIES.length} collections, with ${COLORING_TAXONOMY.length-ROOT_CATEGORIES.length} more specific themes to explore.`}</p></div><a href="/coloring-by-age/">Browse by age <ArrowIcon size={18}/></a></div>
<div class="taxonomy-grid">{groups.map(c=><details class="taxonomy-group"><summary><CategoryIcon name={c.id} size={48}/><span><strong>{c.name}</strong><small>{c.count?`${c.count} ${c.count===1?'page':'pages'}`:'New pages coming'}</small></span><span class="taxonomy-expand" aria-hidden="true"><ArrowIcon size={18}/></span></summary><div class="taxonomy-links"><a href={categoryPath(c.id)}>Explore {c.name.toLowerCase()} <ArrowIcon size={15}/></a>{c.children.map(child=><a href={categoryPath(child.id)}><span class="taxonomy-topic-name">{hasIllustration(child.id)&&<CategoryIcon name={child.id} size={30}/>}<span>{child.name}</span></span><span class="taxonomy-topic-count">{totals.get(child.id)||0}</span></a>)}</div></details>)}</div>
</section>}
<style>
.taxonomy-directory{margin:32px auto;padding:clamp(18px,3vw,32px);max-width:1440px;border:1px solid #ecdacc;border-radius:26px;background:linear-gradient(120deg,#fffaf4,#fff);container:topics / inline-size}.taxonomy-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}.taxonomy-heading h2{font-size:clamp(24px,3vw,34px);line-height:1.16;margin:8px 0}.taxonomy-heading p{margin:0;color:var(--text-ink, #000)}.taxonomy-heading>a{display:flex;align-items:center;gap:8px;flex-shrink:0;font-weight:800;color:#af4216}.taxonomy-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;align-items:start}.taxonomy-group{border:1px solid #efd9c9;border-radius:16px;background:#fff;overflow:hidden;min-width:0}.taxonomy-group summary{list-style:none;display:flex;gap:12px;align-items:center;padding:16px;cursor:pointer;height:100px;min-height:100px}.taxonomy-group summary::-webkit-details-marker{display:none}.taxonomy-group summary>span:not(.taxonomy-expand){flex:1;min-width:0}.taxonomy-group strong{display:block;font-size:16px;line-height:1.3}.taxonomy-group small{display:block;margin-top:4px;font-size:12px;color:var(--text-ink, #000)}.taxonomy-group summary:focus-visible{outline:3px solid #ce4f19;outline-offset:-4px}.taxonomy-group[open]{border-color:#da8e5a;grid-column:1/-1}.taxonomy-group[open] summary{background:#fff7ed}.taxonomy-expand{flex:0 0 20px;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;transform:rotate(90deg)}.taxonomy-group[open] .taxonomy-expand{flex:0 0 20px;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;transform:rotate(-90deg)}.taxonomy-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:16px;border-top:1px solid #f1e1d7;padding:6px 12px 12px}.taxonomy-links>a:first-child{grid-column:1/-1;color:#a93d14}.taxonomy-links a{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;padding:8px 4px;font-size:14px;font-weight:700;color:var(--text-ink, #000);border-bottom:1px solid #f7eee7}.taxonomy-links a:hover{color:#b64016}.taxonomy-links a>.taxonomy-topic-count{font-size:12px;color:var(--text-ink, #000)}.taxonomy-topic-name{display:flex;align-items:center;gap:9px;min-width:0;flex:1;font-size:14px}.taxonomy-topic-name>span{min-width:0;overflow-wrap:anywhere}.taxonomy-links a:has(.taxonomy-topic-name){min-height:52px}.taxonomy-group summary>svg{flex-shrink:0}@container topics (max-width:960px){.taxonomy-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@container topics (max-width:700px){.taxonomy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.taxonomy-links{grid-template-columns:repeat(2,minmax(0,1fr))}.taxonomy-heading{align-items:start;flex-direction:column}}@container topics (max-width:400px){.taxonomy-grid,.taxonomy-links{grid-template-columns:1fr}}
</style>
