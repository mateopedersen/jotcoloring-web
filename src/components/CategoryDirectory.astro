---
import {COLORING_TAXONOMY,categoryPath} from '../taxonomy/catalog';
import {NAVIGATION_COLLECTIONS,collectionPath} from '../taxonomy/navigation';
import {navigationLabel} from '../ui/navigation-label';
import CategoryIcon from './CategoryIcon.astro';
import '../styles/category-directory.css';
import ArrowIcon from './ArrowIcon.astro';
interface Props {counts:{id:string;count:number}[];parent?:string;collectionId?:string}
const {counts,collectionId}=Astro.props;
const totals=new Map(counts.map(c=>[c.id,c.count]));
const groups=NAVIGATION_COLLECTIONS.filter(c=>!collectionId||c.id===collectionId).map(c=>({...c,children:COLORING_TAXONOMY.filter(t=>c.roots.includes(t.parent||t.id)&&categoryPath(t.id)!==collectionPath(c.id)&&(totals.get(t.id)||0)>0)})).filter(c=>c.roots.some(id=>(totals.get(id)||0)>0));
---
{groups.length>0&&<section class="taxonomy-directory" aria-labelledby="topic-directory-title"><div class="taxonomy-heading"><div><p class="hv-kicker">EXPLORE BY SUBJECT</p><h2 id="topic-directory-title">{collectionId?'Explore the topics':'Find your next coloring theme'}</h2><p>Choose a collection, then a subject you would like to color.</p></div><a href="/coloring-by-age/">Browse By Age <ArrowIcon size={18}/></a></div><div class="taxonomy-grid">{groups.map(c=><details class="taxonomy-group" open={!!collectionId}><summary><CategoryIcon name={c.icon} size={48}/><span class="taxonomy-title-copy"><strong>{navigationLabel(c.name)}</strong><small>{c.children.length?`${c.children.length} topics`:'Browse the collection'}</small></span><span class="taxonomy-expand" aria-hidden="true"><ArrowIcon size={18}/></span></summary><div class="taxonomy-links"><a href={collectionPath(c.id)}>Explore {c.name} <ArrowIcon size={15}/></a>{c.children.map(child=><a href={categoryPath(child.id)}><span>{navigationLabel(child.name)}</span><span class="taxonomy-topic-count">{totals.get(child.id)||0}</span></a>)}</div></details>)}</div></section>}
