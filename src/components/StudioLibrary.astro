---
import VectorIcon from './VectorIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
import GlyphIcon from './GlyphIcon.astro';
import '../studio/library/design.css';
const quickCollections=[['Animals','Animals','animals'],['Flowers & plants','Flowers','flowers'],['Ocean Life','Ocean','ocean'],['Fantasy','Fantasy','fantasy'],['Vehicles','Vehicles','vehicles'],['Dinosaurs','Dinosaurs','dinosaurs']];
const levelHints=['Big, open spaces','A few extra details','Smaller coloring areas','Intricate patterns'];
---
<dialog class="studio-modal studio-library" data-starter-dialog aria-labelledby="library-title">
 <div class="library-header"><span class="library-header-art" aria-hidden="true"><VectorIcon name="all" size={76}/></span><div><span class="studio-kicker">YOUR STUDIO PAGE LIBRARY</span><h2 id="library-title">Choose a Page. Make It Yours.</h2><p>Browse 10,000 ready-to-color pages, from easy outlines to intricate patterns.</p><div class="library-header-stats"><span><VectorIcon name="boards" size={22}/>125 subjects</span><span><VectorIcon name="layers" size={22}/>4 detail levels</span><span><VectorIcon name="brush" size={22}/>Ready to color</span></div></div><button class="studio-button library-close" type="button" data-starter-close aria-label="Close coloring library"><GlyphIcon name="close" size={22}/></button></div>
 <div data-library-browse>
  <div class="library-controls-panel"><div class="library-search-row"><label class="library-search"><VectorIcon name="search" size={32}/><input type="search" data-library-query placeholder="What would you like to color?" aria-label="Search Studio pages"/></label><button class="studio-button" type="button" data-library-surprise><VectorIcon name="ai" size={28}/>Surprise Me</button><button class="studio-button" type="button" data-library-daily><VectorIcon name="clock" size={28}/>Today's Pick</button></div>
  <div class="library-scopes" role="group" aria-label="Your coloring shelf"><button type="button" data-library-scope="all" aria-pressed="true"><VectorIcon name="all" size={26}/>All Pages</button><button type="button" data-library-scope="favorites" aria-pressed="false"><VectorIcon name="heart" size={26}/>Saved Pages <span data-library-saved-count>0</span></button><button type="button" data-library-scope="recent" aria-pressed="false"><VectorIcon name="clock" size={26}/>Recently Opened</button></div>
  <nav class="library-quick-collections" aria-label="Quick Studio collections">{quickCollections.map(([category,label,icon])=><button type="button" data-library-quick-category={category} aria-pressed="false"><VectorIcon name={icon} size={34}/><span>{label}</span></button>)}</nav>
  <div class="library-filters"><label><span><VectorIcon name="folder" size={23}/>Collection</span><select data-library-category><option value="">All collections</option></select></label><label><span><VectorIcon name="search" size={23}/>Subject</span><select data-library-subject><option value="">All subjects</option></select></label><label><span><VectorIcon name="image" size={23}/>Page Layout</span><select data-library-layout><option value="">All compositions</option></select></label><label><span><VectorIcon name="list" size={23}/>Sort By</span><select data-library-sort><option value="recommended">Best matches</option><option value="az">Title A–Z</option><option value="detail">Simple to detailed</option></select></label></div>
  <div class="library-detail-row"><fieldset><legend>How much detail do you want?</legend>{['Easy','Medium','Hard','Very Hard'].map((level,i)=><label class="library-level"><input type="checkbox" data-library-level value={level}/><span><VectorIcon name={['fill','brush','layers','mandalas'][i]} size={34}/><span><strong>{level}</strong><small>{levelHints[i]}</small></span></span></label>)}</fieldset><label class="check-row"><input type="checkbox" data-library-hide-finished/> Hide finished pages</label></div></div>
  <div class="library-meta-row"><p data-library-status role="status" aria-live="polite"></p><button class="studio-button" type="button" data-library-reset><VectorIcon name="refresh" size={23}/>Clear Filters</button><button class="studio-button" type="button" data-library-density aria-pressed="false" aria-label="Use compact cards"><VectorIcon name="grid" size={23}/><span>Compact View</span></button></div>
  <div class="library-chips" data-library-chips></div><div class="library-grid" data-library-grid></div>
  <nav class="library-pagination" aria-label="Coloring shelf pages"><button type="button" class="studio-button" data-library-prev><ArrowIcon kind="left" size={18}/>Previous</button><label>Page <input type="number" min="1" value="1" data-library-page aria-label="Result page"/> <span data-library-page-total></span></label><button type="button" class="studio-button" data-library-next>Next<ArrowIcon kind="right" size={18}/></button></nav>
  <details class="library-portable"><summary><VectorIcon name="backup" size={31}/>Save or Restore Your Library<GlyphIcon name="down" size={19}/></summary><p>Your saved pages and completion marks stay in this browser. Export a backup to move them to another device.</p><button type="button" class="studio-button" data-library-export><VectorIcon name="download" size={25}/>Export Library</button><label class="studio-file"><VectorIcon name="upload" size={25}/>Import Library<input type="file" accept="application/json,.json" data-library-import/></label></details>
 </div>
 <section class="library-preview" data-library-preview hidden aria-labelledby="library-preview-title">
  <button type="button" class="studio-button" data-library-back><ArrowIcon kind="left" size={18}/>Back to results</button>
  <div class="library-preview-grid"><div class="library-preview-paper" data-library-paper><img data-library-preview-image alt="" width="512" height="704"/><button class="studio-button" data-library-zoom type="button" aria-pressed="false">A closer look</button></div><div class="library-preview-info"><span class="studio-kicker" data-library-preview-category></span><h3 id="library-preview-title"></h3><p data-library-description></p><fieldset class="library-preview-levels"><legend>Same subject. Your pace.</legend>{['Easy','Medium','Hard','Very Hard'].map((level,i)=><button type="button" data-library-preview-level={i} aria-pressed="false">{level}</button>)}</fieldset><p class="library-level-help" data-library-level-help></p><div class="library-preview-actions"><button type="button" class="studio-button primary" data-library-start><VectorIcon name="brush" size={27}/>Color this page</button><button type="button" class="studio-button" data-library-save>Save to my shelf</button><button type="button" class="studio-button" data-library-finished>Mark as finished</button></div><h4>A palette to try</h4><div class="library-color-story" data-library-colors></div><label class="check-row"><input type="checkbox" data-library-use-palette checked/> Start with these colors</label><details><summary>Download the uncolored page</summary><div class="library-downloads">{['svg','png','pdf'].map(format=><button type="button" class="studio-button" data-library-download={format}><VectorIcon name={format==='svg'?'file-svg':format==='png'?'file-png':'pdf'} size={26}/>{format.toUpperCase()}</button>)}</div><p>Original line art. PDF is kept below 1 MB.</p></details><p data-library-preview-status role="status" aria-live="polite"></p></div></div>
  <h4>Try another composition</h4><div class="library-related" data-library-related></div>
 </section>
</dialog>
