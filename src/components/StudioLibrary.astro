---
import VectorIcon from './VectorIcon.astro';
import ArrowIcon from './ArrowIcon.astro';
---
<dialog class="studio-modal studio-library" data-starter-dialog aria-labelledby="library-title">
 <div class="library-header"><div><span class="studio-kicker">THE COLORING SHELF</span><h2 id="library-title">Find your next little adventure.</h2><p>10,000 compositions. 125 subjects. Four levels of detail.</p></div><button class="studio-button library-close" type="button" data-starter-close aria-label="Close coloring library">×</button></div>
 <div data-library-browse>
  <div class="library-search-row"><label class="library-search"><VectorIcon name="search" size={25}/><input type="search" data-library-query placeholder="Search whales, castles, music, mandalas…" aria-label="Search Studio pages"/></label><button class="studio-button" type="button" data-library-surprise><VectorIcon name="magic" size={24}/>Surprise me</button><button class="studio-button" type="button" data-library-daily>Today's pick</button></div>
  <div class="library-scopes" role="group" aria-label="Your coloring shelf"><button type="button" data-library-scope="all" aria-pressed="true">All pages</button><button type="button" data-library-scope="favorites" aria-pressed="false">Saved pages <span data-library-saved-count>0</span></button><button type="button" data-library-scope="recent" aria-pressed="false">Recently opened</button></div>
  <div class="library-filters"><label>Collection<select data-library-category><option value="">All collections</option></select></label><label>Subject<select data-library-subject><option value="">All subjects</option></select></label><label>Composition<select data-library-layout><option value="">All compositions</option></select></label><label>Order<select data-library-sort><option value="recommended">Best matches</option><option value="az">Title A–Z</option><option value="detail">Simple to detailed</option></select></label></div>
  <div class="library-detail-row"><fieldset><legend>Choose your detail</legend>{['Easy','Medium','Hard','Very Hard'].map((level,i)=><label class="library-level"><input type="checkbox" data-library-level value={level}/><span><i style={`--level:${i+1}`} aria-hidden="true"></i>{level}</span></label>)}</fieldset><label class="check-row"><input type="checkbox" data-library-hide-finished/> Hide finished pages</label></div>
  <div class="library-meta-row"><p data-library-status role="status" aria-live="polite"></p><button class="studio-button" type="button" data-library-reset>Clear filters</button><button class="studio-button" type="button" data-library-density aria-pressed="false" aria-label="Use compact cards"><VectorIcon name="grid" size={23}/></button></div>
  <div class="library-chips" data-library-chips></div><div class="library-grid" data-library-grid></div>
  <nav class="library-pagination" aria-label="Coloring shelf pages"><button type="button" class="studio-button" data-library-prev><ArrowIcon kind="left" size={18}/>Previous</button><label>Page <input type="number" min="1" value="1" data-library-page aria-label="Result page"/> <span data-library-page-total></span></label><button type="button" class="studio-button" data-library-next>Next<ArrowIcon kind="right" size={18}/></button></nav>
  <details class="library-portable"><summary>Keep a copy of your shelf</summary><p>Saved pages and completion marks stay in this browser. Export them to use on another device.</p><button type="button" class="studio-button" data-library-export>Export shelf</button><label class="studio-file">Import shelf<input type="file" accept="application/json,.json" data-library-import/></label></details>
 </div>
 <section class="library-preview" data-library-preview hidden aria-labelledby="library-preview-title">
  <button type="button" class="studio-button" data-library-back><ArrowIcon kind="left" size={18}/>Back to results</button>
  <div class="library-preview-grid"><div class="library-preview-paper" data-library-paper><img data-library-preview-image alt="" width="512" height="704"/><button class="studio-button" data-library-zoom type="button" aria-pressed="false">A closer look</button></div><div class="library-preview-info"><span class="studio-kicker" data-library-preview-category></span><h3 id="library-preview-title"></h3><p data-library-description></p><fieldset class="library-preview-levels"><legend>Same subject. Your pace.</legend>{['Easy','Medium','Hard','Very Hard'].map((level,i)=><button type="button" data-library-preview-level={i} aria-pressed="false">{level}</button>)}</fieldset><p class="library-level-help" data-library-level-help></p><div class="library-preview-actions"><button type="button" class="studio-button primary" data-library-start><VectorIcon name="brush" size={27}/>Color this page</button><button type="button" class="studio-button" data-library-save>Save to my shelf</button><button type="button" class="studio-button" data-library-finished>Mark as finished</button></div><h4>A palette to try</h4><div class="library-color-story" data-library-colors></div><label class="check-row"><input type="checkbox" data-library-use-palette checked/> Start with these colors</label><details><summary>Download the uncolored page</summary><div class="library-downloads">{['svg','png','pdf'].map(format=><button type="button" class="studio-button" data-library-download={format}>{format.toUpperCase()}</button>)}</div><p>Original line art. PDF is kept below 1 MB.</p></details><p data-library-preview-status role="status" aria-live="polite"></p></div></div>
  <h4>Try another composition</h4><div class="library-related" data-library-related></div>
 </section>
</dialog>
