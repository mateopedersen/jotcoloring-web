---
import SupportShell from './SupportShell.astro';
import type {Policy} from '../content/policies';
const {policy}=Astro.props as {policy:Policy};
---
<SupportShell title={policy.title} description={policy.description} kind="privacy" eyebrow="YOUR SPACE. CLEAR CHOICES.">
 <div slot="hero" class="support-hero-meta"><span>Plain-language information</span><span>Updated October 29, 2026</span></div>
 <div class="support-prose-layout"><aside class="support-toc"><h2>ON THIS PAGE</h2><nav aria-label="On this page">{policy.sections.map(section=><a href={`#${section.id}`}>{section.title.replace(/^\d+\. /,'')}</a>)}</nav></aside><article class="support-prose">{policy.sections.map(section=><section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map(p=><p>{p}</p>)}{section.bullets&&<ul>{section.bullets.map(p=><li>{p}</li>)}</ul>}</section>)}<div class="support-mini-links"><a href="/privacy/">Privacy</a><a href="/terms/">Terms of use</a><a href="/cookies/">Cookies & storage</a><a href="/accessibility/">Accessibility</a><a href="mailto:jotcoloring@gmail.com">jotcoloring@gmail.com</a></div></article></div>
</SupportShell>
