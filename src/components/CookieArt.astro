---
const id=`privacy-art-${crypto.randomUUID().replaceAll('-','')}`;
---
<svg class="jc-cookie-art" viewBox="0 0 148 132" fill="none" aria-hidden="true" focusable="false">
 <defs>
  <linearGradient id={`${id}-paper`} x1="24" y1="10" x2="92" y2="110" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".65" stop-color="#fffdf5"/><stop offset="1" stop-color="#e6cdb1"/></linearGradient>
  <linearGradient id={`${id}-edge`} x1="16" y1="15" x2="98" y2="112" gradientUnits="userSpaceOnUse"><stop stop-color="#ffe6ba"/><stop offset="1" stop-color="#dca76e"/></linearGradient>
  <linearGradient id={`${id}-petal`} x1="39" y1="33" x2="79" y2="79" gradientUnits="userSpaceOnUse"><stop stop-color="#ffdf9e"/><stop offset=".5" stop-color="#ffa35e"/><stop offset="1" stop-color="#d77539"/></linearGradient>
  <linearGradient id={`${id}-pencil`} x1="0" y1="0" x2="1" y2="0"><stop stop-color="#be5228"/><stop offset=".27" stop-color="#f58d3d"/><stop offset=".5" stop-color="#ffbd70"/><stop offset=".73" stop-color="#f68e3e"/><stop offset="1" stop-color="#b84c24"/></linearGradient>
  <linearGradient id={`${id}-green`} x1="0" y1="0" x2="1" y2="0"><stop stop-color="#568b6d"/><stop offset=".45" stop-color="#b8d799"/><stop offset=".68" stop-color="#9dc68b"/><stop offset="1" stop-color="#4e8268"/></linearGradient>
  <linearGradient id={`${id}-shield`} x1="86" y1="79" x2="129" y2="121" gradientUnits="userSpaceOnUse"><stop stop-color="#e6f0c9"/><stop offset=".44" stop-color="#b7d49b"/><stop offset="1" stop-color="#61957a"/></linearGradient>
  <filter id={`${id}-shadow`} x="-40%" y="-35%" width="190%" height="195%"><feDropShadow dx="0" dy="5" stdDeviation="3.5" flood-color="#94623d" flood-opacity=".2"/></filter>
 </defs>
 <ellipse cx="74" cy="119" rx="57" ry="7" fill="#9c6c43" opacity=".13"/><circle cx="71" cy="63" r="51" fill="#ffe8c5" opacity=".55"/>
 <g filter={`url(#${id}-shadow)`}>
  <rect x="18" y="16" width="77" height="97" rx="10" transform="rotate(-9 18 16)" fill={`url(#${id}-edge)`} stroke="#d8ad82" stroke-width="1.2"/>
  <path d="M30 9h47l17 17v76q0 8-8 8H30q-8 0-8-8V17q0-8 8-8Z" fill={`url(#${id}-paper)`} stroke="#d4b798" stroke-width="1.35"/>
  <path d="M77 9v11q0 6 6 6h11" fill="#f5e1c7" stroke="#d4b798" stroke-width="1.35"/><path d="M80 13v7q0 3 3 3h7" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
  <path d="M32 22h31m-31 5h22" stroke="#e1c7ab" stroke-width="2" stroke-linecap="round"/>
  <g stroke="#846448" stroke-width="1.1" stroke-linejoin="round"><path d="M58 91V66" stroke="#6f9d76" stroke-width="2"/><path d="M57 84c-15 0-19-13-19-13 14-1 20 8 20 8" fill="#aed096" stroke="#769e70"/><path d="M59 90c13-1 19-12 19-12-11-3-19 7-19 7" fill="#fffdf7"/>
   <ellipse cx="58" cy="47" rx="7.2" ry="15" fill={`url(#${id}-petal)`}/><ellipse cx="58" cy="47" rx="7.2" ry="15" transform="rotate(-60 58 58)" fill={`url(#${id}-petal)`}/><ellipse cx="58" cy="47" rx="7.2" ry="15" transform="rotate(-120 58 58)" fill={`url(#${id}-petal)`}/><ellipse cx="58" cy="47" rx="7.2" ry="15" transform="rotate(180 58 58)" fill="#fffdf7"/><ellipse cx="58" cy="47" rx="7.2" ry="15" transform="rotate(120 58 58)" fill="#fffdf7"/><ellipse cx="58" cy="47" rx="7.2" ry="15" transform="rotate(60 58 58)" fill="#fffdf7"/><circle cx="58" cy="58" r="8.5" fill="#ffd37f" stroke="#c28d42"/><path d="m54 55 3-2" stroke="#fff5cc" stroke-width="2" stroke-linecap="round"/>
  </g>
  <g transform="rotate(24 110 61)"><path d="M104 14q0-4 4-4h5q4 0 4 4v77l-6.5 16-6.5-16Z" fill={`url(#${id}-green)`} stroke="#649275" stroke-width=".9"/><path d="M104 90h13l-6.5 17Z" fill="#efd2a4"/><path d="m108 100 2.5 7 2.5-7" fill="#426c55"/><path d="M108 20v65" stroke="#d8e9b9" stroke-width="1.5" opacity=".8"/></g>
  <g transform="rotate(33 103 66)"><path d="M96 16q0-4 4-4h5q4 0 4 4v79l-6.5 17L96 95Z" fill={`url(#${id}-pencil)`} stroke="#bb642f" stroke-width="1"/><path d="M96 94h13l-6.5 18Z" fill="#f2d5ae"/><path d="m100 105 2.5 7 2.5-7" fill="#bc602d"/><path d="M100 24v65" stroke="#ffe3a8" stroke-width="1.7" opacity=".9"/><path d="M96 21h13" stroke="#b85c2d" stroke-width="1.2"/></g>
  <path d="m112 79 22 7v17c0 14-22 24-22 24s-22-10-22-24V86Z" fill="#4d8267"/><path d="m110 75 22 7v17c0 14-22 24-22 24s-22-10-22-24V82Z" fill={`url(#${id}-shield)`} stroke="#7fa77e" stroke-width="1.3"/><path d="m95 86 15-5 15 5" stroke="#f8fbe6" stroke-width="1.7" stroke-linecap="round"/><path d="m99 97 8 8 14-16" stroke="#598c68" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="m99 95 8 8 14-16" stroke="#fffef1" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
 </g>
 <g fill="#eaa566"><path d="m123 22 2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/><circle cx="12" cy="58" r="2.2"/><circle cx="134" cy="55" r="2"/></g><g fill="#b7cba0"><circle cx="27" cy="118" r="2.3"/><circle cx="16" cy="37" r="1.7"/></g>
</svg>
