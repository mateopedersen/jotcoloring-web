---
import {artworkText,artworkSummary} from '../ui/artwork-text';
import Compare from './Compare.astro';
import ImageLicense from './ImageLicense.astro';
import Icon from './HomeIcon.astro';
import FileActions from './FileActions.astro';
import DifficultyBadge from './DifficultyBadge.astro';
import AgeBadge from './AgeBadge.astro';
import ShareButton from './ShareButton.astro';
import CategoryLabel from './CategoryLabel.astro';
import type {Content} from '../server/types';
const {item}=Astro.props as {item:Content};
const text=artworkText(item);
---
<article class="hc-card" data-content-id={item.id}>
 <ImageLicense item={item} assets={[item.thumbnail,item.home_color]}/>
 <div class="hc-picture" data-image-title={text.title} data-image-description={text.description}><div class="jc-artwork-tools"><DifficultyBadge item={item}/><ShareButton item={item}/></div><Compare line={item.thumbnail} color={item.home_color} lineSrcset={item.thumbnailSrcset} colorSrcset={item.homeColorSrcset} alt={text.alt}/></div>
 <div class="hc-info"><CategoryLabel category={item.category} label={item.categoryName}/><AgeBadge item={item}/><p class="hc-card-meta hc-card-summary">{artworkSummary(item)}</p><a class="hc-title" href={`/coloring/${item.slug}/`}><span>{item.title}</span><span class="hc-title-arrow" aria-hidden="true"><Icon name="arrow" size={20}/></span></a>
 <FileActions item={item} variant="home"/></div>
</article>
