---
import Compare from './Compare.astro';
import ImageLicense from './ImageLicense.astro';
import Icon from './HomeIcon.astro';
import type {Content} from '../server/types';
const {item}=Astro.props as {item:Content};
---
<article class="hc-card" data-content-id={item.id}>
 <ImageLicense item={item} assets={[item.thumbnail,item.home_color]}/>
 <div class="hc-picture"><Compare line={item.thumbnail} color={item.home_color} alt={item.alt}/><span class="hc-category">{item.categoryName}</span></div>
 <div class="hc-info"><div class="hc-card-meta"><span>{item.difficulty==='easy'?'Easy & relaxing':item.difficulty==='detailed'?'Beautifully detailed':'Ready to color'}</span><span class="hc-dot" aria-hidden="true"></span><span>Printable</span></div><a class="hc-title" href={`/coloring/${item.slug}/`}>{item.title}<Icon name="arrow" size={16}/></a>
 <div class="hc-downloads"><a href={item.downloads.pdf} aria-label={`Download ${item.title} PDF`}><Icon name="file" size={16}/>PDF</a><a href={item.downloads.webp} aria-label={`Download ${item.title} WEBP`}><Icon name="download" size={16}/>WEBP</a><a class="hc-color" href={`/studio/?page=${item.id}`} aria-label={`Color ${item.title} in Studio`}><Icon name="brush" size={17}/>Color</a></div></div>
</article>
