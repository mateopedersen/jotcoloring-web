---
const {line,color,alt='',interactive=true}=Astro.props;
---
<div class:list={['compare',{'static-compare':!interactive}]} style="--split:50%"><img class="line" src={line} alt={alt} loading="lazy" width="1024" height="1536"/>{color&&<><img class="color" src={color} alt="" loading="lazy" width="1024" height="1536" aria-hidden="true"/><span class="compare-divider" aria-hidden="true">{interactive&&<b><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4M12 6v12"/></svg></b>}</span>{interactive&&<input aria-label="Compare line art and color preview" type="range" min="0" max="100" value="50"/>}</>}</div>
