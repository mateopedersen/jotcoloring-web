---
import GlyphIcon from './GlyphIcon.astro';
import ArtworkImage from './ArtworkImage.astro';
const {line,color,lineSrcset=undefined,colorSrcset=undefined,sizes='auto, (max-width:600px) 90vw, (max-width:1000px) 40vw, 240px',alt='',interactive=true,eager=false,priority=false}=Astro.props;
---
<div class:list={['compare','jc-artwork-compare',{'static-compare':!interactive}]} style="--split:50%"><ArtworkImage class="line" src={line} srcset={lineSrcset} sizes={lineSrcset?sizes:undefined} alt={alt} eager={eager} priority={priority} width="1024" height="1536"/>{color&&<><ArtworkImage class="color" src={color} srcset={colorSrcset} sizes={colorSrcset?sizes:undefined} alt="" eager={eager} width="1024" height="1536" aria-hidden="true"/><span class="compare-divider" aria-hidden="true">{interactive&&<b><GlyphIcon name="compare" size={22}/></b>}</span>{interactive&&<input aria-label="Compare line art and color preview" type="range" min="0" max="100" value="50"/>}</>}</div>
