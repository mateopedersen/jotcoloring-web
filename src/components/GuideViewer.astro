---
import ArrowIcon from './ArrowIcon.astro';
import Icon from './HomeIcon.astro';
import '../styles/walkthrough.css';
---
<dialog id="walkthrough-viewer" class="walk-viewer" aria-labelledby="walk-viewer-title"><header><div><span>THE REAL JOTCOLORING TOOLS</span><h2 id="walk-viewer-title"></h2></div><button type="button" data-screen-close aria-label="Close screenshot"><Icon name="close" size={21}/></button></header><div class="walk-viewer-image"><img data-screen-image alt=""/></div><footer><button type="button" data-screen-prev aria-label="Previous screenshot"><ArrowIcon kind="left" size={18}/></button><p data-screen-caption></p><button type="button" data-screen-next aria-label="Next screenshot"><ArrowIcon kind="right" size={18}/></button><button type="button" data-screen-size aria-pressed="false">Actual size</button><span data-screen-counter role="status" aria-live="polite"></span></footer></dialog>
<script>import {mountScreenshotViewer} from '../ui/screenshot-viewer';mountScreenshotViewer();</script>
