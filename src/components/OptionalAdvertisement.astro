---
import {permitsAdvertising} from '../advertising/model';
import '../advertising/advertising.css';
const enabled=permitsAdvertising(Astro.url.pathname,Astro.url.search);
---
{enabled&&<aside class="jc-advertising ad-placement" data-advertising-slot data-advertising-mode="display-banner" aria-label="Advertisement"><span class="jc-advertising-label ad-placement-label">Advertisement</span><div class="jc-advertising-stage" data-advertising-stage></div></aside>}
<script>
import {mountDisplayBanner} from '../advertising/display-runtime.mjs';
import {type BannerUnit,ADVERTISING_UNIT,ADVERTISING_DESKTOP_UNIT} from '../advertising/units';
const unit=(u:BannerUnit)=>({key:u.key,src:u.scriptURL,width:u.width,height:u.height,format:u.format,container:u.container});
mountDisplayBanner({enabled:true,mode:'display-banner',hosts:['jotcoloring.com'],scriptHosts:['bellnewyork.org'],storageKey:'jotcoloring:optional-advertising',desktop:unit(ADVERTISING_DESKTOP_UNIT),mobile:unit(ADVERTISING_UNIT),displayLabels:{on:'Advertising is enabled. Changes fully apply on your next page load.',off:'Advertising is disabled. Save unfinished work and reload to stop previously loaded advertising code.'}});
</script>
