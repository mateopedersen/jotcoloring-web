---
import {permitsAdvertising} from '../advertising/model';
import {ADVERTISING_UNIT} from '../advertising/units';
import '../advertising/advertising.css';
const enabled=permitsAdvertising(Astro.url.pathname,Astro.url.search)&&!!ADVERTISING_UNIT;
---
{enabled&&<aside class="jc-advertising" data-advertising-slot aria-label="Advertisement">
 <span class="jc-advertising-label">Advertisement</span>
 <div class="jc-advertising-stage" data-advertising-stage hidden></div>
 <p class="jc-advertising-status" data-advertising-status role="status" aria-live="polite"></p>
 <div class="jc-advertising-pending" data-advertising-pending hidden><p>Ads have been turned off and the banner removed. Previously loaded advertising code may continue until this page reloads. Save your work, then reload to finish stopping it.</p><button type="button" data-advertising-reload>Reload after saving your work</button></div>
 <dialog class="jc-advertising-confirm" data-advertising-confirm aria-labelledby="jc-advertising-confirm-title"><h2 id="jc-advertising-confirm-title">Turn off cookies and reload?</h2><p>This page has changes that may not have been saved. Reloading stops the loaded advertising code. Stay on this page to save your work first, or continue with the reload.</p><div class="jc-advertising-actions"><button type="button" data-advertising-cancel-reload>Stay on this page</button><button type="button" data-advertising-confirm-reload>Turn off and reload</button></div></dialog>
</aside>}
<script>import {mountOptionalAdvertisement} from '../advertising/controller';if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mountOptionalAdvertisement,{once:true});else mountOptionalAdvertisement();</script>
