---
import {permitsAdvertising} from '../advertising/model';
import {ADVERTISING_UNIT} from '../advertising/units';
import '../advertising/advertising.css';
const enabled=permitsAdvertising(Astro.url.pathname,Astro.url.search)&&!!ADVERTISING_UNIT;
---
{enabled&&<aside class="jc-advertising" data-advertising-slot aria-label="Optional advertisement">
 <div class="jc-advertising-head"><span class="jc-advertising-label">Advertisement</span><button type="button" data-advertising-settings disabled aria-expanded="false" aria-controls="jc-advertising-options">Advertising options</button></div>
 <div class="jc-advertising-gate" id="jc-advertising-options" data-advertising-gate hidden>
  <div data-advertising-age-step><h2>Optional advertising</h2><p>Ads are optional in this adult-oriented section. You can browse and use the site with them off. Before any advertising service loads, please choose your age range. Your answer stays on this page and is not saved or sent.</p><div class="jc-advertising-actions"><button type="button" data-advertising-age="under18">Under 18</button><button type="button" data-advertising-age="adult">18 or older</button><button type="button" data-advertising-age="private">Prefer not to say</button></div></div>
  <div data-advertising-consent-step hidden><h2>Your advertising choice</h2><p>Allow Adsterra to load an advertisement in this section? It receives connection information such as your IP address, browser details and this page address, and may use cookies or similar identifiers for advertising and measurement. This choice is separate from essential storage and does not enable audience analytics.</p><p><a href="/privacy/#advertising">Read our advertising privacy details</a> or <a href="https://adsterra.com/privacy-policy-managed/" rel="external noopener noreferrer" target="_blank">Adsterra’s privacy policy</a>.</p><div class="jc-advertising-actions"><button type="button" data-advertising-deny>Keep optional ads off</button><button type="button" data-advertising-allow>Allow optional ads</button></div><p>Only this advertising choice is remembered for up to 180 days. Your age range is not remembered. You can turn ads off at any time.</p></div>
 </div>
 <div class="jc-advertising-stage" data-advertising-stage hidden></div><p class="jc-advertising-status" data-advertising-status role="status" aria-live="polite">Optional ads are off. Your coloring pages and tools are available without them.</p>
 <div data-advertising-controls hidden><button type="button" data-advertising-revoke>Turn off optional ads and reload</button></div>
</aside>}
<script>import {mountOptionalAdvertisement} from '../advertising/controller';if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mountOptionalAdvertisement,{once:true});else mountOptionalAdvertisement();</script>
