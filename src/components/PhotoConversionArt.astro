<svg width={size} height={size*.74} viewBox="0 0 300 222" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id={`${id}-paper`} x1="150" y1="26" x2="266" y2="194" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset="1" stop-color="#f2e5d1"/></linearGradient><linearGradient id={`${id}-photo`} x1="26" y1="39" x2="135" y2="179" gradientUnits="userSpaceOnUse"><stop stop-color="#b4e4d9"/><stop offset="1" stop-color="#87b7ba"/></linearGradient><linearGradient id={`${id}-pencil`} x1="234" y1="138" x2="272" y2="156" gradientUnits="userSpaceOnUse"><stop stop-color="#ffe0a4"/><stop offset=".4" stop-color="#f6a05a"/><stop offset="1" stop-color="#b05832"/></linearGradient></defs>
 <ellipse cx="149" cy="199" rx="123" ry="12" fill="#ad7651" opacity=".11"/><circle cx="148" cy="103" r="89" fill="#f9e2c4" opacity=".4"/><g transform="rotate(-9 86 113)"><rect x="25" y="42" width="119" height="145" rx="11" fill="#b18563" opacity=".19"/><rect x="20" y="35" width="119" height="145" rx="11" fill="#fffdfa" stroke="#d7b393" stroke-width="1.8"/><rect x="28" y="44" width="103" height="113" rx="6" fill={`url(#${id}-photo)`}/><path d="m28 128 29-44 22 28 17-19 35 41v23H28Z" fill="#81a475"/><path d="m57 84 10 13-11-3-8 4Z" fill="#fff3df"/><path d="m29 145 29-23 27 22 15-13 31 18v8H29Z" fill="#e6ac68"/><circle cx="107" cy="65" r="12" fill="#ffe4a4"/><path d="M36 168h47" stroke="#decbba" stroke-width="3" stroke-linecap="round"/></g>
