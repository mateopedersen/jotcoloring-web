---
import CookieArt from './CookieArt.astro';
import Icon from './HomeIcon.astro';
---
<dialog class="jc-storage-dialog" data-storage-dialog aria-labelledby="jc-storage-title"><div class="jc-storage-dialog-top"><CookieArt/><button type="button" data-storage-close aria-label="Close storage information"><Icon name="close" size={20}/></button></div><p class="support-kicker">YOUR CREATIVE SPACE</p><h2 id="jc-storage-title">Cookies &amp; storage</h2><p>JotColoring saves your artwork when you choose and does not add audience analytics.</p><p>Export your artwork before clearing browser storage.</p><button type="button" class="support-button secondary" data-storage-close>Close</button></dialog>
<script>import {mountStorageNotice} from '../privacy/controller';mountStorageNotice();</script>
