---
const {size=42}=Astro.props;
const id=`jcsearch${crypto.randomUUID().replaceAll('-','')}`;
---
<svg class="jc-search-icon" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
 <defs><linearGradient id={`${id}-rim`} x1="10" y1="7" x2="67" y2="69" gradientUnits="userSpaceOnUse"><stop stop-color="#fff9ed"/><stop offset=".32" stop-color="#b9a28b"/><stop offset=".55" stop-color="#fff9ec"/><stop offset="1" stop-color="#896d56"/></linearGradient><linearGradient id={`${id}-glass`} x1="18" y1="12" x2="63" y2="64" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".5" stop-color="#e4f4f0"/><stop offset="1" stop-color="#9ccac5"/></linearGradient><linearGradient id={`${id}-handle`} x1="52" y1="54" x2="85" y2="87" gradientUnits="userSpaceOnUse"><stop stop-color="#ffbf7a"/><stop offset=".45" stop-color="#f17b36"/><stop offset="1" stop-color="#a64222"/></linearGradient></defs>
 <ellipse cx="52" cy="84" rx="32" ry="4" fill="#86553a" opacity=".13"/><path d="m57 61 8-8 22 22q4 4 0 8l-1 1q-4 4-8 0L56 62Z" fill={`url(#${id}-handle)`} stroke="#a85a34" stroke-width="2"/><path d="m64 61 17 17" stroke="#ffd6a2" stroke-width="3" stroke-linecap="round" opacity=".8"/><path d="m57 53 8 8-5 5-8-8" fill={`url(#${id}-rim)`} stroke="#a58369" stroke-width="1.5"/><circle cx="38" cy="38" r="30" fill={`url(#${id}-rim)`} stroke="#987d68" stroke-width="2"/><circle cx="38" cy="38" r="23" fill={`url(#${id}-glass)`} stroke="#baa895" stroke-width="1.5"/><path d="M23 34c2-8 8-13 16-14" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" opacity=".9"/><path d="M26 43c4 10 12 13 21 10" fill="none" stroke="#fff" stroke-width="2" opacity=".6" stroke-linecap="round"/><circle cx="51" cy="27" r="3" fill="#fff" opacity=".8"/>
</svg>
