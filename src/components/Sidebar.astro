---
import {DIFFICULTY_LEVELS} from '../age/difficulty';
import {categories,animalCategories} from '../ui/categories';
import CategoryIcon from './CategoryIcon.astro';
import Icon from './HomeIcon.astro';
const {animal=false,active='',category='',age=[],difficulty=[]}=Astro.props;
---
<aside class="sidebar iv-sidebar"><p class="hv-kicker">FIND YOUR INSPIRATION</p><h2>{animal?'Animal adventures':'Explore the collection'}</h2>
<nav aria-label={animal?'Animal themes':'Coloring categories'}>{animal?<><a class:list={['sidebar-item',!active&&'selected']} href="/coloring-pages/animals/"><CategoryIcon name="animals" size={24}/><span>All animals</span></a>{animalCategories.map(c=><a class:list={['sidebar-item',active===c.id&&'selected']} href={`/coloring-pages/animals/${c.id}/`}><CategoryIcon name={c.id} size={23}/><span>{c.name}</span></a>)}<a class="iv-back-categories" href="/coloring-pages/"><Icon name="arrow" size={16}/>All coloring pages</a></>:<><a class:list={['sidebar-item',!category&&'selected']} href="/coloring-pages/"><CategoryIcon name="all" size={23}/><span>All coloring pages</span></a>{categories.map(c=><a class:list={['sidebar-item',category===c.id&&'selected']} href={`/coloring-pages/${c.id}/`}><CategoryIcon name={c.id} size={24}/><span>{c.name}</span></a>)}</>}</nav>
<div class="iv-sidebar-filters"><h3>Who’s coloring?</h3>{['Kids','Teens','Adults'].map(label=><label class="sidebar-check"><input data-filter="age" type="checkbox" value={label.toLowerCase()} checked={age.includes(label.toLowerCase())}/>{label}</label>)}<h3>Detail level</h3>{DIFFICULTY_LEVELS.map(({id,label})=><label class="sidebar-check"><input data-filter="difficulty" type="checkbox" value={id} checked={difficulty.includes(id)}/>{label}</label>)}</div>
<a class="hv-sidebar-note" href="/create/text/"><Icon name="spark" size={23}/><strong>Something in mind?</strong><span>Make a page from your own idea.</span><b>Try AI Builder <Icon name="arrow" size={15}/></b></a></aside>
