---
import {categories,animalCategories} from '../ui/categories';
const {animal=false,home=false,active='',age=[],difficulty=[]}=Astro.props;
---
<aside class="sidebar"><h2>{animal?'Animals':'Browse pages'}</h2>
{animal?<nav><a class:list={['sidebar-item',!active&&'selected']} href="/coloring-pages/animals/"><span>🦊</span>All animals</a>{animalCategories.map(c=><a class:list={['sidebar-item',active===c.id&&'selected']} href={`/coloring-pages/animals/${c.id}/`}><span>{c.icon}</span>{c.name}</a>)}</nav>:<><nav><a class="sidebar-item selected" href="/coloring-pages/">All coloring pages</a><a class="sidebar-item" href="/coloring-pages/?sort=trending">Popular this week</a><a class="sidebar-item" href="/coloring-pages/?sort=newest">New pages</a></nav><h3>Categories</h3><nav>{categories.slice(0,8).map(c=><a class="sidebar-item" href={`/coloring-pages/${c.id}/`}><span>{c.icon}</span>{c.id==='flowers'&&home?'Flowers & nature':c.name}</a>)}</nav><h3>{home?'By age':'Age'}</h3>{['Kids','Teens','Adults'].map((label,i)=>home?<a class="sidebar-item" href={`/coloring-pages/?age=${label.toLowerCase()}`}><span>{['🧸','🎓','🌿'][i]}</span>{label}</a>:<label class="sidebar-check"><input data-filter="age" type="checkbox" value={label.toLowerCase()} checked={age.includes(label.toLowerCase())}/>{label}</label>)}{!home&&<><h3>Difficulty</h3>{['Easy','Detailed'].map(label=><label class="sidebar-check"><input data-filter="difficulty" type="checkbox" value={label.toLowerCase()} checked={difficulty.includes(label.toLowerCase())}/>{label}</label>)}</>}</>}
</aside>
