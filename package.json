{
  "name": "jotcoloring-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "node scripts/ops/deploy.mjs",
    "db:local": "wrangler d1 migrations apply CATALOG_DB --local",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "deploy:staging": "pnpm build:staging && node scripts/ops/deploy.mjs staging --apply",
    "deploy:production": "pnpm build:production && node scripts/ops/deploy.mjs production --apply"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@cf-wasm/photon": "0.4.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "astro": "7.4.2",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261027.1",
    "@electric-sql/pglite": "0.5.12",
    "@napi-rs/canvas": "1.0.13",
    "@types/node": "26.6.5",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  },
  "packageManager": "pnpm@11.25.0"
}
