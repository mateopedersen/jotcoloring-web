import fs from 'node:fs/promises';import sharp from 'sharp';import path from 'node:path';import{createHash}from'node:crypto';
const source='tests/fixtures/category-vision',dir='outputs/category-audit/new-subjects',jobs=[];await fs.mkdir(dir,{recursive:true});for(const name of await fs.readdir(source)){if(!name.endsWith('.svg'))continue;const b=await sharp(path.join(source,name)).png().toBuffer(),file=path.resolve(dir,name.replace('.svg','.png'));await fs.writeFile(file,b);jobs.push({id:'qa-'+name.replace('.svg',''),file,sha256:createHash('sha256').update(b).digest('hex'),branded:false});}await fs.writeFile(path.join(dir,'jobs.jsonl'),jobs.map(j=>JSON.stringify(j)).join('\n')+'\n');
